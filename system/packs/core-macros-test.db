{"_id": "Resist_Critical", "name": "Resist Critical", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/skull.svg", "scope": "global", "command": "(async () => {\n  const ctx = args?.ctx ?? {};\n  let actor = ctx.actor ?? args?.actor ?? null;\n  if (!actor) {\n    const selectedToken = canvas?.tokens?.controlled?.[0] ?? null;\n    actor = selectedToken?.actor ?? game.user?.character ?? null;\n  }\n\n  let targetActor = args?.target ?? ctx.target ?? null;\n  let targetToken = ctx.targetToken ?? ctx.target?.token ?? null;\n  if (!targetToken) {\n    const primaryTarget = Array.from(game.user?.targets ?? [])[0];\n    if (primaryTarget?.document) {\n      targetToken = primaryTarget.document;\n    } else if (primaryTarget) {\n      targetToken = primaryTarget;\n    }\n  }\n  if (!targetActor) {\n    targetActor = targetToken?.actor ?? null;\n  }\n\n  const rawSeverity = Number(args?.severity ?? ctx?.severity ?? ctx?.deadliness ?? 1);\n  const severity = Number.isFinite(rawSeverity) ? Math.max(rawSeverity, 0) : 1;\n  const isRazor = Boolean(args?.isRazor ?? ctx?.isRazor ?? false);\n  const tnCandidate = Number(args?.tn ?? args?.difficulty ?? ctx?.tn ?? ctx?.difficulty);\n  const difficulty = Number.isFinite(tnCandidate) ? Math.max(tnCandidate, 1) : Math.max(severity + (isRazor ? 1 : 0), 1);\n\n  const tnMapSource = args?.tnMap ?? args?.baseTNModifiers ?? ctx?.tnMap ?? ctx?.baseTNModifiers;\n  const baseTNModifiers = game?.l5r5e?.DicePickerDialog?.normalizeBaseTNModifiers?.(tnMapSource) ?? {\n    fire: 0,\n    air: 0,\n    water: 0,\n    earth: 0,\n    void: 0,\n  };\n\n  const contextData = {\n    actorUuid: actor?.uuid ?? ctx?.actorUuid ?? null,\n    targetActorUuid: targetActor?.uuid ?? ctx?.targetActorUuid ?? null,\n    targetTokenUuid: targetToken?.uuid ?? ctx?.targetTokenUuid ?? null,\n    itemUuid: ctx?.item?.uuid ?? args?.itemUuid ?? null,\n    sceneUuid: targetToken?.parent?.uuid ?? ctx?.sceneUuid ?? canvas?.scene?.uuid ?? null,\n    defense: ctx?.defense ?? null,\n  };\n\n  const rollEffects = [\n    {\n      macro: \"Compendium.l5r5e.core-macros-test-in.Resist_Critical_in\",\n      params: {\n        severity,\n        isRazor,\n        actorUuid: contextData.actorUuid,\n        targetUuid: contextData.targetActorUuid,\n        targetTokenUuid: contextData.targetTokenUuid,\n        itemUuid: contextData.itemUuid,\n        ctx: contextData,\n      },\n      order: 0,\n    },\n  ];\n\n  const options = {\n    actor,\n    target: targetToken ?? null,\n    skillId: \"fitness\",\n    difficulty,\n    baseTNModifiers,\n    rollEffects,\n  };\n\n  const DialogClass = game?.l5r5e?.DicePickerDialog ?? null;\n  if (!DialogClass) {\n    ui.notifications?.error?.(\"Unable to locate DicePickerDialog for Resist Critical test.\");\n    return;\n  }\n\n  const dialog = new DialogClass(options);\n  dialog.render(true);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical", "uuid": "Compendium.l5r5e.core-macros-test.Resist_Critical"}}}
{"_id": "Example_Test", "name": "Example Test (Resist Critical)", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "(() => {\n  const actor = canvas?.tokens?.controlled?.[0]?.actor ?? game.user?.character ?? null;\n  new game.l5r5e.DicePickerDialog({\n    actor,\n    skillId: \"fitness\",\n    difficulty: 2,\n    rollEffects: [\n      {\n        macro: \"Compendium.l5r5e.core-macros-test-in.Example_Test_In\",\n        params: { note: \"demo\" },\n        order: 0,\n      },\n    ],\n  }).render(true);\n})();", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test", "uuid": "Compendium.l5r5e.core-macros-test.Example_Test"}}}
