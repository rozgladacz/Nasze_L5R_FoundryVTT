{"_id": "Resist_Critical", "name": "Resist Critical", "type": "script", "img": "icons/svg/skull.svg", "scope": "global", "command": "(async () => {\n  const {\n    actor = null,\n    severity,\n    isRazor = false,\n    tn = [1, 1, 1, 1, 1],\n    macro_in = [],\n  } = args ?? {};\n\n  const numericSeverity = Math.max(0, Number(severity ?? 0));\n  const razor = Boolean(isRazor);\n  const baseTNModifiers =\n    game?.l5r5e?.DicePickerDialog?.normalizeBaseTNModifiers?.(tn) ?? {\n      fire: 0,\n      air: 0,\n      water: 0,\n      earth: 0,\n      void: 0,\n    };\n\n  const rollEffects = [\n    {\n      macro: \"Compendium.l5r5e.core-macros-test-in.Resist_Critical_in\",\n      params: {\n        actor,\n        actorUuid: actor?.uuid ?? null,\n        severity: numericSeverity,\n        isRazor: razor,\n      },\n      order: 0,\n    },\n    ...(Array.isArray(macro_in) ? macro_in : []),\n  ].map((entry, index) => ({\n    ...entry,\n    order: entry?.order ?? index,\n  }));\n\n  const options = {\n    actor,\n    skillId: \"fitness\",\n    difficulty: Math.max(numericSeverity + (razor ? 1 : 0), 1),\n    baseTNModifiers,\n    rollEffects,\n  };\n\n  const DialogClass = game?.l5r5e?.DicePickerDialog ?? null;\n  if (!DialogClass) {\n    ui.notifications?.error?.(\"Unable to locate DicePickerDialog for Resist Critical test.\");\n    return;\n  }\n\n  new DialogClass(options).render(true);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical", "uuid": "Compendium.l5r5e.core-macros-test.Resist_Critical"}}}
{"_id": "Example_Test", "name": "Example Test (Resist Critical)", "type": "script", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "(async () => {\n  const actor = game.user?.character ?? null;\n  const pack = game.packs?.get(\"l5r5e.core-macros-test\") ?? null;\n  const macro = (await pack?.getDocument?.(\"Resist_Critical\")) ?? null;\n  if (!macro) {\n    ui.notifications?.warn?.(\"Example Test | Unable to load Resist Critical macro.\");\n    return;\n  }\n\n  await macro.execute({\n    actor,\n    severity: 3,\n    isRazor: true,\n    tn: [1, 1, 1, 1, 1],\n    macro_in: [],\n  });\n})();", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test", "uuid": "Compendium.l5r5e.core-macros-test.Example_Test"}}}
