{"_id": "Damage_an_item", "name": "Damage an Item", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/bomb.svg", "scope": "global", "command": "(async () => {\n  const ensureObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : null);\n  const argArray = Array.isArray(args) ? args : [args];\n  const objectArgs = argArray.filter((entry) => ensureObject(entry));\n  const primaryArg =\n    objectArgs.find((entry) => entry?.ctx || entry?.target || entry?.actor || entry?.item || entry?.value !== undefined) ??\n    objectArgs[0] ??\n    {};\n  const ctx = ensureObject(primaryArg?.ctx) ?? objectArgs.map((entry) => ensureObject(entry?.ctx)).find(Boolean) ?? {};\n  const unwrapActor = (value) => {\n    if (!value) return null;\n    if (value.actor) return value.actor;\n    if (value.document?.actor) return value.document.actor;\n    if (value.token?.actor) return value.token.actor;\n    if (value.parent?.actor) return value.parent.actor;\n    return value;\n  };\n  const targetActor =\n    unwrapActor(primaryArg?.target) ??\n    unwrapActor(ctx?.target) ??\n    unwrapActor(primaryArg?.actor) ??\n    unwrapActor(ctx?.actor);\n  if (!targetActor?.items) {\n    console.warn(\"Damage_an_item | Missing target actor context.\");\n    return;\n  }\n\n  const candidateRefs = [];\n  [primaryArg?.item, primaryArg?.value, ctx?.item].forEach((ref) => {\n    if (ref !== undefined && ref !== null) candidateRefs.push(ref);\n  });\n\n  const resolveItem = async (ref) => {\n    if (!ref) return null;\n    if (ref.actor && ref.actor.id === targetActor.id) return ref;\n    if (ref.parent && ref.parent.id === targetActor.id) return ref;\n    if (typeof ref === \"string\") {\n      const byId = targetActor.items?.get?.(ref);\n      if (byId) return byId;\n      if (ref.includes?.(\".\")) {\n        try {\n          const fromUuidItem = await fromUuid(ref);\n          if (fromUuidItem?.actor?.id === targetActor.id || fromUuidItem?.parent?.id === targetActor.id) {\n            return fromUuidItem;\n          }\n        } catch (error) {\n          console.warn(\"Damage_an_item | Unable to resolve uuid reference\", ref, error);\n        }\n      }\n      const byName = targetActor.items?.find?.((i) => i.name === ref);\n      if (byName) return byName;\n    }\n\n    const refId = ref._id ?? ref.id ?? null;\n    if (refId) {\n      const byId = targetActor.items?.get?.(refId);\n      if (byId) return byId;\n    }\n    if (ref.name) {\n      return targetActor.items?.find?.((i) => i.name === ref.name) ?? null;\n    }\n    return null;\n  };\n\n  let item = null;\n  for (const ref of candidateRefs) {\n    item = await resolveItem(ref);\n    if (item) break;\n  }\n\n  if (!item) {\n    console.warn(\"Damage_an_item | Unable to resolve item from arguments.\");\n    return;\n  }\n\n  const updateData = {};\n  const setProp = (path, value) => foundry.utils.setProperty(updateData, path, value);\n\n  const systemData = item.system ?? {};\n  const durableNames = new Set([\"durable\"]);\n  const normalizeLabel = (value) => String(value ?? \"\").trim().toLowerCase();\n\n  const removeDurableFromArray = (arr) => {\n    const filtered = arr.filter((entry) => {\n      const label = normalizeLabel(entry?.name ?? entry?.label ?? entry);\n      return !durableNames.has(label);\n    });\n    return filtered.length === arr.length ? null : filtered;\n  };\n\n  const propertiesArrays = [\n    { path: \"system.item.properties\", value: systemData?.item?.properties },\n    { path: \"system.properties\", value: systemData?.properties },\n    { path: \"system.qualities\", value: Array.isArray(systemData?.qualities) ? systemData.qualities : null },\n  ];\n  let durableRemoved = false;\n  for (const { path, value } of propertiesArrays) {\n    if (!Array.isArray(value)) continue;\n    const filtered = removeDurableFromArray(value);\n    if (filtered) {\n      setProp(path, filtered);\n      durableRemoved = true;\n    }\n  }\n\n  const qualitiesObject =\n    ensureObject(systemData?.qualities) && !Array.isArray(systemData.qualities) ? ensureObject(systemData.qualities) : null;\n  if (qualitiesObject) {\n    const clone = foundry.utils.deepClone(qualitiesObject);\n    let changed = false;\n    if (clone.Durable) {\n      delete clone.Durable;\n      changed = true;\n    }\n    if (clone.durable) {\n      delete clone.durable;\n      changed = true;\n    }\n    if (changed) {\n      setProp(\"system.qualities\", clone);\n      durableRemoved = true;\n    }\n  }\n\n  const alreadyDamaged = Boolean(foundry.utils.getProperty(systemData, \"qualities.damaged\"));\n  const alreadyDestroyed = Boolean(foundry.utils.getProperty(systemData, \"qualities.destroyed\"));\n\n  let stateChanged = false;\n  let currentState = null;\n\n  if (!alreadyDamaged && !alreadyDestroyed) {\n    setProp(\"system.qualities.damaged\", true);\n    stateChanged = true;\n    currentState = \"damaged\";\n  } else if (alreadyDamaged && !alreadyDestroyed) {\n    setProp(\"system.qualities.destroyed\", true);\n    stateChanged = true;\n    currentState = \"destroyed\";\n  } else if (!alreadyDamaged && alreadyDestroyed) {\n    setProp(\"system.qualities.damaged\", true);\n    setProp(\"system.qualities.destroyed\", true);\n    stateChanged = true;\n    currentState = \"destroyed\";\n  } else if (alreadyDamaged && alreadyDestroyed) {\n    currentState = \"destroyed\";\n  }\n\n  if (item.type === \"armor\") {\n    const physical = Number(systemData?.armor?.physical ?? 0);\n    const supernatural = Number(systemData?.armor?.supernatural ?? 0);\n    if (currentState === \"damaged\") {\n      const newPhysical = Math.max(0, physical - 2);\n      const newSupernatural = Math.max(0, supernatural - 2);\n      if (newPhysical !== physical) setProp(\"system.armor.physical\", newPhysical);\n      if (newSupernatural !== supernatural) setProp(\"system.armor.supernatural\", newSupernatural);\n    } else if (currentState === \"destroyed\") {\n      if (physical !== 0) setProp(\"system.armor.physical\", 0);\n      if (supernatural !== 0) setProp(\"system.armor.supernatural\", 0);\n    }\n  } else if (item.type === \"weapon\" && currentState === \"destroyed\") {\n    if (Number(systemData?.damage ?? 0) !== 0) setProp(\"system.damage\", 0);\n    if (Number(systemData?.deadliness ?? 0) !== 0) setProp(\"system.deadliness\", 0);\n  }\n\n  if (!durableRemoved && !stateChanged && Object.keys(updateData).length === 0) {\n    return;\n  }\n\n  if (ctx && typeof ctx.mutate === \"function\") {\n    await ctx.mutate(item, updateData);\n  } else if (typeof item.update === \"function\") {\n    await item.update(updateData);\n  }\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Damage_an_item", "uuid": "Compendium.l5r5e.core-macros-base-effects.Damage_an_item"}}}
{"_id": "Add_Condition", "name": "Add Condition", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/aura.svg", "scope": "global", "command": "(async () => {\n  const ensureObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : null);\n  const argArray = Array.isArray(args) ? args : [args];\n  const objectArgs = argArray.filter((entry) => ensureObject(entry));\n  const primaryArg =\n    objectArgs.find((entry) => entry?.ctx || entry?.target || entry?.actor || entry?.item || entry?.value !== undefined) ??\n    objectArgs[0] ??\n    {};\n  const ctx = ensureObject(primaryArg?.ctx) ?? objectArgs.map((entry) => ensureObject(entry?.ctx)).find(Boolean) ?? {};\n  const unwrapActor = (value) => {\n    if (!value) return null;\n    if (value.actor) return value.actor;\n    if (value.document?.actor) return value.document.actor;\n    if (value.token?.actor) return value.token.actor;\n    if (value.parent?.actor) return value.parent.actor;\n    return value;\n  };\n  const targetActor =\n    unwrapActor(primaryArg?.target) ??\n    unwrapActor(ctx?.target) ??\n    unwrapActor(primaryArg?.actor) ??\n    unwrapActor(ctx?.actor);\n  if (!targetActor) {\n    console.warn(\"Add_Condition | Missing target actor context.\");\n    return;\n  }\n\n  const parameterSources = [];\n  const collectParameterSources = (entry) => {\n    if (!entry || typeof entry !== \"object\") return;\n    [entry.parameters, entry.parameterValues, entry.parameterMap, entry.params, entry.values]\n      .map(ensureObject)\n      .filter((val) => !!val)\n      .forEach((val) => parameterSources.push(val));\n  };\n  objectArgs.forEach(collectParameterSources);\n\n  const parameterDefs = [];\n  objectArgs.forEach((entry) => {\n    if (Array.isArray(entry?.parameterDefs)) {\n      parameterDefs.push(...entry.parameterDefs);\n    }\n  });\n  const parameterDefMap = new Map();\n  parameterDefs.forEach((def) => {\n    if (def?.name && !parameterDefMap.has(def.name)) {\n      parameterDefMap.set(def.name, def);\n    }\n  });\n\n  const getParameterValue = (names, fallback) => {\n    const keys = Array.isArray(names) ? names : [names];\n    for (const key of keys) {\n      if (!key) continue;\n      for (const source of parameterSources) {\n        if (Object.prototype.hasOwnProperty.call(source, key) && source[key] !== undefined) {\n          return source[key];\n        }\n      }\n      if (parameterDefMap.has(key)) {\n        const def = parameterDefMap.get(key);\n        if (def?.defaultValue !== undefined) {\n          return def.defaultValue;\n        }\n      }\n    }\n    return fallback;\n  };\n\n  const rawCondition = getParameterValue(\n    [\"condition\", \"Condition\", \"value\", \"name\", \"key\"],\n    primaryArg?.value ?? ctx?.value ?? null\n  );\n  const condition = String(rawCondition?.id ?? rawCondition?.name ?? rawCondition ?? \"\").trim();\n  if (!condition) {\n    console.warn(\"Add_Condition | No condition key provided.\");\n    return;\n  }\n\n  const currentValue = Boolean(foundry.utils.getProperty(targetActor, `flags.l5r5e.conditions.${condition}`));\n  if (currentValue) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, `flags.l5r5e.conditions.${condition}`, true);\n\n  if (ctx && typeof ctx.mutate === \"function\") {\n    await ctx.mutate(targetActor, updateData);\n  } else if (typeof targetActor.update === \"function\") {\n    await targetActor.update(updateData);\n  }\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Add_Condition", "uuid": "Compendium.l5r5e.core-macros-base-effects.Add_Condition"}}}
{"_id": "Remove_Condition", "name": "Remove Condition", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/cancel.svg", "scope": "global", "command": "(async () => {\n  const ensureObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : null);\n  const argArray = Array.isArray(args) ? args : [args];\n  const objectArgs = argArray.filter((entry) => ensureObject(entry));\n  const primaryArg =\n    objectArgs.find((entry) => entry?.ctx || entry?.target || entry?.actor || entry?.item || entry?.value !== undefined) ??\n    objectArgs[0] ??\n    {};\n  const ctx = ensureObject(primaryArg?.ctx) ?? objectArgs.map((entry) => ensureObject(entry?.ctx)).find(Boolean) ?? {};\n  const unwrapActor = (value) => {\n    if (!value) return null;\n    if (value.actor) return value.actor;\n    if (value.document?.actor) return value.document.actor;\n    if (value.token?.actor) return value.token.actor;\n    if (value.parent?.actor) return value.parent.actor;\n    return value;\n  };\n  const targetActor =\n    unwrapActor(primaryArg?.target) ??\n    unwrapActor(ctx?.target) ??\n    unwrapActor(primaryArg?.actor) ??\n    unwrapActor(ctx?.actor);\n  if (!targetActor) {\n    console.warn(\"Remove_Condition | Missing target actor context.\");\n    return;\n  }\n\n  const parameterSources = [];\n  const collectParameterSources = (entry) => {\n    if (!entry || typeof entry !== \"object\") return;\n    [entry.parameters, entry.parameterValues, entry.parameterMap, entry.params, entry.values]\n      .map(ensureObject)\n      .filter((val) => !!val)\n      .forEach((val) => parameterSources.push(val));\n  };\n  objectArgs.forEach(collectParameterSources);\n\n  const parameterDefs = [];\n  objectArgs.forEach((entry) => {\n    if (Array.isArray(entry?.parameterDefs)) {\n      parameterDefs.push(...entry.parameterDefs);\n    }\n  });\n  const parameterDefMap = new Map();\n  parameterDefs.forEach((def) => {\n    if (def?.name && !parameterDefMap.has(def.name)) {\n      parameterDefMap.set(def.name, def);\n    }\n  });\n\n  const getParameterValue = (names, fallback) => {\n    const keys = Array.isArray(names) ? names : [names];\n    for (const key of keys) {\n      if (!key) continue;\n      for (const source of parameterSources) {\n        if (Object.prototype.hasOwnProperty.call(source, key) && source[key] !== undefined) {\n          return source[key];\n        }\n      }\n      if (parameterDefMap.has(key)) {\n        const def = parameterDefMap.get(key);\n        if (def?.defaultValue !== undefined) {\n          return def.defaultValue;\n        }\n      }\n    }\n    return fallback;\n  };\n\n  const rawCondition = getParameterValue(\n    [\"condition\", \"Condition\", \"value\", \"name\", \"key\"],\n    primaryArg?.value ?? ctx?.value ?? null\n  );\n  const condition = String(rawCondition?.id ?? rawCondition?.name ?? rawCondition ?? \"\").trim();\n  if (!condition) {\n    console.warn(\"Remove_Condition | No condition key provided.\");\n    return;\n  }\n\n  const currentValue = Boolean(foundry.utils.getProperty(targetActor, `flags.l5r5e.conditions.${condition}`));\n  if (!currentValue) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, `flags.l5r5e.conditions.${condition}`, false);\n\n  if (ctx && typeof ctx.mutate === \"function\") {\n    await ctx.mutate(targetActor, updateData);\n  } else if (typeof targetActor.update === \"function\") {\n    await targetActor.update(updateData);\n  }\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Remove_Condition", "uuid": "Compendium.l5r5e.core-macros-base-effects.Remove_Condition"}}}
{"_id": "Deal_Fatigue", "name": "Deal Fatigue", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/exhausted.webp", "scope": "global", "command": "(async () => {\n  const ensureObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : null);\n  const argArray = Array.isArray(args) ? args : [args];\n  const objectArgs = argArray.filter((entry) => ensureObject(entry));\n  const primaryArg =\n    objectArgs.find((entry) => entry?.ctx || entry?.target || entry?.actor || entry?.item || entry?.value !== undefined) ??\n    objectArgs[0] ??\n    {};\n  const ctx = ensureObject(primaryArg?.ctx) ?? objectArgs.map((entry) => ensureObject(entry?.ctx)).find(Boolean) ?? {};\n  const unwrapActor = (value) => {\n    if (!value) return null;\n    if (value.actor) return value.actor;\n    if (value.document?.actor) return value.document.actor;\n    if (value.token?.actor) return value.token.actor;\n    if (value.parent?.actor) return value.parent.actor;\n    return value;\n  };\n  const targetActor =\n    unwrapActor(primaryArg?.target) ??\n    unwrapActor(ctx?.target) ??\n    unwrapActor(primaryArg?.actor) ??\n    unwrapActor(ctx?.actor);\n  if (!targetActor) {\n    console.warn(\"Deal_Fatigue | Missing target actor context.\");\n    return;\n  }\n\n  const parameterSources = [];\n  const collectParameterSources = (entry) => {\n    if (!entry || typeof entry !== \"object\") return;\n    [entry.parameters, entry.parameterValues, entry.parameterMap, entry.params, entry.values]\n      .map(ensureObject)\n      .filter((val) => !!val)\n      .forEach((val) => parameterSources.push(val));\n  };\n  objectArgs.forEach(collectParameterSources);\n\n  const parameterDefs = [];\n  objectArgs.forEach((entry) => {\n    if (Array.isArray(entry?.parameterDefs)) {\n      parameterDefs.push(...entry.parameterDefs);\n    }\n  });\n  const parameterDefMap = new Map();\n  parameterDefs.forEach((def) => {\n    if (def?.name && !parameterDefMap.has(def.name)) {\n      parameterDefMap.set(def.name, def);\n    }\n  });\n\n  const getParameterValue = (names, fallback) => {\n    const keys = Array.isArray(names) ? names : [names];\n    for (const key of keys) {\n      if (!key) continue;\n      for (const source of parameterSources) {\n        if (Object.prototype.hasOwnProperty.call(source, key) && source[key] !== undefined) {\n          return source[key];\n        }\n      }\n      if (parameterDefMap.has(key)) {\n        const def = parameterDefMap.get(key);\n        if (def?.type === \"number\") {\n          const numeric = Number(def.defaultValue ?? def.value ?? 0);\n          if (Number.isFinite(numeric)) {\n            return numeric;\n          }\n        }\n        if (def?.defaultValue !== undefined) {\n          return def.defaultValue;\n        }\n      }\n    }\n    return fallback;\n  };\n\n  const fallbackAmount =\n    primaryArg?.value ??\n    ctx?.value ??\n    parameterSources.find((source) => source && typeof source._total !== \"undefined\")?._total ??\n    0;\n  let amount = Number(getParameterValue([\"fatigue\", \"Fatigue\", \"value\", \"amount\", \"_total\"], fallbackAmount));\n  if (!Number.isFinite(amount) || amount === 0) {\n    return;\n  }\n\n  const currentFatigue = Number(foundry.utils.getProperty(targetActor, \"system.fatigue.value\") ?? 0);\n  const newFatigue = Math.max(0, currentFatigue + amount);\n  if (newFatigue === currentFatigue) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, \"system.fatigue.value\", newFatigue);\n\n  const maxFatigue = Number(\n    foundry.utils.getProperty(targetActor, \"system.fatigue.max\") ??\n      foundry.utils.getProperty(targetActor, \"system.endurance\") ??\n      0\n  );\n  const shouldBeIncapacitated = maxFatigue > 0 && newFatigue >= maxFatigue;\n  const currentIncapacitated = Boolean(\n    foundry.utils.getProperty(targetActor, \"flags.l5r5e.conditions.Incapacitated\")\n  );\n  if (shouldBeIncapacitated !== currentIncapacitated) {\n    foundry.utils.setProperty(updateData, \"flags.l5r5e.conditions.Incapacitated\", shouldBeIncapacitated);\n  }\n\n  if (ctx && typeof ctx.mutate === \"function\") {\n    await ctx.mutate(targetActor, updateData);\n  } else if (typeof targetActor.update === \"function\") {\n    await targetActor.update(updateData);\n  }\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_Fatigue", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue"}}}
{"_id": "Deal_Strife", "name": "Deal Strife", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/compromised.webp", "scope": "global", "command": "(async () => {\n  const ensureObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : null);\n  const argArray = Array.isArray(args) ? args : [args];\n  const objectArgs = argArray.filter((entry) => ensureObject(entry));\n  const primaryArg =\n    objectArgs.find((entry) => entry?.ctx || entry?.target || entry?.actor || entry?.item || entry?.value !== undefined) ??\n    objectArgs[0] ??\n    {};\n  const ctx = ensureObject(primaryArg?.ctx) ?? objectArgs.map((entry) => ensureObject(entry?.ctx)).find(Boolean) ?? {};\n  const unwrapActor = (value) => {\n    if (!value) return null;\n    if (value.actor) return value.actor;\n    if (value.document?.actor) return value.document.actor;\n    if (value.token?.actor) return value.token.actor;\n    if (value.parent?.actor) return value.parent.actor;\n    return value;\n  };\n  const targetActor =\n    unwrapActor(primaryArg?.target) ??\n    unwrapActor(ctx?.target) ??\n    unwrapActor(primaryArg?.actor) ??\n    unwrapActor(ctx?.actor);\n  if (!targetActor) {\n    console.warn(\"Deal_Strife | Missing target actor context.\");\n    return;\n  }\n\n  const parameterSources = [];\n  const collectParameterSources = (entry) => {\n    if (!entry || typeof entry !== \"object\") return;\n    [entry.parameters, entry.parameterValues, entry.parameterMap, entry.params, entry.values]\n      .map(ensureObject)\n      .filter((val) => !!val)\n      .forEach((val) => parameterSources.push(val));\n  };\n  objectArgs.forEach(collectParameterSources);\n\n  const parameterDefs = [];\n  objectArgs.forEach((entry) => {\n    if (Array.isArray(entry?.parameterDefs)) {\n      parameterDefs.push(...entry.parameterDefs);\n    }\n  });\n  const parameterDefMap = new Map();\n  parameterDefs.forEach((def) => {\n    if (def?.name && !parameterDefMap.has(def.name)) {\n      parameterDefMap.set(def.name, def);\n    }\n  });\n\n  const getParameterValue = (names, fallback) => {\n    const keys = Array.isArray(names) ? names : [names];\n    for (const key of keys) {\n      if (!key) continue;\n      for (const source of parameterSources) {\n        if (Object.prototype.hasOwnProperty.call(source, key) && source[key] !== undefined) {\n          return source[key];\n        }\n      }\n      if (parameterDefMap.has(key)) {\n        const def = parameterDefMap.get(key);\n        if (def?.type === \"number\") {\n          const numeric = Number(def.defaultValue ?? def.value ?? 0);\n          if (Number.isFinite(numeric)) {\n            return numeric;\n          }\n        }\n        if (def?.defaultValue !== undefined) {\n          return def.defaultValue;\n        }\n      }\n    }\n    return fallback;\n  };\n\n  const fallbackAmount =\n    primaryArg?.value ??\n    ctx?.value ??\n    parameterSources.find((source) => source && typeof source._total !== \"undefined\")?._total ??\n    0;\n  let amount = Number(getParameterValue([\"strife\", \"Strife\", \"value\", \"amount\", \"_total\"], fallbackAmount));\n  if (!Number.isFinite(amount) || amount === 0) {\n    return;\n  }\n\n  const currentStrife = Number(foundry.utils.getProperty(targetActor, \"system.strife.value\") ?? 0);\n  const newStrife = Math.max(0, currentStrife + amount);\n  if (newStrife === currentStrife) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, \"system.strife.value\", newStrife);\n\n  const maxStrife = Number(\n    foundry.utils.getProperty(targetActor, \"system.strife.max\") ??\n      foundry.utils.getProperty(targetActor, \"system.composure\") ??\n      0\n  );\n  const shouldBeCompromised = maxStrife > 0 && newStrife >= maxStrife;\n  const currentCompromised = Boolean(\n    foundry.utils.getProperty(targetActor, \"flags.l5r5e.conditions.Compromised\")\n  );\n  if (shouldBeCompromised !== currentCompromised) {\n    foundry.utils.setProperty(updateData, \"flags.l5r5e.conditions.Compromised\", shouldBeCompromised);\n  }\n\n  if (ctx && typeof ctx.mutate === \"function\") {\n    await ctx.mutate(targetActor, updateData);\n  } else if (typeof targetActor.update === \"function\") {\n    await targetActor.update(updateData);\n  }\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_Strife", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_Strife"}}}
{"_id": "Deal_damage", "name": "Deal Damage", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/combat.svg", "scope": "global", "command": "(async () => {\n  const ensureObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : null);\n  const argArray = Array.isArray(args) ? args : [args];\n  const objectArgs = argArray.filter((entry) => ensureObject(entry));\n  const primaryArg =\n    objectArgs.find((entry) => entry?.ctx || entry?.target || entry?.actor || entry?.item || entry?.value !== undefined) ??\n    objectArgs[0] ??\n    {};\n  const ctx = ensureObject(primaryArg?.ctx) ?? objectArgs.map((entry) => ensureObject(entry?.ctx)).find(Boolean) ?? {};\n  const unwrapActor = (value) => {\n    if (!value) return null;\n    if (value.actor) return value.actor;\n    if (value.document?.actor) return value.document.actor;\n    if (value.token?.actor) return value.token.actor;\n    if (value.parent?.actor) return value.parent.actor;\n    return value;\n  };\n  const targetActor = unwrapActor(primaryArg?.target) ?? unwrapActor(ctx?.target);\n  if (!targetActor) {\n    console.warn(\"Deal_damage | Missing target actor context.\");\n    return;\n  }\n  const attacker = unwrapActor(primaryArg?.actor) ?? unwrapActor(ctx?.actor);\n  const weapon = primaryArg?.item ?? ctx?.item ?? null;\n\n  const parameterSources = [];\n  const collectParameterSources = (entry) => {\n    if (!entry || typeof entry !== \"object\") return;\n    [entry.parameters, entry.parameterValues, entry.parameterMap, entry.params, entry.values]\n      .map(ensureObject)\n      .filter((val) => !!val)\n      .forEach((val) => parameterSources.push(val));\n  };\n  objectArgs.forEach(collectParameterSources);\n\n  const parameterDefs = [];\n  objectArgs.forEach((entry) => {\n    if (Array.isArray(entry?.parameterDefs)) {\n      parameterDefs.push(...entry.parameterDefs);\n    }\n  });\n  const parameterDefMap = new Map();\n  parameterDefs.forEach((def) => {\n    if (def?.name && !parameterDefMap.has(def.name)) {\n      parameterDefMap.set(def.name, def);\n    }\n  });\n\n  const getParameterValue = (names, fallback) => {\n    const keys = Array.isArray(names) ? names : [names];\n    for (const key of keys) {\n      if (!key) continue;\n      for (const source of parameterSources) {\n        if (Object.prototype.hasOwnProperty.call(source, key) && source[key] !== undefined) {\n          return source[key];\n        }\n      }\n      if (parameterDefMap.has(key)) {\n        const def = parameterDefMap.get(key);\n        if (def?.type === \"number\") {\n          const numeric = Number(def.defaultValue ?? def.value ?? 0);\n          if (Number.isFinite(numeric)) {\n            return numeric;\n          }\n        }\n        if (def?.defaultValue !== undefined) {\n          return def.defaultValue;\n        }\n      }\n    }\n    return fallback;\n  };\n\n  const toNumber = (value, fallback = 0) => {\n    if (value === null || value === undefined || value === \"\") return fallback;\n    const numeric = Number(value);\n    return Number.isFinite(numeric) ? numeric : fallback;\n  };\n\n  const fallbackDamage =\n    primaryArg?.value ??\n    ctx?.value ??\n    parameterSources.find((source) => source && typeof source._total !== \"undefined\")?._total ??\n    0;\n  let damage = toNumber(getParameterValue([\"damage\", \"Damage\", \"value\", \"amount\", \"_total\"], fallbackDamage), 0);\n\n  const normalizeDefenseType = (value) => {\n    if (typeof value !== \"string\") return \"\";\n    const normalized = value.trim().toLowerCase();\n    if ([\"physical\", \"phys\", \"fizyczna\"].includes(normalized)) return \"physical\";\n    if ([\"spiritual\", \"supernatural\", \"spirit\", \"magical\", \"duchowa\"].includes(normalized)) return \"spiritual\";\n    return normalized;\n  };\n\n  const defenseTypeRaw =\n    getParameterValue([\"defense_type\", \"defenseType\", \"defense\", \"resistance_type\"], ctx?.defense ?? primaryArg?.defense ?? null);\n  const defenseType = normalizeDefenseType(defenseTypeRaw);\n\n  const getResistance = (actor, type) => {\n    if (!actor) return 0;\n    const paths = type === \"physical\"\n      ? [\n          \"system.physicalResistance\",\n          \"system.resistances.physical\",\n          \"system.resistance.physical\",\n          \"system.defenses.physical\",\n          \"system.conflict.resistances.physical\",\n          \"system.resistances?.physical\",\n          \"system.defense?.physical\",\n        ]\n      : [\n          \"system.spiritualResistance\",\n          \"system.resistances.spiritual\",\n          \"system.resistances.supernatural\",\n          \"system.resistance.spiritual\",\n          \"system.defenses.spiritual\",\n          \"system.defenses.supernatural\",\n          \"system.conflict.resistances.spiritual\",\n          \"system.conflict.resistances.supernatural\",\n        ];\n    for (const path of paths) {\n      const value = foundry.utils.getProperty(actor, path);\n      if (value !== undefined && value !== null) {\n        const numeric = Number(value);\n        if (Number.isFinite(numeric)) {\n          return numeric;\n        }\n      }\n    }\n    return 0;\n  };\n\n  if (defenseType === \"physical\") {\n    const resistance = getResistance(targetActor, \"physical\");\n    damage = Math.max(0, damage - resistance);\n  } else if ([\"spiritual\", \"supernatural\"].includes(defenseType)) {\n    const resistance = getResistance(targetActor, \"spiritual\");\n    damage = Math.max(0, damage - resistance);\n  }\n\n  const hasQuality = (item, quality) => {\n    if (!item) return false;\n    const target = String(quality ?? \"\").trim().toLowerCase();\n    const arrays = [\n      item.system?.item?.properties,\n      item.system?.properties,\n      Array.isArray(item.system?.qualities) ? item.system.qualities : null,\n    ];\n    for (const list of arrays) {\n      if (!Array.isArray(list)) continue;\n      if (list.some((entry) => String(entry?.name ?? entry?.label ?? entry).trim().toLowerCase() === target)) {\n        return true;\n      }\n    }\n    const qualitiesObj = item.system?.qualities;\n    if (qualitiesObj && typeof qualitiesObj === \"object\" && !Array.isArray(qualitiesObj)) {\n      if (Object.entries(qualitiesObj).some(([key, val]) => String(key).trim().toLowerCase() === target && !!val)) {\n        return true;\n      }\n    }\n    return false;\n  };\n\n  const isRazor = hasQuality(weapon, \"razor-edged\");\n\n  if (damage <= 0) {\n    if (isRazor) {\n      try {\n        const macro = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Damage_an_item\");\n        await macro?.execute({ ctx, item: weapon });\n      } catch (error) {\n        console.error(\"Deal_damage | Unable to execute Damage_an_item macro\", error);\n      }\n    }\n    return;\n  }\n\n  const incapacitated = Boolean(foundry.utils.getProperty(targetActor, \"flags.l5r5e.conditions.Incapacitated\"));\n  const severityFallback =\n    getParameterValue(\n      [\"deadliness\", \"Deadliness\", \"severity\"],\n      primaryArg?.deadliness ?? ctx?.deadliness ?? weapon?.system?.deadliness ?? null\n    );\n  const severity = toNumber(severityFallback, 0);\n\n  if (incapacitated) {\n    try {\n      const macro = await fromUuid(\"Compendium.l5r5e.core-macros-tests.Resist_Critical\");\n      await macro?.execute({\n        ctx,\n        severity,\n        isRazor,\n        parameters: { severity, isRazor },\n      });\n    } catch (error) {\n      console.error(\"Deal_damage | Unable to execute Resist_Critical macro\", error);\n    }\n    return;\n  }\n\n  try {\n    const macro = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue\");\n    await macro?.execute({\n      ctx,\n      value: damage,\n      parameters: { fatigue: damage, value: damage, amount: damage, _total: damage },\n      actor: attacker,\n      item: weapon,\n    });\n  } catch (error) {\n    console.error(\"Deal_damage | Unable to execute Deal_Fatigue macro\", error);\n  }\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_damage", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_damage"}}}
{"_id": "Resolve_critical_strike", "name": "Resolve Critical Strike", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/skull.svg", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor) return;\n\nlet baseSeverity = Number(args.value) || 0;\nconst rings = [\"Air\", \"Earth\", \"Fire\", \"Water\", \"Void\"];\n\nlet radioHtml = rings\n  .map(r => `<label><input type='radio' name='ringChoice' value='${r}' ${r === \"Earth\" ? \"checked\" : \"\"}> ${game.i18n.localize('L5R5E.Ring' + r)}</label>`)\n  .join(\"<br>\");\n\nnew Dialog({\n  title: \"Critical Strike — Fitness Check\",\n  content: `<p>Choose a ring for the Fitness check (TN 1):</p>${radioHtml}`,\n  buttons: {\n    roll: {\n      label: \"Roll check\",\n      callback: (html) => {\n        const ring = html.find('input[name=\"ringChoice\"]:checked').val();\n        actor.rollCheck(\"fitness\", ring, 1);\n      }\n    },\n    skip: {\n      label: \"Skip check\",\n      callback: () => { processCritical(baseSeverity); }\n    }\n  },\n  default: \"roll\"\n}).render(true);\n\nfunction processCritical(finalSeverity) {\n  if (finalSeverity <= 2) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Damage_an_item\")?.execute({ ctx: args.ctx });\n\n  } else if (finalSeverity <= 4) {\n    ctx.mutate(actor, { [\"flags.l5r5e.conditions.LightlyWounded\"]: true });\n    if (args.ctx.item?.system.qualities?.includes(\"Razor-Edged\")) {\n      game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    }\n\n  } else if (finalSeverity <= 6) {\n    ctx.mutate(actor, { [\"flags.l5r5e.conditions.SeverelyWounded\"]: true });\n    if (args.ctx.item?.system.qualities?.includes(\"Razor-Edged\")) {\n      game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    }\n\n  } else if (finalSeverity <= 8) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n\n  } else if (finalSeverity <= 11) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n\n  } else if (finalSeverity <= 13) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"SeverelyWounded\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Dying\" });\n\n  } else if (finalSeverity <= 15) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"SeverelyWounded\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Dying\" });\n\n  } else {\n    // Instant death case. No chat output.\n  }\n}", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resolve_critical_strike", "uuid": "Compendium.l5r5e.core-macros-base-effects.Resolve_critical_strike"}}}
{"_id": "Example_Base_Effect", "name": "Example Base Effect", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "(() => {\n  const ensureObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : null);\n  const argArray = Array.isArray(args) ? args : [args];\n  const objectArgs = argArray.filter((entry) => ensureObject(entry));\n  const primaryArg =\n    objectArgs.find((entry) => entry?.ctx || entry?.parameters || entry?.parameterValues || entry?.value !== undefined) ??\n    objectArgs[0] ??\n    {};\n  const ctx = ensureObject(primaryArg?.ctx) ?? objectArgs.map((entry) => ensureObject(entry?.ctx)).find(Boolean) ?? {};\n\n  const parameterSources = [];\n  const collectParameterSources = (entry) => {\n    if (!entry || typeof entry !== \"object\") return;\n    [entry.parameters, entry.parameterValues, entry.parameterMap, entry.params, entry.values]\n      .map(ensureObject)\n      .filter((val) => !!val)\n      .forEach((val) => parameterSources.push(val));\n  };\n  objectArgs.forEach(collectParameterSources);\n\n  const parameterDefs = [];\n  objectArgs.forEach((entry) => {\n    if (Array.isArray(entry?.parameterDefs)) {\n      parameterDefs.push(...entry.parameterDefs);\n    }\n  });\n  const parameterDefMap = new Map();\n  parameterDefs.forEach((def) => {\n    if (def?.name && !parameterDefMap.has(def.name)) {\n      parameterDefMap.set(def.name, def);\n    }\n  });\n\n  const getParameterValue = (names, fallback) => {\n    const keys = Array.isArray(names) ? names : [names];\n    for (const key of keys) {\n      if (!key) continue;\n      for (const source of parameterSources) {\n        if (Object.prototype.hasOwnProperty.call(source, key) && source[key] !== undefined) {\n          return source[key];\n        }\n      }\n      if (parameterDefMap.has(key)) {\n        const def = parameterDefMap.get(key);\n        if (def?.defaultValue !== undefined) {\n          return def.defaultValue;\n        }\n      }\n    }\n    return fallback;\n  };\n\n  const toNumber = (value, fallback = 0) => {\n    if (value === null || value === undefined || value === \"\") return fallback;\n    const numeric = Number(value);\n    return Number.isFinite(numeric) ? numeric : fallback;\n  };\n\n  const toBoolean = (value, fallback = false) => {\n    if (value === null || value === undefined) return fallback;\n    if (typeof value === \"string\") {\n      const normalized = value.trim().toLowerCase();\n      if ([\"1\", \"true\", \"yes\", \"on\"].includes(normalized)) return true;\n      if ([\"0\", \"false\", \"no\", \"off\"].includes(normalized)) return false;\n      return fallback;\n    }\n    return Boolean(value);\n  };\n\n  const mergedParameters = parameterSources.reduce((acc, source) => {\n    foundry.utils.mergeObject(acc, source, { overwrite: true });\n    return acc;\n  }, {});\n\n  const numericValue = toNumber(getParameterValue([\"damage\", \"value\", \"numberExample\"], primaryArg?.value ?? 0), 0);\n  const toggleValue = toBoolean(getParameterValue([\"useRazor\", \"toggle\", \"flagExample\"], false), false);\n  const choiceValue = getParameterValue([\"defense_type\", \"choice\", \"listExample\"], \"physical\");\n\n  console.log(\"Example_Base_Effect\", {\n    ctx,\n    parameters: mergedParameters,\n    parameterDefs,\n    numericValue,\n    toggleValue,\n    choiceValue,\n    rawArgs: argArray,\n  });\n\n  const message = `Example_Base_Effect — damage: ${numericValue}, useRazor: ${toggleValue}, defense: ${choiceValue}`;\n  ui.notifications?.info?.(message);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Base_Effect", "uuid": "Compendium.l5r5e.core-macros-base-effects.Example_Base_Effect"}}, "parameterDefs": [{"name": "damage", "label": "Damage", "type": "number", "description": "Example numeric parameter with default value.", "defaultValue": 3, "includeInTotal": true}, {"name": "useRazor", "label": "Use Razor-Edged", "type": "boolean", "description": "Example toggle parameter.", "defaultValue": false}, {"name": "defense_type", "label": "Defense Type", "type": "list", "description": "Example list parameter.", "defaultValue": "physical", "options": [{"value": "physical", "label": "Physical"}, {"value": "spiritual", "label": "Spiritual"}, {"value": "none", "label": "None"}]}]}
