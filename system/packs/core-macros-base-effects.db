{"_id": "Damage_an_item", "name": "Damage an Item", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/bomb.svg", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor) return;\n\nlet item;\nif (args.value) {\n  item = actor.items.get(args.value) || actor.items.find(i => i.name === args.value);\n} else {\n  item = actor.items.find(i => i.type === \"armor\" && i.system.equipped);\n}\nif (!item) return;\n\nif (!item.system.qualities?.damaged && !item.system.qualities?.destroyed) {\n  ctx.mutate(item, { \"system.qualities.damaged\": true });\n} else if (item.system.qualities?.damaged && !item.system.qualities?.destroyed) {\n  ctx.mutate(item, { \"system.qualities.destroyed\": true });\n}", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Damage_an_item", "uuid": "Compendium.l5r5e.core-macros-base-effects.Damage_an_item"}}}
{"_id": "Add_Condition", "name": "Add Condition", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/aura.svg", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor || !args.value) return;\nctx.mutate(actor, { [`flags.l5r5e.conditions.${args.value}`]: true });", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Add_Condition", "uuid": "Compendium.l5r5e.core-macros-base-effects.Add_Condition"}}}
{"_id": "Remove_Condition", "name": "Remove Condition", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/cancel.svg", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor || !args.value) return;\nctx.mutate(actor, { [`flags.l5r5e.conditions.${args.value}`]: false });", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Remove_Condition", "uuid": "Compendium.l5r5e.core-macros-base-effects.Remove_Condition"}}}
{"_id": "Deal_Fatigue", "name": "Deal Fatigue", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/exhausted.webp", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor) return;\n\nlet amount = Number(args.value) || 0;\nif (!amount) return;\n\nlet current = actor.system.fatigue || 0;\nlet newFatigue = current + amount;\nctx.mutate(actor, { \"system.fatigue\": newFatigue });\n\nif (newFatigue >= (actor.system.endurance || 0)) {\n  ctx.mutate(actor, { [\"flags.l5r5e.conditions.Incapacitated\"]: true });\n}", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_Fatigue", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue"}}}
{"_id": "Deal_Strife", "name": "Deal Strife", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/compromised.webp", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor) return;\n\nlet amount = Number(args.value) || 0;\nif (!amount) return;\n\nlet current = actor.system.strife || 0;\nlet newStrife = current + amount;\nctx.mutate(actor, { \"system.strife\": newStrife });\n\nif (newStrife >= (actor.system.composure || 0)) {\n  ctx.mutate(actor, { [\"flags.l5r5e.conditions.Compromised\"]: true });\n}", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_Strife", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_Strife"}}}
{"_id": "Deal_damage", "name": "Deal Damage", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/combat.svg", "scope": "global", "command": "(async () => {\n  const target = args?.ctx?.target;\n  if (!target) return;\n\n  const attacker = args?.ctx?.actor;\n  const weapon  = args?.ctx?.item;\n\n  let damage = Number(args?.value) || 0;\n\n  if (args?.ctx?.defense === 'physical') {\n    const res = target.system?.physicalResistance || 0;\n    damage = Math.max(damage - res, 0);\n  }\n\n  if (args?.ctx?.defense === 'spiritual') {\n    const res = target.system?.spiritualResistance || 0;\n    damage = Math.max(damage - res, 0);\n  }\n\n  const isRazor = weapon?.system?.qualities?.includes?.(\"Razor-Edged\");\n  if (damage <= 0) {\n    if (isRazor) {\n      const uuid  = \"Compendium.l5r5e.core-macros-base-effects.Damage_an_item\";\n      const macro = await fromUuid(uuid);\n      await macro?.execute({ ctx: args.ctx, item: weapon });\n    }\n    return;\n  }\n\n  if (foundry?.utils?.getProperty(target, 'flags.l5r5e.conditions.Incapacitated')) {\n    const uuid  = \"Compendium.l5r5e.core-macros-tests.Resist_Critical\";\n    const macro = await fromUuid(uuid);\n    await macro?.execute({ ctx: args.ctx, severity: args.ctx?.deadliness, isRazor });\n  }\n\n  const uuid  = \"Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue\";\n  const macro = await fromUuid(uuid);\n  await macro?.execute({ ctx: args.ctx, value: damage });\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_damage", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_damage"}}}
{"_id": "Resolve_critical_strike", "name": "Resolve Critical Strike", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/skull.svg", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor) return;\n\nlet baseSeverity = Number(args.value) || 0;\nconst rings = [\"Air\", \"Earth\", \"Fire\", \"Water\", \"Void\"];\n\nlet radioHtml = rings\n  .map(r => `<label><input type='radio' name='ringChoice' value='${r}' ${r === \"Earth\" ? \"checked\" : \"\"}> ${game.i18n.localize('L5R5E.Ring' + r)}</label>`)\n  .join(\"<br>\");\n\nnew Dialog({\n  title: \"Critical Strike — Fitness Check\",\n  content: `<p>Choose a ring for the Fitness check (TN 1):</p>${radioHtml}`,\n  buttons: {\n    roll: {\n      label: \"Roll check\",\n      callback: (html) => {\n        const ring = html.find('input[name=\"ringChoice\"]:checked').val();\n        actor.rollCheck(\"fitness\", ring, 1);\n      }\n    },\n    skip: {\n      label: \"Skip check\",\n      callback: () => { processCritical(baseSeverity); }\n    }\n  },\n  default: \"roll\"\n}).render(true);\n\nfunction processCritical(finalSeverity) {\n  if (finalSeverity <= 2) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Damage_an_item\")?.execute({ ctx: args.ctx });\n\n  } else if (finalSeverity <= 4) {\n    ctx.mutate(actor, { [\"flags.l5r5e.conditions.LightlyWounded\"]: true });\n    if (args.ctx.item?.system.qualities?.includes(\"Razor-Edged\")) {\n      game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    }\n\n  } else if (finalSeverity <= 6) {\n    ctx.mutate(actor, { [\"flags.l5r5e.conditions.SeverelyWounded\"]: true });\n    if (args.ctx.item?.system.qualities?.includes(\"Razor-Edged\")) {\n      game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    }\n\n  } else if (finalSeverity <= 8) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n\n  } else if (finalSeverity <= 11) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n\n  } else if (finalSeverity <= 13) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"SeverelyWounded\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Dying\" });\n\n  } else if (finalSeverity <= 15) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"SeverelyWounded\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Dying\" });\n\n  } else {\n    // Instant death case. No chat output.\n  }\n}", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resolve_critical_strike", "uuid": "Compendium.l5r5e.core-macros-base-effects.Resolve_critical_strike"}}}
