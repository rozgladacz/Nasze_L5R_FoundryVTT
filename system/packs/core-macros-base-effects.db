{"_id": "Damage_an_item", "name": "Damage an Item", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/bomb.svg", "scope": "global", "command": "(async () => {\n  const { item } = args?.[0] ?? {};\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (!item) {\n    fail(\"Damage an Item | Missing item argument.\");\n  }\n  if (!item.actor && !item.parent?.actor) {\n    fail(\"Damage an Item | Item must belong to an actor.\");\n  }\n\n  const updateData = {};\n  const setProp = (path, value) => foundry.utils.setProperty(updateData, path, value);\n\n  const systemData = item.system ?? {};\n  const durableNames = new Set([\"durable\"]);\n  const normalizeLabel = (value) => String(value ?? \"\").trim().toLowerCase();\n\n  const removeDurableFromArray = (arr) => {\n    const filtered = arr.filter((entry) => !durableNames.has(normalizeLabel(entry?.name ?? entry?.label ?? entry)));\n    return filtered.length === arr.length ? null : filtered;\n  };\n\n  const propertiesArrays = [\n    { path: \"system.item.properties\", value: systemData?.item?.properties },\n    { path: \"system.properties\", value: systemData?.properties },\n    { path: \"system.qualities\", value: Array.isArray(systemData?.qualities) ? systemData.qualities : null },\n  ];\n\n  let durableRemoved = false;\n  for (const { path, value } of propertiesArrays) {\n    if (!Array.isArray(value)) continue;\n    const filtered = removeDurableFromArray(value);\n    if (!filtered) continue;\n    setProp(path, filtered);\n    durableRemoved = true;\n  }\n\n  const qualitiesObject = systemData?.qualities;\n  if (qualitiesObject && typeof qualitiesObject === \"object\" && !Array.isArray(qualitiesObject)) {\n    const clone = foundry.utils.deepClone(qualitiesObject);\n    let changed = false;\n    if (clone.Durable) {\n      delete clone.Durable;\n      changed = true;\n    }\n    if (clone.durable) {\n      delete clone.durable;\n      changed = true;\n    }\n    if (changed) {\n      setProp(\"system.qualities\", clone);\n      durableRemoved = true;\n    }\n  }\n\n  const alreadyDamaged = Boolean(foundry.utils.getProperty(systemData, \"qualities.damaged\"));\n  const alreadyDestroyed = Boolean(foundry.utils.getProperty(systemData, \"qualities.destroyed\"));\n\n  let stateChanged = false;\n  let currentState = null;\n\n  if (!alreadyDamaged && !alreadyDestroyed) {\n    setProp(\"system.qualities.damaged\", true);\n    stateChanged = true;\n    currentState = \"damaged\";\n  } else if (alreadyDamaged && !alreadyDestroyed) {\n    setProp(\"system.qualities.destroyed\", true);\n    stateChanged = true;\n    currentState = \"destroyed\";\n  } else if (!alreadyDamaged && alreadyDestroyed) {\n    setProp(\"system.qualities.damaged\", true);\n    setProp(\"system.qualities.destroyed\", true);\n    stateChanged = true;\n    currentState = \"destroyed\";\n  } else {\n    currentState = \"destroyed\";\n  }\n\n  if (item.type === \"armor\") {\n    const physical = Number(systemData?.armor?.physical ?? 0);\n    const supernatural = Number(systemData?.armor?.supernatural ?? 0);\n    if (currentState === \"damaged\") {\n      const newPhysical = Math.max(0, physical - 2);\n      const newSupernatural = Math.max(0, supernatural - 2);\n      if (newPhysical !== physical) setProp(\"system.armor.physical\", newPhysical);\n      if (newSupernatural !== supernatural) setProp(\"system.armor.supernatural\", newSupernatural);\n    } else if (currentState === \"destroyed\") {\n      if (physical !== 0) setProp(\"system.armor.physical\", 0);\n      if (supernatural !== 0) setProp(\"system.armor.supernatural\", 0);\n    }\n  } else if (item.type === \"weapon\" && currentState === \"destroyed\") {\n    if (Number(systemData?.damage ?? 0) !== 0) setProp(\"system.damage\", 0);\n    if (Number(systemData?.deadliness ?? 0) !== 0) setProp(\"system.deadliness\", 0);\n  }\n\n  if (!durableRemoved && !stateChanged && Object.keys(updateData).length === 0) {\n    return;\n  }\n\n  await item.update(updateData);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Damage_an_item", "uuid": "Compendium.l5r5e.core-macros-base-effects.Damage_an_item"}}}
{"_id": "Add_Condition", "name": "Add Condition", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/aura.svg", "scope": "global", "command": "/**\n * Accepts args[0] = { actor, condition }.\n * condition should be a slug string (e.g. \"Bleeding\") or an object exposing\n * a `slug`, `id`, or `name` that matches the flags.l5r5e.conditions key. Compendium UUIDs are not resolved automatically; pass the slug or name directly.\n */\n(async () => {\n  const { actor, condition } = args?.[0] ?? {};\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (!actor) {\n    fail(\"Add Condition | Missing actor argument.\");\n  }\n  if (condition === undefined || condition === null || condition === \"\") {\n    fail(\"Add Condition | Missing condition argument.\");\n  }\n\n  const rawKey =\n    typeof condition === \"string\"\n      ? condition\n      : condition?.slug ?? condition?.id ?? condition?.name ?? \"\";\n  const key = String(rawKey ?? \"\").trim();\n  if (!key) {\n    fail(\"Add Condition | Unable to resolve condition identifier.\");\n  }\n\n  const path = `flags.l5r5e.conditions.${key}`;\n  if (Boolean(foundry.utils.getProperty(actor, path))) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, path, true);\n  await actor.update(updateData);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Add_Condition", "uuid": "Compendium.l5r5e.core-macros-base-effects.Add_Condition"}}}
{"_id": "Remove_Condition", "name": "Remove Condition", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/cancel.svg", "scope": "global", "command": "/**\n * Accepts args[0] = { actor, condition }.\n * condition should be a slug string (e.g. \"Bleeding\") or an object exposing\n * a `slug`, `id`, or `name` that matches the flags.l5r5e.conditions key. Compendium UUIDs are not resolved automatically; pass the slug or name directly.\n */\n(async () => {\n  const { actor, condition } = args?.[0] ?? {};\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (!actor) {\n    fail(\"Remove Condition | Missing actor argument.\");\n  }\n  if (condition === undefined || condition === null || condition === \"\") {\n    fail(\"Remove Condition | Missing condition argument.\");\n  }\n\n  const rawKey =\n    typeof condition === \"string\"\n      ? condition\n      : condition?.slug ?? condition?.id ?? condition?.name ?? \"\";\n  const key = String(rawKey ?? \"\").trim();\n  if (!key) {\n    fail(\"Remove Condition | Unable to resolve condition identifier.\");\n  }\n\n  const path = `flags.l5r5e.conditions.${key}`;\n  if (!Boolean(foundry.utils.getProperty(actor, path))) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, path, false);\n  await actor.update(updateData);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Remove_Condition", "uuid": "Compendium.l5r5e.core-macros-base-effects.Remove_Condition"}}}
{"_id": "Deal_Fatigue", "name": "Deal Fatigue", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/exhausted.webp", "scope": "global", "command": "(async () => {\n  const { actor, value } = args?.[0] ?? {};\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (!actor) {\n    fail(\"Deal Fatigue | Missing actor argument.\");\n  }\n\n  const amount = Number(value ?? 0);\n  if (!Number.isFinite(amount)) {\n    fail(\"Deal Fatigue | Value must be a number.\");\n  }\n  if (amount === 0) {\n    return;\n  }\n\n  const currentFatigue = Number(foundry.utils.getProperty(actor, \"system.fatigue.value\") ?? 0);\n  const newFatigue = Math.max(0, currentFatigue + amount);\n  if (newFatigue === currentFatigue) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, \"system.fatigue.value\", newFatigue);\n\n  const maxFatigue = Number(\n    foundry.utils.getProperty(actor, \"system.fatigue.max\") ??\n      foundry.utils.getProperty(actor, \"system.endurance\") ??\n      0\n  );\n  const shouldBeIncapacitated = maxFatigue > 0 && newFatigue >= maxFatigue;\n  const currentIncapacitated = Boolean(\n    foundry.utils.getProperty(actor, \"flags.l5r5e.conditions.Incapacitated\")\n  );\n  if (shouldBeIncapacitated !== currentIncapacitated) {\n    foundry.utils.setProperty(updateData, \"flags.l5r5e.conditions.Incapacitated\", shouldBeIncapacitated);\n  }\n\n  await actor.update(updateData);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_Fatigue", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue"}}}
{"_id": "Deal_Strife", "name": "Deal Strife", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/compromised.webp", "scope": "global", "command": "(async () => {\n  const { actor, value } = args?.[0] ?? {};\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (!actor) {\n    fail(\"Deal Strife | Missing actor argument.\");\n  }\n\n  const amount = Number(value ?? 0);\n  if (!Number.isFinite(amount)) {\n    fail(\"Deal Strife | Value must be a number.\");\n  }\n  if (amount === 0) {\n    return;\n  }\n\n  const currentStrife = Number(foundry.utils.getProperty(actor, \"system.strife.value\") ?? 0);\n  const newStrife = Math.max(0, currentStrife + amount);\n  if (newStrife === currentStrife) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, \"system.strife.value\", newStrife);\n\n  const maxStrife = Number(\n    foundry.utils.getProperty(actor, \"system.strife.max\") ??\n      foundry.utils.getProperty(actor, \"system.composure\") ??\n      0\n  );\n  const shouldBeCompromised = maxStrife > 0 && newStrife >= maxStrife;\n  const currentCompromised = Boolean(\n    foundry.utils.getProperty(actor, \"flags.l5r5e.conditions.Compromised\")\n  );\n  if (shouldBeCompromised !== currentCompromised) {\n    foundry.utils.setProperty(updateData, \"flags.l5r5e.conditions.Compromised\", shouldBeCompromised);\n  }\n\n  await actor.update(updateData);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_Strife", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_Strife"}}}
{"_id": "Deal_damage", "name": "Deal Damage", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/combat.svg", "scope": "global", "command": "(async () => {\n  const { actor, value, deadliness, weapon, defenseType } = args?.[0] ?? {};\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (!actor) {\n    fail(\"Deal Damage | Missing actor argument.\");\n  }\n\n  const initialAmount = Number(value ?? 0);\n  if (!Number.isFinite(initialAmount)) {\n    fail(\"Deal Damage | Value must be a number.\");\n  }\n\n  const normalizeDefenseType = (value) => {\n    if (typeof value !== \"string\") return \"physical\";\n    const normalized = value.trim().toLowerCase();\n    if ([\"physical\", \"phys\", \"fizyczna\"].includes(normalized)) return \"physical\";\n    if ([\"spiritual\", \"supernatural\", \"spirit\", \"magical\", \"duchowa\"].includes(normalized)) {\n      return \"spiritual\";\n    }\n    if ([\"none\", \"ignore\", \"penetrating\"].includes(normalized)) return \"none\";\n    return normalized || \"physical\";\n  };\n\n  const resolvedDefense = normalizeDefenseType(defenseType ?? weapon?.system?.damageType ?? \"physical\");\n\n  const getResistance = (actorDocument, type) => {\n    if (!actorDocument) return 0;\n    const paths = type === \"physical\"\n      ? [\n          \"system.physicalResistance\",\n          \"system.resistances.physical\",\n          \"system.resistance.physical\",\n          \"system.defenses.physical\",\n          \"system.conflict.resistances.physical\",\n        ]\n      : [\n          \"system.spiritualResistance\",\n          \"system.resistances.spiritual\",\n          \"system.resistances.supernatural\",\n          \"system.resistance.spiritual\",\n          \"system.defenses.spiritual\",\n          \"system.defenses.supernatural\",\n          \"system.conflict.resistances.spiritual\",\n          \"system.conflict.resistances.supernatural\",\n        ];\n    for (const path of paths) {\n      const value = foundry.utils.getProperty(actorDocument, path);\n      if (value === undefined || value === null) continue;\n      const numeric = Number(value);\n      if (Number.isFinite(numeric)) {\n        return numeric;\n      }\n    }\n    return 0;\n  };\n\n  let damage = initialAmount;\n  if (resolvedDefense === \"physical\") {\n    damage = Math.max(0, damage - getResistance(actor, \"physical\"));\n  } else if ([\"spiritual\", \"supernatural\"].includes(resolvedDefense)) {\n    damage = Math.max(0, damage - getResistance(actor, \"spiritual\"));\n  }\n\n  const hasQuality = (itemDocument, quality) => {\n    if (!itemDocument) return false;\n    const target = String(quality ?? \"\").trim().toLowerCase();\n    const arrays = [\n      itemDocument.system?.item?.properties,\n      itemDocument.system?.properties,\n      Array.isArray(itemDocument.system?.qualities) ? itemDocument.system.qualities : null,\n    ];\n    for (const list of arrays) {\n      if (!Array.isArray(list)) continue;\n      if (list.some((entry) => String(entry?.name ?? entry?.label ?? entry).trim().toLowerCase() === target)) {\n        return true;\n      }\n    }\n    const qualitiesObj = itemDocument.system?.qualities;\n    if (qualitiesObj && typeof qualitiesObj === \"object\" && !Array.isArray(qualitiesObj)) {\n      if (Object.entries(qualitiesObj).some(([key, val]) => String(key).trim().toLowerCase() === target && !!val)) {\n        return true;\n      }\n    }\n    return false;\n  };\n\n  if (damage <= 0) {\n    if (weapon && hasQuality(weapon, \"razor-edged\")) {\n      const macro = game.macros?.getName?.(\"Damage an Item\");\n      await macro?.execute?.([{ item: weapon }]);\n    }\n    return;\n  }\n\n  const incapacitated = Boolean(foundry.utils.getProperty(actor, \"flags.l5r5e.conditions.Incapacitated\"));\n  const severity = Number(deadliness ?? weapon?.system?.deadliness ?? 0) || 0;\n  if (incapacitated) {\n    const summary = severity\n      ? `${actor.name ?? \"The target\"} suffers a severity ${severity} critical strike.`\n      : `${actor.name ?? \"The target\"} suffers a critical strike.`;\n    ui.notifications?.warn?.(`Deal Damage | ${summary}`);\n    return;\n  }\n\n  const fatigueMacro = game.macros?.getName?.(\"Deal Fatigue\");\n  if (fatigueMacro) {\n    await fatigueMacro.execute([{ actor, value: damage }]);\n    return;\n  }\n\n  const currentFatigue = Number(foundry.utils.getProperty(actor, \"system.fatigue.value\") ?? 0);\n  const newFatigue = Math.max(0, currentFatigue + damage);\n  if (newFatigue === currentFatigue) {\n    return;\n  }\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, \"system.fatigue.value\", newFatigue);\n  await actor.update(updateData);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_damage", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_damage"}}}
{"_id": "Resolve_critical_strike", "name": "Resolve Critical Strike", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/skull.svg", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor) return;\n\nlet baseSeverity = Number(args.value) || 0;\nconst rings = [\"Air\", \"Earth\", \"Fire\", \"Water\", \"Void\"];\n\nlet radioHtml = rings\n  .map(r => `<label><input type='radio' name='ringChoice' value='${r}' ${r === \"Earth\" ? \"checked\" : \"\"}> ${game.i18n.localize('L5R5E.Ring' + r)}</label>`)\n  .join(\"<br>\");\n\nnew Dialog({\n  title: \"Critical Strike — Fitness Check\",\n  content: `<p>Choose a ring for the Fitness check (TN 1):</p>${radioHtml}`,\n  buttons: {\n    roll: {\n      label: \"Roll check\",\n      callback: (html) => {\n        const ring = html.find('input[name=\"ringChoice\"]:checked').val();\n        actor.rollCheck(\"fitness\", ring, 1);\n      }\n    },\n    skip: {\n      label: \"Skip check\",\n      callback: () => { processCritical(baseSeverity); }\n    }\n  },\n  default: \"roll\"\n}).render(true);\n\nfunction processCritical(finalSeverity) {\n  if (finalSeverity <= 2) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Damage_an_item\")?.execute({ ctx: args.ctx });\n\n  } else if (finalSeverity <= 4) {\n    ctx.mutate(actor, { [\"flags.l5r5e.conditions.LightlyWounded\"]: true });\n    if (args.ctx.item?.system.qualities?.includes(\"Razor-Edged\")) {\n      game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    }\n\n  } else if (finalSeverity <= 6) {\n    ctx.mutate(actor, { [\"flags.l5r5e.conditions.SeverelyWounded\"]: true });\n    if (args.ctx.item?.system.qualities?.includes(\"Razor-Edged\")) {\n      game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    }\n\n  } else if (finalSeverity <= 8) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n\n  } else if (finalSeverity <= 11) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n\n  } else if (finalSeverity <= 13) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"SeverelyWounded\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Dying\" });\n\n  } else if (finalSeverity <= 15) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"SeverelyWounded\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Dying\" });\n\n  } else {\n    // Instant death case. No chat output.\n  }\n}", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resolve_critical_strike", "uuid": "Compendium.l5r5e.core-macros-base-effects.Resolve_critical_strike"}}}
{"_id": "Example_Base_Effect", "name": "Example Base Effect", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "/**\n * Example effect demonstrating the simplified signature.\n *\n * Expected args[0] structure:\n * {\n *   actor?: Actor,\n *   parameters?: { damage?: number, useRazor?: boolean, defense_type?: string },\n *   parameterDefs?: MacroParameterDefinition[]\n * }\n */\n(() => {\n  const { actor, parameters = {}, parameterDefs = [] } = args?.[0] ?? {};\n  const findDefault = (name) => parameterDefs.find((def) => def?.name === name)?.defaultValue;\n\n  const rawDamage = parameters.damage ?? findDefault(\"damage\") ?? 0;\n  const useRazor = parameters.useRazor ?? findDefault(\"useRazor\") ?? false;\n  const defenseType = parameters.defense_type ?? findDefault(\"defense_type\") ?? \"physical\";\n  const numericDamage = Number(rawDamage) || 0;\n\n  if (console?.table) {\n    console.table(\n      parameterDefs.map((def) => ({\n        name: def.name,\n        label: def.label,\n        type: def.type,\n        defaultValue: def.defaultValue,\n      }))\n    );\n  }\n\n  const summary = [\n    `Actor: ${actor?.name ?? \"—\"}`,\n    `Damage: ${numericDamage}`,\n    `Use Razor-Edged: ${Boolean(useRazor)}`,\n    `Defense Type: ${defenseType}`,\n  ].join(\" | \");\n\n  ui.notifications?.info?.(`Example Base Effect → ${summary}`);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Base_Effect", "uuid": "Compendium.l5r5e.core-macros-base-effects.Example_Base_Effect"}}, "parameterDefs": [{"name": "damage", "label": "Damage", "type": "number", "description": "Example numeric parameter with default value.", "defaultValue": 3, "includeInTotal": true}, {"name": "useRazor", "label": "Use Razor-Edged", "type": "boolean", "description": "Example toggle parameter.", "defaultValue": false}, {"name": "defense_type", "label": "Defense Type", "type": "list", "description": "Example list parameter.", "defaultValue": "physical", "options": [{"value": "physical", "label": "Physical"}, {"value": "spiritual", "label": "Spiritual"}, {"value": "none", "label": "None"}]}]}
