{"_id": "Damage_an_item", "name": "Damage an Item", "type": "script", "img": "icons/svg/bomb.svg", "scope": "global", "command": "/**\n * Base effect — degrade an item.\n * scope: parameterMap.{ item } (an Item document).\n */\nreturn (async () => {\n  const { fail } = game.l5r5e.macros;\n  const item = parameterMap?.item ?? null;\n  if (!item) fail(\"Damage an Item | Missing item argument.\");\n  if (!item.actor && !item.parent?.actor) {\n    fail(\"Damage an Item | Item must belong to an actor.\");\n  }\n\n  const updateData = {};\n  const setProp = (path, value) => foundry.utils.setProperty(updateData, path, value);\n  const systemData = item.system ?? {};\n\n  const removeDurable = (arr) => {\n    const filtered = arr.filter((entry) => String(entry?.name ?? entry?.label ?? entry).trim().toLowerCase() !== \"durable\");\n    return filtered.length === arr.length ? null : filtered;\n  };\n\n  let durableRemoved = false;\n  for (const path of [\"system.item.properties\", \"system.properties\", \"system.qualities\"]) {\n    const value = foundry.utils.getProperty(item, path);\n    if (!Array.isArray(value)) continue;\n    const filtered = removeDurable(value);\n    if (filtered) { setProp(path, filtered); durableRemoved = true; }\n  }\n  const qualitiesObj = systemData?.qualities;\n  if (qualitiesObj && typeof qualitiesObj === \"object\" && !Array.isArray(qualitiesObj)) {\n    const clone = foundry.utils.deepClone(qualitiesObj);\n    let changed = false;\n    if (clone.Durable) { delete clone.Durable; changed = true; }\n    if (clone.durable) { delete clone.durable; changed = true; }\n    if (changed) { setProp(\"system.qualities\", clone); durableRemoved = true; }\n  }\n\n  const damaged = Boolean(foundry.utils.getProperty(systemData, \"qualities.damaged\"));\n  const destroyed = Boolean(foundry.utils.getProperty(systemData, \"qualities.destroyed\"));\n  let nextState = null;\n  if (!damaged && !destroyed) { setProp(\"system.qualities.damaged\", true); nextState = \"damaged\"; }\n  else if (damaged && !destroyed) { setProp(\"system.qualities.destroyed\", true); nextState = \"destroyed\"; }\n  else if (!damaged && destroyed) { setProp(\"system.qualities.damaged\", true); nextState = \"destroyed\"; }\n  else { nextState = \"destroyed\"; }\n\n  if (item.type === \"armor\") {\n    const physical = Number(systemData?.armor?.physical ?? 0);\n    const supernatural = Number(systemData?.armor?.supernatural ?? 0);\n    if (nextState === \"damaged\") {\n      if (physical) setProp(\"system.armor.physical\", Math.max(0, physical - 2));\n      if (supernatural) setProp(\"system.armor.supernatural\", Math.max(0, supernatural - 2));\n    } else if (nextState === \"destroyed\") {\n      if (physical) setProp(\"system.armor.physical\", 0);\n      if (supernatural) setProp(\"system.armor.supernatural\", 0);\n    }\n  } else if (item.type === \"weapon\" && nextState === \"destroyed\") {\n    if (Number(systemData?.damage ?? 0)) setProp(\"system.damage\", 0);\n    if (Number(systemData?.deadliness ?? 0)) setProp(\"system.deadliness\", 0);\n  }\n\n  if (!durableRemoved && Object.keys(updateData).length === 0) return;\n  await item.update(updateData);\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Damage_an_item", "uuid": "Compendium.l5r5e.core-macros-base-effects.Damage_an_item"}}}
{"_id": "Add_Condition", "name": "Add Condition", "type": "script", "img": "icons/svg/aura.svg", "scope": "global", "command": "/**\n * Base effect — add a condition flag to an actor.\n * scope: parameterMap.{ actor, condition }.\n */\nreturn (async () => {\n  const { fail, resolveActor } = game.l5r5e.macros;\n  const actor = await resolveActor(parameterMap, this ?? {});\n  if (!actor) fail(\"Add Condition | Missing actor argument.\");\n\n  const raw = parameterMap?.condition ?? parameterMap?.value ?? \"\";\n  const keyString = String(typeof raw === \"object\" ? (raw?.slug ?? raw?.id ?? raw?.name ?? \"\") : raw).trim();\n  if (!keyString) fail(\"Add Condition | Missing condition argument.\");\n\n  const slug = String(keyString)\n    .replace(/([a-z0-9])([A-Z])/g, \"$1_$2\")\n    .replace(/[^a-zA-Z0-9_]+/g, \"_\")\n    .replace(/_+/g, \"_\")\n    .replace(/^_+|_+$/g, \"\")\n    .toLowerCase();\n  if (!slug) fail(\"Add Condition | Unable to resolve condition identifier.\");\n\n  const has = (k) => Boolean(foundry.utils.getProperty(actor, `flags.l5r5e.conditions.${k}`));\n\n  const woundMatch = slug.match(/^(lightly|severely)_wounded_(air|earth|fire|water|void)$/);\n  if (woundMatch) {\n    const [, severity, ring] = woundMatch;\n    const lightKey = `lightly_wounded_${ring}`;\n    const heavyKey = `severely_wounded_${ring}`;\n    if (has(heavyKey)) {\n      const permanent = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Permanent_injury\");\n      if (!permanent) fail(\"Add Condition | Unable to locate Permanent injury macro.\");\n      await permanent.execute({ parameterMap: { actor, isMajor: false } });\n      return;\n    }\n    if (has(lightKey)) {\n      const updateData = {};\n      foundry.utils.setProperty(updateData, `flags.l5r5e.conditions.${lightKey}`, false);\n      foundry.utils.setProperty(updateData, `flags.l5r5e.conditions.${heavyKey}`, true);\n      await actor.update(updateData);\n      return;\n    }\n    const targetKey = severity === \"lightly\" ? lightKey : heavyKey;\n    if (has(targetKey)) return;\n    const updateData = {};\n    foundry.utils.setProperty(updateData, `flags.l5r5e.conditions.${targetKey}`, true);\n    await actor.update(updateData);\n    return;\n  }\n\n  const slugPath = `flags.l5r5e.conditions.${slug}`;\n  const altPath = slug === keyString ? null : `flags.l5r5e.conditions.${keyString}`;\n  if (has(slug) || (altPath && Boolean(foundry.utils.getProperty(actor, altPath)))) return;\n  const updateData = {};\n  foundry.utils.setProperty(updateData, slugPath, true);\n  if (altPath) foundry.utils.setProperty(updateData, altPath, true);\n  await actor.update(updateData);\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Add_Condition", "uuid": "Compendium.l5r5e.core-macros-base-effects.Add_Condition"}}}
{"_id": "Remove_Condition", "name": "Remove Condition", "type": "script", "img": "icons/svg/cancel.svg", "scope": "global", "command": "/**\n * Base effect — clear a condition flag.\n * scope: parameterMap.{ actor, condition }.\n */\nreturn (async () => {\n  const { fail, resolveActor } = game.l5r5e.macros;\n  const actor = await resolveActor(parameterMap, this ?? {});\n  if (!actor) fail(\"Remove Condition | Missing actor argument.\");\n\n  const raw = parameterMap?.condition ?? \"\";\n  const key = String(typeof raw === \"object\" ? (raw?.slug ?? raw?.id ?? raw?.name ?? \"\") : raw).trim();\n  if (!key) fail(\"Remove Condition | Missing condition argument.\");\n\n  const path = `flags.l5r5e.conditions.${key}`;\n  if (!Boolean(foundry.utils.getProperty(actor, path))) return;\n  const updateData = {};\n  foundry.utils.setProperty(updateData, path, false);\n  await actor.update(updateData);\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Remove_Condition", "uuid": "Compendium.l5r5e.core-macros-base-effects.Remove_Condition"}}}
{"_id": "Deal_Fatigue", "name": "Deal Fatigue", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/exhausted.webp", "scope": "global", "command": "/**\n * Base effect — add fatigue to an actor.\n * scope: parameterMap.{ actor, value }.\n */\nreturn (async () => {\n  const { fail, coerceNumber, resolveActor } = game.l5r5e.macros;\n  const actor = await resolveActor(parameterMap);\n  if (!actor) fail(\"Deal Fatigue | Missing actor argument.\");\n  const amount = coerceNumber(parameterMap?.value, 0);\n  if (amount === 0) return;\n\n  const current = coerceNumber(foundry.utils.getProperty(actor, \"system.fatigue.value\"), 0);\n  const next = Math.max(0, current + amount);\n  if (next === current) return;\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, \"system.fatigue.value\", next);\n  const max = coerceNumber(\n    foundry.utils.getProperty(actor, \"system.fatigue.max\") ??\n    foundry.utils.getProperty(actor, \"system.endurance\"),\n    0\n  );\n  const shouldIncapacitate = max > 0 && next >= max;\n  const isIncapacitated = Boolean(foundry.utils.getProperty(actor, \"flags.l5r5e.conditions.Incapacitated\"));\n  if (shouldIncapacitate !== isIncapacitated) {\n    foundry.utils.setProperty(updateData, \"flags.l5r5e.conditions.Incapacitated\", shouldIncapacitate);\n  }\n  await actor.update(updateData);\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_Fatigue", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue"}}}
{"_id": "Deal_Strife", "name": "Deal Strife", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/compromised.webp", "scope": "global", "command": "/**\n * Base effect — add strife to an actor.\n * scope: parameterMap.{ actor, value }.\n */\nreturn (async () => {\n  const { fail, coerceNumber, resolveActor } = game.l5r5e.macros;\n  const actor = await resolveActor(parameterMap);\n  if (!actor) fail(\"Deal Strife | Missing actor argument.\");\n  const amount = coerceNumber(parameterMap?.value, 0);\n  if (amount === 0) return;\n\n  const current = coerceNumber(foundry.utils.getProperty(actor, \"system.strife.value\"), 0);\n  const next = Math.max(0, current + amount);\n  if (next === current) return;\n\n  const updateData = {};\n  foundry.utils.setProperty(updateData, \"system.strife.value\", next);\n  const max = coerceNumber(\n    foundry.utils.getProperty(actor, \"system.strife.max\") ??\n    foundry.utils.getProperty(actor, \"system.composure\"),\n    0\n  );\n  const shouldCompromise = max > 0 && next >= max;\n  const isCompromised = Boolean(foundry.utils.getProperty(actor, \"flags.l5r5e.conditions.Compromised\"));\n  if (shouldCompromise !== isCompromised) {\n    foundry.utils.setProperty(updateData, \"flags.l5r5e.conditions.Compromised\", shouldCompromise);\n  }\n  await actor.update(updateData);\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_Strife", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_Strife"}}}
{"_id": "Deal_damage", "name": "Deal Damage", "type": "script", "img": "icons/svg/combat.svg", "scope": "global", "command": "/**\n * Base effect — apply incoming damage to an actor.\n * scope: parameterMap.{ actor, value, deadliness?, weapon?, defenseType? }.\n */\nreturn (async () => {\n  const { fail, coerceNumber, resolveActor } = game.l5r5e.macros;\n  const actor = await resolveActor(parameterMap);\n  if (!actor) fail(\"Deal Damage | Missing actor argument.\");\n  const initial = coerceNumber(parameterMap?.value, 0);\n  const weapon = parameterMap?.weapon ?? null;\n  const defenseType = parameterMap?.defenseType ?? weapon?.system?.damageType ?? \"physical\";\n\n  const normDef = (() => {\n    const n = String(defenseType).trim().toLowerCase();\n    if ([\"physical\",\"phys\",\"fizyczna\"].includes(n)) return \"physical\";\n    if ([\"spiritual\",\"supernatural\",\"spirit\",\"magical\",\"duchowa\"].includes(n)) return \"spiritual\";\n    if ([\"none\",\"ignore\",\"penetrating\"].includes(n)) return \"none\";\n    return n || \"physical\";\n  })();\n\n  const getResistance = (type) => {\n    const paths = type === \"physical\"\n      ? [\"system.physicalResistance\",\"system.resistances.physical\",\"system.resistance.physical\",\"system.defenses.physical\",\"system.conflict.resistances.physical\"]\n      : [\"system.spiritualResistance\",\"system.resistances.spiritual\",\"system.resistances.supernatural\",\"system.resistance.spiritual\",\"system.defenses.spiritual\",\"system.defenses.supernatural\",\"system.conflict.resistances.spiritual\",\"system.conflict.resistances.supernatural\"];\n    for (const p of paths) {\n      const v = foundry.utils.getProperty(actor, p);\n      if (v === undefined || v === null) continue;\n      const n = Number(v);\n      if (Number.isFinite(n)) return n;\n    }\n    return 0;\n  };\n\n  let damage = initial;\n  if (normDef === \"physical\") damage = Math.max(0, damage - getResistance(\"physical\"));\n  else if ([\"spiritual\",\"supernatural\"].includes(normDef)) damage = Math.max(0, damage - getResistance(\"spiritual\"));\n\n  const hasQuality = (item, quality) => {\n    if (!item) return false;\n    const target = String(quality).trim().toLowerCase();\n    for (const list of [item.system?.item?.properties, item.system?.properties, Array.isArray(item.system?.qualities) ? item.system.qualities : null]) {\n      if (Array.isArray(list) && list.some((e) => String(e?.name ?? e?.label ?? e).trim().toLowerCase() === target)) return true;\n    }\n    const obj = item.system?.qualities;\n    if (obj && typeof obj === \"object\" && !Array.isArray(obj)) {\n      if (Object.entries(obj).some(([k, v]) => String(k).trim().toLowerCase() === target && !!v)) return true;\n    }\n    return false;\n  };\n\n  if (damage <= 0) {\n    if (weapon && hasQuality(weapon, \"razor-edged\")) {\n      const dmgItem = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Damage_an_item\");\n      if (dmgItem) await dmgItem.execute({ parameterMap: { item: weapon } });\n    }\n    return;\n  }\n\n  const incapacitated = Boolean(foundry.utils.getProperty(actor, \"flags.l5r5e.conditions.Incapacitated\"));\n  const severity = coerceNumber(parameterMap?.deadliness ?? weapon?.system?.deadliness, 0);\n  if (incapacitated) {\n    const summary = severity\n      ? `${actor.name ?? \"The target\"} suffers a severity ${severity} critical strike.`\n      : `${actor.name ?? \"The target\"} suffers a critical strike.`;\n    ui.notifications?.warn?.(`Deal Damage | ${summary}`);\n    return;\n  }\n\n  const fatigueMacro = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue\");\n  if (fatigueMacro) {\n    await fatigueMacro.execute({ parameterMap: { actor, value: damage } });\n    return;\n  }\n  const currentFatigue = coerceNumber(foundry.utils.getProperty(actor, \"system.fatigue.value\"), 0);\n  await actor.update({ \"system.fatigue.value\": Math.max(0, currentFatigue + damage) });\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Deal_damage", "uuid": "Compendium.l5r5e.core-macros-base-effects.Deal_damage"}}}
{"_id": "Resolve_critical_strike", "name": "Resolve Critical Strike", "type": "script", "img": "icons/svg/skull.svg", "scope": "global", "command": "let actor = args.ctx.target;\nif (!actor) return;\n\nlet baseSeverity = Number(args.value) || 0;\nconst rings = [\"Air\", \"Earth\", \"Fire\", \"Water\", \"Void\"];\n\nlet radioHtml = rings\n  .map(r => `<label><input type='radio' name='ringChoice' value='${r}' ${r === \"Earth\" ? \"checked\" : \"\"}> ${game.i18n.localize('L5R5E.Ring' + r)}</label>`)\n  .join(\"<br>\");\n\nnew Dialog({\n  title: \"Critical Strike — Fitness Check\",\n  content: `<p>Choose a ring for the Fitness check (TN 1):</p>${radioHtml}`,\n  buttons: {\n    roll: {\n      label: \"Roll check\",\n      callback: (html) => {\n        const ring = html.find('input[name=\"ringChoice\"]:checked').val();\n        actor.rollCheck(\"fitness\", ring, 1);\n      }\n    },\n    skip: {\n      label: \"Skip check\",\n      callback: () => { processCritical(baseSeverity); }\n    }\n  },\n  default: \"roll\"\n}).render(true);\n\nfunction processCritical(finalSeverity) {\n  if (finalSeverity <= 2) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Damage_an_item\")?.execute({ ctx: args.ctx });\n\n  } else if (finalSeverity <= 4) {\n    ctx.mutate(actor, { [\"flags.l5r5e.conditions.LightlyWounded\"]: true });\n    if (args.ctx.item?.system.qualities?.includes(\"Razor-Edged\")) {\n      game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    }\n\n  } else if (finalSeverity <= 6) {\n    ctx.mutate(actor, { [\"flags.l5r5e.conditions.SeverelyWounded\"]: true });\n    if (args.ctx.item?.system.qualities?.includes(\"Razor-Edged\")) {\n      game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    }\n\n  } else if (finalSeverity <= 8) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n\n  } else if (finalSeverity <= 11) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n\n  } else if (finalSeverity <= 13) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"SeverelyWounded\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Dying\" });\n\n  } else if (finalSeverity <= 15) {\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"SeverelyWounded\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Bleeding\" });\n    game.macros.find(m => m.flags.l5r5e?.effectKey === \"Add_Condition\")?.execute({ ctx: args.ctx, value: \"Dying\" });\n\n  } else {\n    // Instant death case. No chat output.\n  }\n}", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resolve_critical_strike", "uuid": "Compendium.l5r5e.core-macros-base-effects.Resolve_critical_strike"}}}
{"_id": "Example_Base_Effect", "name": "Example Base Effect", "type": "script", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "/**\n * Example base effect — illustrates the simplified scope contract.\n * scope: parameterMap.{ actor?, damage?, useRazor?, defense_type? }.\n */\nreturn (async () => {\n  const { coerceBoolean, coerceNumber } = game.l5r5e.macros;\n  const actor = parameterMap?.actor ?? null;\n  const damage = coerceNumber(parameterMap?.damage, 0);\n  const useRazor = coerceBoolean(parameterMap?.useRazor);\n  const defenseType = parameterMap?.defense_type ?? \"physical\";\n\n  ui.notifications?.info?.(\n    `Example Base Effect | Actor: ${actor?.name ?? \"—\"} | Damage: ${damage} | Razor: ${useRazor} | Defense: ${defenseType}`\n  );\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Base_Effect", "uuid": "Compendium.l5r5e.core-macros-base-effects.Example_Base_Effect"}}, "parameterDefs": [{"name": "damage", "label": "Damage", "type": "number", "description": "Example numeric parameter with default value.", "defaultValue": 3}, {"name": "useRazor", "label": "Use Razor-Edged", "type": "boolean", "description": "Example toggle parameter.", "defaultValue": false}, {"name": "defense_type", "label": "Defense Type", "type": "list", "description": "Example list parameter.", "defaultValue": "physical", "options": [{"value": "physical", "label": "Physical"}, {"value": "spiritual", "label": "Spiritual"}, {"value": "none", "label": "None"}]}]}
{"_id": "Permanent_injury", "name": "Permanent injury", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/heavily_wounded_void.webp", "scope": "global", "command": "/**\n * Base effect — announce a permanent injury for an actor.\n * scope: parameterMap.{ actor, isMajor? }.\n */\nreturn (async () => {\n  const { fail, coerceBoolean, resolveActor } = game.l5r5e.macros;\n  const actor = await resolveActor(parameterMap, this ?? {});\n  if (!actor) fail(\"Permanent injury | Missing actor argument.\");\n  const isMajor = coerceBoolean(parameterMap?.isMajor ?? parameterMap?.major ?? parameterMap?.severity);\n  const severity = isMajor ? \"major\" : \"minor\";\n  await ChatMessage.create({\n    speaker: { actor: actor.id, alias: actor.name },\n    content: `${actor.name} receives (${severity}) permanent injury!`,\n  });\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Permanent_injury", "uuid": "Compendium.l5r5e.core-macros-base-effects.Permanent_injury"}}}
