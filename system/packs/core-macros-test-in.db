{"_id": "Resist_Critical_in", "name": "Resist Critical (input)", "type": "script", "img": "icons/svg/skull.svg", "scope": "global", "command": "return (async () => {\n  const [params = {}, state = {}, context = {}] = args ?? [];\n  const roll = context?.roll ?? null;\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  const actor = params.actor ?? null;\n  const actorUuid = params.actorUuid ?? actor?.uuid ?? null;\n  if (!actor && !actorUuid) {\n    fail(\"Resist Critical (input) | Missing actor or actorUuid parameter.\");\n  }\n\n  const baseSeverity = Math.max(0, Number(params.severity ?? 0));\n  const isRazor = Boolean(params.isRazor);\n\n  const summary = roll?.l5r5e?.summary ?? {};\n  const totalSuccess = Number(summary?.totalSuccess ?? 0);\n  const totalBonus = Math.max(0, Number(summary?.totalBonus ?? 0));\n  const difficulty = Math.max(1, Number(roll?.l5r5e?.difficulty ?? 1));\n\n  const severityWithRazor = baseSeverity + (isRazor ? 1 : 0);\n  const succeeded = totalSuccess >= difficulty;\n  const effectiveBonus = succeeded ? totalBonus : 0;\n  const finalSeverity = succeeded\n    ? Math.max(0, severityWithRazor - 1 - effectiveBonus)\n    : severityWithRazor;\n\n  const sharedParams = {\n    actor,\n    actorUuid,\n    baseSeverity,\n    severityWithRazor,\n    finalSeverity,\n    totalSuccess,\n    totalBonus,\n    effectiveBonus,\n    difficulty,\n    succeeded,\n    isRazor,\n  };\n\n  const entries = [];\n  let order = 0;\n\n  const pushEntry = (key, { description, priority, finalMacro, parameters = [], extraParams = {}, details = null }) => {\n    entries.push({\n      key: `resistCritical.${key}`,\n      description,\n      priority,\n      finalMacro,\n      parameters,\n      params: { ...sharedParams, ...extraParams },\n      order: order++,\n      details,\n    });\n  };\n\n  if (finalSeverity <= 0) {\n    pushEntry(\"closeCall\", {\n      description:\n        game.i18n?.localize?.(\"l5r5e.macros.resistCritical.closeCall\") ?? \"Close Call – damage armor instead.\",\n      priority: 150,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Close_Call\",\n      parameters: [\n        {\n          name: \"applyEffect\",\n          label: \"Apply armor damage\",\n          type: \"boolean\",\n          defaultValue: true,\n        },\n        {\n          name: \"itemUuid\",\n          label: \"Armor item UUID\",\n          type: \"string\",\n          defaultValue: \"\",\n          placeholder: \"Provide the targeted armor or weapon UUID\",\n        },\n      ],\n    });\n  } else {\n    pushEntry(\"bleeding\", {\n      description:\n        game.i18n?.localize?.(\"l5r5e.macros.resistCritical.bleeding\") ?? \"Suffer the Bleeding condition.\",\n      priority: 200,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Bleeding\",\n      parameters: [\n        {\n          name: \"applyBleeding\",\n          label: \"Apply Bleeding\",\n          type: \"boolean\",\n          defaultValue: true,\n        },\n      ],\n    });\n\n    if (finalSeverity === 2) {\n      pushEntry(\"lightWound\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.lightWound\") ?? \"Suffer a Lightly Wounded condition.\",\n        priority: 225,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Light_Wound\",\n        parameters: [\n          {\n            name: \"applyLightWound\",\n            label: \"Apply Lightly Wounded\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n        ],\n      });\n    } else if (finalSeverity >= 3) {\n      pushEntry(\"heavyWound\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.heavyWound\") ?? \"Suffer a Severely Wounded condition.\",\n        priority: 250,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Heavy_Wound\",\n        parameters: [\n          {\n            name: \"applyHeavyWound\",\n            label: \"Apply Severely Wounded\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n        ],\n      });\n    }\n\n    if (finalSeverity === 4) {\n      pushEntry(\"dying3\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying3\") ?? \"Gain Dying (3 rounds).\",\n        priority: 295,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying3\",\n        parameters: [\n          {\n            name: \"applyDying\",\n            label: \"Apply Dying\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n          {\n            name: \"rounds\",\n            label: \"Rounds remaining\",\n            type: \"number\",\n            min: 1,\n            defaultValue: 3,\n          },\n        ],\n      });\n    } else if (finalSeverity === 5) {\n      pushEntry(\"dying1\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying1\") ?? \"Gain Dying (1 round).\",\n        priority: 300,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1\",\n        parameters: [\n          {\n            name: \"applyDying\",\n            label: \"Apply Dying\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n          {\n            name: \"rounds\",\n            label: \"Rounds remaining\",\n            type: \"number\",\n            min: 0,\n            defaultValue: 1,\n          },\n        ],\n      });\n    } else if (finalSeverity >= 6) {\n      pushEntry(\"dying1\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying1\") ?? \"Gain Dying (1 round).\",\n        priority: 300,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1\",\n        parameters: [\n          {\n            name: \"applyDying\",\n            label: \"Apply Dying\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n          {\n            name: \"rounds\",\n            label: \"Rounds remaining\",\n            type: \"number\",\n            min: 0,\n            defaultValue: 1,\n          },\n        ],\n        extraParams: { overrideRounds: Math.max(1, finalSeverity - 4) },\n      });\n\n      pushEntry(\"instantDeath\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.instantDeath\") ?? \"Suffer instant death.\",\n        priority: 350,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Instant_Death\",\n        parameters: [\n          {\n            name: \"confirm\",\n            label: \"Confirm instant death\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n        ],\n      });\n    }\n  }\n\n  return entries;\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_in", "uuid": "Compendium.l5r5e.core-macros-test-in.Resist_Critical_in"}}}
{"_id": "Example_Test_In", "name": "Example Test (Input)", "type": "script", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "return (async () => {\n  const [params = {}, context = {}] = args ?? [];\n  const roll = this?.roll ?? context?.roll ?? null;\n  return [\n    {\n      key: \"example.test\",\n      description: \"Example effect entry\",\n      priority: 100,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Example_Test_Out\",\n      parameters: [\n        {\n          name: \"note\",\n          label: \"Note to echo\",\n          type: \"string\",\n          defaultValue: params?.note ?? \"\",\n        },\n      ],\n      params: { actor: params?.actor ?? null },\n    },\n  ];\n})();", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test_In", "uuid": "Compendium.l5r5e.core-macros-test-in.Example_Test_In"}}}
{"_id": "hit_on_succes", "name": "hit_on_succes", "type": "script", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "/**\n * Expected arguments: [params = {}, context = {}]\n * params may include actor, target, weapon, and their UUID references.\n * context may include roll metadata (effectIndex, effect order, roll summary).\n * Generated parameter entries expose individual numeric values for downstream macros.\n */\nreturn (async () => {\n  const [params = {}, state = {}, context = {}] = args ?? [];\n  const roll = context?.roll ?? null;\n\n  const resolveItemDocument = async (candidate) => {\n    if (!candidate) return null;\n    if (candidate instanceof Item) return candidate;\n    if (typeof candidate === \"string\") {\n      try {\n        const doc = await fromUuid(candidate);\n        if (doc instanceof Item) return doc;\n      } catch (error) {\n        console.warn(\"hit_on_succes | Failed to resolve item UUID\", candidate, error);\n      }\n    }\n    if (candidate?.item instanceof Item) return candidate.item;\n    return null;\n  };\n\n  const resolveActorDocument = async (candidate) => {\n    if (!candidate) return null;\n    if (candidate instanceof Actor) return candidate;\n    if (candidate instanceof TokenDocument) return candidate.actor ?? null;\n    if (candidate.actor instanceof Actor) return candidate.actor;\n    if (typeof candidate === \"string\") {\n      try {\n        const doc = await fromUuid(candidate);\n        if (doc instanceof Actor) return doc;\n        if (doc instanceof TokenDocument) return doc.actor ?? null;\n        if (doc?.actor instanceof Actor) return doc.actor;\n      } catch (error) {\n        console.warn(\"hit_on_succes | Failed to resolve actor UUID\", candidate, error);\n      }\n    }\n    return null;\n  };\n\n  const summary = roll?.l5r5e?.summary ?? {};\n  const difficulty = Number(roll?.l5r5e?.difficulty ?? 0) || 0;\n  const totalSuccess = Number(summary?.totalSuccess ?? 0) || 0;\n  const bonusSuccesses = Math.max(0, totalSuccess - difficulty);\n  const isSuccess = totalSuccess >= difficulty && difficulty > 0 ? true : totalSuccess >= difficulty;\n\n  const effectIndex = Number.isFinite(context?.effectIndex) ? Number(context.effectIndex) : 0;\n  const effectOrder = Number.isFinite(context?.effect?.order) ? Number(context.effect.order) : effectIndex;\n  const keyBase = typeof context?.effect?.key === \"string\" && context.effect.key.length > 0\n    ? context.effect.key\n    : `strike.hit.${effectIndex}`;\n\n  const weapon = (await resolveItemDocument(params.weapon ?? params.weaponUuid ?? null)) ?? params.weapon ?? null;\n  const targetActor =\n    (await resolveActorDocument(params.targetActor ?? params.target ?? params.targetActorUuid ?? params.targetUuid ?? null)) ??\n    null;\n\n  const extractNumber = (item, paths, fallback = 0) => {\n    for (const path of paths) {\n      const value = foundry.utils.getProperty(item, path);\n      const numeric = Number(value ?? 0);\n      if (Number.isFinite(numeric)) {\n        return numeric;\n      }\n    }\n    return fallback;\n  };\n\n  const baseDamage = weapon ? extractNumber(weapon, [\n    \"system.damage\",\n    \"system.damage.value\",\n    \"system.item.damage\",\n    \"system.item.damage.value\",\n    \"data.damage\",\n    \"data.data.damage\",\n  ]) : 0;\n\n  const baseDeadliness = weapon ? extractNumber(weapon, [\n    \"system.deadliness\",\n    \"system.deadliness.value\",\n    \"system.item.deadliness\",\n    \"system.item.deadliness.value\",\n    \"data.deadliness\",\n    \"data.data.deadliness\",\n  ]) : 0;\n\n  const description = `Strike: + ${weapon?.name ?? game.i18n?.localize?.(\"l5r5e.macros.strike.weapon\") ?? \"Weapon\"}`;\n\n  const entry = {\n    effectIndex,\n    order: effectOrder,\n    key: keyBase,\n    description,\n    priority: 100,\n    finalMacro: \"Compendium.l5r5e.core-macros-test-out.damage_to\",\n    params: {\n      actor: targetActor,\n      actorUuid: targetActor?.uuid ?? null,\n      target: params.target ?? null,\n      targetUuid: params.targetUuid ?? null,\n      targetActor,\n      targetActorUuid: targetActor?.uuid ?? params.targetActorUuid ?? null,\n      weapon,\n      weaponUuid: weapon?.uuid ?? params.weaponUuid ?? null,\n      sourceActor: params.actor ?? null,\n      sourceActorUuid: params.actorUuid ?? null,\n    },\n    parameters: [\n      {\n        name: \"damage\",\n        label: game.i18n?.localize?.(\"l5r5e.macros.strike.damage\") ?? \"Damage\",\n        type: \"number\",\n        defaultValue: baseDamage + bonusSuccesses,\n        min: 0,\n      },\n      {\n        name: \"deadliness\",\n        label: game.i18n?.localize?.(\"l5r5e.macros.strike.deadliness\") ?? \"Deadliness\",\n        type: \"number\",\n        defaultValue: baseDeadliness,\n        min: 0,\n      },\n    ],\n  };\n\n  if (!isSuccess) {\n    entry.status = \"inactive\";\n  }\n\n  return [entry];\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "hit_on_succes", "uuid": "Compendium.l5r5e.core-macros-test-in.hit_on_succes"}}}
