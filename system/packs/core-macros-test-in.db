{"_id": "Resist_Critical_in", "name": "Resist Critical (input)", "type": "script", "img": "icons/svg/skull.svg", "scope": "global", "command": "return (async () => {\n  const { fail, coerceNumber, coerceBoolean, resolveActor } = game.l5r5e.macros;\n  const actor = await resolveActor(parameterMap);\n  if (!actor) {\n    fail(\"Resist Critical (input) | Missing actor or actorUuid parameter.\");\n  }\n\n  const baseSeverity = Math.max(0, coerceNumber(parameterMap.severity, 0));\n  const isRazor = coerceBoolean(parameterMap.isRazor);\n\n  const summary = roll?.l5r5e?.summary ?? {};\n  const totalSuccess = coerceNumber(summary.totalSuccess, 0);\n  const totalBonus = Math.max(0, coerceNumber(summary.totalBonus, 0));\n  const difficulty = Math.max(1, coerceNumber(roll?.l5r5e?.difficulty, 1));\n\n  const severityWithRazor = baseSeverity + (isRazor ? 1 : 0);\n  const succeeded = totalSuccess >= difficulty;\n  const effectiveBonus = succeeded ? totalBonus : 0;\n  const finalSeverity = succeeded\n    ? Math.max(0, severityWithRazor - 1 - effectiveBonus)\n    : severityWithRazor;\n\n  const sharedParams = {\n    actorUuid: actor.uuid ?? parameterMap.actorUuid ?? null,\n    baseSeverity,\n    severityWithRazor,\n    finalSeverity,\n    totalSuccess,\n    totalBonus,\n    effectiveBonus,\n    difficulty,\n    succeeded,\n    isRazor,\n  };\n\n  const entries = [];\n  let order = 0;\n  const push = (key, body) => entries.push({\n    key: `resistCritical.${key}`,\n    order: order++,\n    params: { ...sharedParams, ...(body.extraParams ?? {}) },\n    description: body.description,\n    priority: body.priority,\n    finalMacro: body.finalMacro,\n    parameters: body.parameters ?? [],\n    details: body.details ?? null,\n  });\n\n  if (finalSeverity <= 0) {\n    push(\"closeCall\", {\n      description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.closeCall\") ?? \"Close Call - damage armor instead.\",\n      priority: 150,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Close_Call\",\n      parameters: [\n        { name: \"applyEffect\", label: \"Apply armor damage\", type: \"boolean\", defaultValue: true },\n        { name: \"itemUuid\", label: \"Armor item UUID\", type: \"string\", defaultValue: \"\", placeholder: \"Armor or weapon UUID\" },\n      ],\n    });\n  } else {\n    push(\"bleeding\", {\n      description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.bleeding\") ?? \"Suffer the Bleeding condition.\",\n      priority: 200,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Bleeding\",\n      parameters: [{ name: \"applyBleeding\", label: \"Apply Bleeding\", type: \"boolean\", defaultValue: true }],\n    });\n\n    if (finalSeverity === 2) {\n      push(\"lightWound\", {\n        description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.lightWound\") ?? \"Suffer a Lightly Wounded condition.\",\n        priority: 225,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Light_Wound\",\n        parameters: [{ name: \"applyLightWound\", label: \"Apply Lightly Wounded\", type: \"boolean\", defaultValue: true }],\n      });\n    } else if (finalSeverity >= 3) {\n      push(\"heavyWound\", {\n        description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.heavyWound\") ?? \"Suffer a Severely Wounded condition.\",\n        priority: 250,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Heavy_Wound\",\n        parameters: [{ name: \"applyHeavyWound\", label: \"Apply Severely Wounded\", type: \"boolean\", defaultValue: true }],\n      });\n    }\n\n    if (finalSeverity === 4) {\n      push(\"dying3\", {\n        description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying3\") ?? \"Gain Dying (3 rounds).\",\n        priority: 295,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying3\",\n        parameters: [\n          { name: \"applyDying\", label: \"Apply Dying\", type: \"boolean\", defaultValue: true },\n          { name: \"rounds\", label: \"Rounds remaining\", type: \"number\", min: 1, defaultValue: 3 },\n        ],\n      });\n    } else if (finalSeverity === 5) {\n      push(\"dying1\", {\n        description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying1\") ?? \"Gain Dying (1 round).\",\n        priority: 300,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1\",\n        parameters: [\n          { name: \"applyDying\", label: \"Apply Dying\", type: \"boolean\", defaultValue: true },\n          { name: \"rounds\", label: \"Rounds remaining\", type: \"number\", min: 0, defaultValue: 1 },\n        ],\n      });\n    } else if (finalSeverity >= 6) {\n      push(\"dying1\", {\n        description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying1\") ?? \"Gain Dying (1 round).\",\n        priority: 300,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1\",\n        parameters: [\n          { name: \"applyDying\", label: \"Apply Dying\", type: \"boolean\", defaultValue: true },\n          { name: \"rounds\", label: \"Rounds remaining\", type: \"number\", min: 0, defaultValue: Math.max(1, finalSeverity - 4) },\n        ],\n      });\n      push(\"instantDeath\", {\n        description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.instantDeath\") ?? \"Suffer instant death.\",\n        priority: 350,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Instant_Death\",\n        parameters: [{ name: \"confirm\", label: \"Confirm instant death\", type: \"boolean\", defaultValue: true }],\n      });\n    }\n  }\n\n  return entries;\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_in", "uuid": "Compendium.l5r5e.core-macros-test-in.Resist_Critical_in"}}}
{"_id": "Example_Test_In", "name": "Example Test (Input)", "type": "script", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "return (async () => {\n  return [\n    {\n      key: \"example.test\",\n      description: \"Example effect entry\",\n      priority: 100,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Example_Test_Out\",\n      parameters: [\n        { name: \"note\", label: \"Note to echo\", type: \"string\", defaultValue: parameterMap?.note ?? \"\" },\n      ],\n      params: { actorUuid: parameterMap?.actorUuid ?? null },\n    },\n  ];\n})();\n", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test_In", "uuid": "Compendium.l5r5e.core-macros-test-in.Example_Test_In"}}}
{"_id": "hit_on_succes", "name": "hit_on_succes", "type": "script", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "/**\n * Input macro: builds a \"Strike hit\" effect entry from a successful Roll & Keep.\n * Reads weapon damage/deadliness from parameterMap.weapon, exposes them as\n * editable parameters, and forwards the target via params for the output macro.\n */\nreturn (async () => {\n  const { resolveActor, resolveItem } = game.l5r5e.macros;\n  const summary = roll?.l5r5e?.summary ?? {};\n  const difficulty = Number(roll?.l5r5e?.difficulty ?? 0) || 0;\n  const totalSuccess = Number(summary?.totalSuccess ?? 0) || 0;\n  const bonusSuccesses = Math.max(0, totalSuccess - difficulty);\n  const isSuccess = totalSuccess >= difficulty;\n\n  const effectIndex = Number.isFinite(context?.effectIndex) ? Number(context.effectIndex) : 0;\n  const keyBase = typeof context?.effect?.key === \"string\" && context.effect.key.length > 0\n    ? context.effect.key\n    : `strike.hit.${effectIndex}`;\n\n  const weapon = await resolveItem(parameterMap, { itemUuid: parameterMap.weaponUuid }, { item: parameterMap.weapon });\n  const targetActor = await resolveActor(\n    { actor: parameterMap.targetActor, actorUuid: parameterMap.targetActorUuid },\n    { actorUuid: parameterMap.targetUuid }\n  );\n\n  const baseDamage = Number(weapon?.system?.damage ?? 0) || 0;\n  const baseDeadliness = Number(weapon?.system?.deadliness ?? 0) || 0;\n\n  const entry = {\n    key: keyBase,\n    description: `Strike: ${weapon?.name ?? \"Weapon\"}`,\n    priority: 100,\n    finalMacro: \"Compendium.l5r5e.core-macros-test-out.damage_to\",\n    params: {\n      actorUuid: targetActor?.uuid ?? parameterMap.targetActorUuid ?? parameterMap.targetUuid ?? null,\n      weaponUuid: weapon?.uuid ?? parameterMap.weaponUuid ?? null,\n      sourceActorUuid: parameterMap.actorUuid ?? null,\n    },\n    parameters: [\n      {\n        name: \"damage\",\n        label: game.i18n?.localize?.(\"l5r5e.macros.strike.damage\") ?? \"Damage\",\n        type: \"number\",\n        defaultValue: baseDamage + bonusSuccesses,\n        min: 0,\n      },\n      {\n        name: \"deadliness\",\n        label: game.i18n?.localize?.(\"l5r5e.macros.strike.deadliness\") ?? \"Deadliness\",\n        type: \"number\",\n        defaultValue: baseDeadliness,\n        min: 0,\n      },\n    ],\n  };\n\n  if (!isSuccess) {\n    entry.status = \"inactive\";\n  }\n\n  return [entry];\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "hit_on_succes", "uuid": "Compendium.l5r5e.core-macros-test-in.hit_on_succes"}}}
