{"_id": "Resist_Critical_in", "name": "Resist Critical (input)", "type": "script", "img": "icons/svg/skull.svg", "scope": "global", "command": "return (async () => {\n  const [roll, params = {}, state = {}] = args ?? [];\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  const actor = params.actor ?? null;\n  const actorUuid = params.actorUuid ?? actor?.uuid ?? null;\n  if (!actor && !actorUuid) {\n    fail(\"Resist Critical (input) | Missing actor or actorUuid parameter.\");\n  }\n\n\n  const baseSeverity = Math.max(0, Number(params.severity ?? 0));\n  const isRazor = Boolean(params.isRazor);\n\n  const summary = roll?.l5r5e?.summary ?? {};\n  const totalSuccess = Number(summary?.totalSuccess ?? 0);\n  const totalBonus = Math.max(0, Number(summary?.totalBonus ?? 0));\n  const difficulty = Math.max(1, Number(roll?.l5r5e?.difficulty ?? 1));\n\n  const severityWithRazor = baseSeverity + (isRazor ? 1 : 0);\n  const succeeded = totalSuccess >= difficulty;\n  const effectiveBonus = succeeded ? totalBonus : 0;\n  const finalSeverity = succeeded\n    ? Math.max(0, severityWithRazor - 1 - effectiveBonus)\n    : severityWithRazor;\n\n  const sharedParams = {\n    actor,\n    actorUuid,\n    baseSeverity,\n    severityWithRazor,\n    finalSeverity,\n    totalSuccess,\n    totalBonus,\n    effectiveBonus,\n    difficulty,\n    succeeded,\n    isRazor,\n  };\n\n  const entries = [];\n  let order = 0;\n\n  const pushEntry = (key, { description, priority, finalMacro, parameters = [], extraParams = {}, details = null }) => {\n    entries.push({\n      key: `resistCritical.${key}`,\n      description,\n      priority,\n      finalMacro,\n      parameters,\n      params: { ...sharedParams, ...extraParams },\n      order: order++,\n      details,\n    });\n  };\n\n  if (finalSeverity <= 0) {\n    pushEntry(\"closeCall\", {\n      description:\n        game.i18n?.localize?.(\"l5r5e.macros.resistCritical.closeCall\") ?? \"Close Call \u2013 damage armor instead.\",\n      priority: 150,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Close_Call\",\n      parameters: [\n        {\n          name: \"applyEffect\",\n          label: \"Apply armor damage\",\n          type: \"boolean\",\n          defaultValue: true,\n        },\n        {\n          name: \"itemUuid\",\n          label: \"Armor item UUID\",\n          type: \"string\",\n          defaultValue: \"\",\n          placeholder: \"Provide the targeted armor or weapon UUID\",\n        },\n      ],\n    });\n  } else {\n    pushEntry(\"bleeding\", {\n      description:\n        game.i18n?.localize?.(\"l5r5e.macros.resistCritical.bleeding\") ?? \"Suffer the Bleeding condition.\",\n      priority: 200,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Bleeding\",\n      parameters: [\n        {\n          name: \"applyBleeding\",\n          label: \"Apply Bleeding\",\n          type: \"boolean\",\n          defaultValue: true,\n        },\n      ],\n    });\n\n    if (finalSeverity === 2) {\n      pushEntry(\"lightWound\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.lightWound\") ?? \"Suffer a Lightly Wounded condition.\",\n        priority: 225,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Light_Wound\",\n        parameters: [\n          {\n            name: \"applyLightWound\",\n            label: \"Apply Lightly Wounded\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n        ],\n      });\n    } else if (finalSeverity >= 3) {\n      pushEntry(\"heavyWound\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.heavyWound\") ?? \"Suffer a Severely Wounded condition.\",\n        priority: 250,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Heavy_Wound\",\n        parameters: [\n          {\n            name: \"applyHeavyWound\",\n            label: \"Apply Severely Wounded\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n        ],\n      });\n    }\n\n    if (finalSeverity === 4) {\n      pushEntry(\"dying3\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying3\") ?? \"Gain Dying (3 rounds).\",\n        priority: 295,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying3\",\n        parameters: [\n          {\n            name: \"applyDying\",\n            label: \"Apply Dying\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n          {\n            name: \"rounds\",\n            label: \"Rounds remaining\",\n            type: \"number\",\n            min: 1,\n            defaultValue: 3,\n          },\n        ],\n      });\n    } else if (finalSeverity === 5) {\n      pushEntry(\"dying1\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying1\") ?? \"Gain Dying (1 round).\",\n        priority: 300,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1\",\n        parameters: [\n          {\n            name: \"applyDying\",\n            label: \"Apply Dying\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n          {\n            name: \"rounds\",\n            label: \"Rounds remaining\",\n            type: \"number\",\n            min: 0,\n            defaultValue: 1,\n          },\n        ],\n      });\n    } else if (finalSeverity >= 6) {\n      pushEntry(\"dying1\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying1\") ?? \"Gain Dying (1 round).\",\n        priority: 300,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1\",\n        parameters: [\n          {\n            name: \"applyDying\",\n            label: \"Apply Dying\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n          {\n            name: \"rounds\",\n            label: \"Rounds remaining\",\n            type: \"number\",\n            min: 0,\n            defaultValue: 1,\n          },\n        ],\n        extraParams: { overrideRounds: Math.max(1, finalSeverity - 4) },\n      });\n\n      pushEntry(\"instantDeath\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.instantDeath\") ?? \"Suffer instant death.\",\n        priority: 350,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Instant_Death\",\n        parameters: [\n          {\n            name: \"confirm\",\n            label: \"Confirm instant death\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n        ],\n      });\n    }\n  }\n\n  return { entries, state };\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_in", "uuid": "Compendium.l5r5e.core-macros-test-in.Resist_Critical_in"}}}
{"_id": "Example_Test_In", "name": "Example Test (Input)", "type": "script", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "return (async () => {\n  const [roll, params = {}, state = {}] = args ?? [];\n  return {\n    entries: [\n      {\n        key: \"example.test\",\n        description: \"Example effect entry\",\n        priority: 100,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Example_Test_Out\",\n        parameters: [\n          {\n            name: \"note\",\n            label: \"Note to echo\",\n            type: \"string\",\n            defaultValue: params?.note ?? \"\",\n          },\n        ],\n        params: { actor: params?.actor ?? null },\n      },\n    ],\n    state,\n  };\n})();", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test_In", "uuid": "Compendium.l5r5e.core-macros-test-in.Example_Test_In"}}}
