{"_id": "Resist_Critical_in", "name": "Resist Critical (input)", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/skull.svg", "scope": "global", "command": "return (async () => {\n  const [roll, params = {}, state = {}, context = {}] = args ?? [];\n  const summary = roll?.l5r5e?.summary ?? {};\n  const totalSuccess = Number(summary?.totalSuccess ?? 0);\n  const totalBonus = Math.max(0, Number(summary?.totalBonus ?? 0));\n  const difficulty = Number(roll?.l5r5e?.difficulty ?? params?.tn ?? context?.effect?.difficulty ?? 0);\n  const baseSeverity = Math.max(0, Number(params?.severity ?? 0));\n  const severityWithRazor = baseSeverity + (params?.isRazor ? 1 : 0);\n  const succeeded = totalSuccess >= Math.max(1, difficulty);\n  const effectiveBonus = succeeded ? totalBonus : 0;\n  const computedSeverity = succeeded\n    ? Math.max(0, severityWithRazor - 1 - effectiveBonus)\n    : severityWithRazor;\n\n  const nextState = foundry.utils.mergeObject({}, state ?? {}, { inplace: false });\n  const previous = nextState.resistCritical ?? {};\n  const parameterState = previous.parameters && typeof previous.parameters === \"object\" ? previous.parameters : {};\n\n  const sharedParams = {\n    baseSeverity,\n    severityWithRazor,\n    finalSeverity: computedSeverity,\n    totalSuccess,\n    totalBonus,\n    effectiveBonus,\n    difficulty,\n    succeeded,\n    isRazor: Boolean(params?.isRazor),\n    actorUuid: params?.actorUuid ?? null,\n    targetUuid: params?.targetUuid ?? params?.targetActorUuid ?? null,\n    targetTokenUuid: params?.targetTokenUuid ?? null,\n    itemUuid: params?.itemUuid ?? null,\n    ctx: params?.ctx ?? {},\n  };\n\n  const entries = [];\n  let order = 0;\n\n  const cloneParameters = (key, definitions = []) => {\n    const stored = parameterState[key] ?? {};\n    return definitions.map((def, idx) => {\n      const cloned = foundry.utils.deepClone(def ?? {});\n      if (cloned.name) {\n        const storedValue = stored?.[cloned.name];\n        if (storedValue !== undefined) {\n          cloned.userValue = storedValue;\n        } else if (cloned.userValue === undefined && cloned.defaultValue !== undefined) {\n          cloned.userValue = cloned.defaultValue;\n        }\n      }\n      if (cloned.order === undefined) {\n        cloned.order = idx;\n      }\n      return cloned;\n    });\n  };\n\n  const pushEntry = (key, data) => {\n    const entryKey = `resistCritical.${key}`;\n    const parameters = cloneParameters(entryKey, data.parameters ?? []);\n    const mappedParams = foundry.utils.mergeObject(sharedParams, data.params ?? {}, { inplace: false });\n    entries.push({\n      key: entryKey,\n      description: data.description,\n      priority: data.priority,\n      finalMacro: data.finalMacro,\n      order: order++,\n      params: mappedParams,\n      parameters,\n      details: data.details ?? null,\n    });\n\n    parameterState[entryKey] = parameters.reduce((acc, param) => {\n      if (param?.name) {\n        acc[param.name] = param.userValue ?? param.defaultValue ?? null;\n      }\n      return acc;\n    }, {});\n  };\n\n  if (computedSeverity <= 0) {\n    pushEntry(\"closeCall\", {\n      description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.closeCall\") ?? \"Close Call – damage armor instead.\",\n      priority: 150,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Close_Call\",\n      parameters: [\n        {\n          name: \"damageItem\",\n          label: \"Damage equipped armor\",\n          type: \"boolean\",\n          defaultValue: true,\n        },\n        {\n          name: \"targetItem\",\n          label: \"Armor name or item UUID\",\n          type: \"string\",\n          defaultValue: \"\",\n          placeholder: \"Leave empty to use equipped armor\",\n        },\n      ],\n    });\n  } else {\n    pushEntry(\"bleeding\", {\n      description: game.i18n?.localize?.(\"l5r5e.macros.resistCritical.bleeding\") ?? \"Suffer the Bleeding condition.\",\n      priority: 200,\n      finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Bleeding\",\n      parameters: [\n        {\n          name: \"applyBleeding\",\n          label: \"Apply Bleeding\",\n          type: \"boolean\",\n          defaultValue: true,\n        },\n      ],\n    });\n\n    if (computedSeverity === 1) {\n      // no further conditions\n    } else if (computedSeverity === 2) {\n      pushEntry(\"lightWound\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.lightWound\") ?? \"Suffer a Lightly Wounded condition.\",\n        priority: 225,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Light_Wound\",\n        parameters: [\n          {\n            name: \"applyLightWound\",\n            label: \"Apply Lightly Wounded\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n          {\n            name: \"woundLocation\",\n            label: \"Location\",\n            type: \"string\",\n            defaultValue: \"torso\",\n            options: [\n              { value: \"head\", label: \"Head\" },\n              { value: \"arm\", label: \"Arm\" },\n              { value: \"torso\", label: \"Torso\" },\n              { value: \"leg\", label: \"Leg\" },\n            ],\n          },\n        ],\n      });\n    } else {\n      pushEntry(\"heavyWound\", {\n        description:\n          game.i18n?.localize?.(\"l5r5e.macros.resistCritical.heavyWound\") ?? \"Suffer a Severely Wounded condition.\",\n        priority: 250,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Heavy_Wound\",\n        parameters: [\n          {\n            name: \"applyHeavyWound\",\n            label: \"Apply Severely Wounded\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n          {\n            name: \"woundLocation\",\n            label: \"Location\",\n            type: \"string\",\n            defaultValue: \"torso\",\n            options: [\n              { value: \"head\", label: \"Head\" },\n              { value: \"arm\", label: \"Arm\" },\n              { value: \"torso\", label: \"Torso\" },\n              { value: \"leg\", label: \"Leg\" },\n            ],\n          },\n        ],\n      });\n\n      if (computedSeverity === 3) {\n        // heavy wound only\n      } else if (computedSeverity === 4) {\n        pushEntry(\"dying3\", {\n          description:\n            game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying3\") ?? \"Gain Dying (3 rounds).\",\n          priority: 295,\n          finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying3\",\n          parameters: [\n            {\n              name: \"applyDying\",\n              label: \"Apply Dying\",\n              type: \"boolean\",\n              defaultValue: true,\n            },\n            {\n              name: \"rounds\",\n              label: \"Rounds remaining\",\n              type: \"number\",\n              min: 1,\n              defaultValue: 3,\n            },\n          ],\n        });\n      } else if (computedSeverity === 5) {\n        pushEntry(\"dying1\", {\n          description:\n            game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying1\") ?? \"Gain Dying (1 round).\",\n          priority: 300,\n          finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1\",\n          parameters: [\n            {\n              name: \"applyDying\",\n              label: \"Apply Dying\",\n              type: \"boolean\",\n              defaultValue: true,\n            },\n            {\n              name: \"rounds\",\n              label: \"Rounds remaining\",\n              type: \"number\",\n              min: 0,\n              defaultValue: 1,\n            },\n          ],\n        });\n      } else if (computedSeverity >= 6) {\n        pushEntry(\"dying1\", {\n          description:\n            game.i18n?.localize?.(\"l5r5e.macros.resistCritical.dying1\") ?? \"Gain Dying (1 round).\",\n          priority: 300,\n          finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1\",\n          parameters: [\n            {\n              name: \"applyDying\",\n              label: \"Apply Dying\",\n              type: \"boolean\",\n              defaultValue: true,\n            },\n            {\n              name: \"rounds\",\n              label: \"Rounds remaining\",\n              type: \"number\",\n              min: 0,\n              defaultValue: 1,\n            },\n          ],\n          params: { overrideRounds: Math.max(1, computedSeverity - 4) },\n        });\n\n        pushEntry(\"instantDeath\", {\n          description:\n            game.i18n?.localize?.(\"l5r5e.macros.resistCritical.instantDeath\") ?? \"Suffer instant death.\",\n          priority: 350,\n          finalMacro: \"Compendium.l5r5e.core-macros-test-out.Resist_Critical_Instant_Death\",\n          parameters: [\n            {\n              name: \"confirm\",\n              label: \"Confirm instant death\",\n              type: \"boolean\",\n              defaultValue: true,\n            },\n          ],\n        });\n      }\n    }\n  }\n\n  previous.parameters = parameterState;\n  previous.finalSeverity = computedSeverity;\n  previous.baseSeverity = baseSeverity;\n  previous.severityWithRazor = severityWithRazor;\n  previous.totalSuccess = totalSuccess;\n  previous.totalBonus = totalBonus;\n  previous.effectiveBonus = effectiveBonus;\n  previous.difficulty = difficulty;\n  previous.succeeded = succeeded;\n  previous.updatedAt = Date.now();\n  nextState.resistCritical = previous;\n\n  return { entries, state: nextState };\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_in", "uuid": "Compendium.l5r5e.core-macros-test-in.Resist_Critical_in"}}}
{"_id": "Example_Test_In", "name": "Example Test (Input)", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/dice-target.svg", "scope": "global", "command": "return (async () => {\n  const [roll, params = {}, state = {}, context = {}] = args ?? [];\n  return {\n    entries: [\n      {\n        key: \"example.test\",\n        description: \"Example effect entry\",\n        priority: 100,\n        finalMacro: \"Compendium.l5r5e.core-macros-test-out.Example_Test_Out\",\n        parameters: [\n          {\n            name: \"enabled\",\n            label: \"Enable example\",\n            type: \"boolean\",\n            defaultValue: true,\n          },\n        ],\n        params: { ctx: params?.ctx ?? {}, note: params?.note ?? \"\" },\n      },\n    ],\n    state,\n  };\n})();", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test_In", "uuid": "Compendium.l5r5e.core-macros-test-in.Example_Test_In"}}}
