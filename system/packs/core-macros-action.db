{"_id": "Perform_Action", "name": "Perform Action", "type": "script", "img": "icons/svg/upgrade.svg", "scope": "global", "command": "/*\n * Usage: assign parameters via effect.params = {\n *   target: \"Hida Defender\",\n *   range: 2,\n *   actionType: \"attack\",\n *   spendVoid: false,\n *   resourceCost: 0,\n *   autoConfirm: true\n * } to skip the dialog when all required values are provided.\n */\n(async () => {\n    const [roll, parameterArg = {}, effectState = {}, context = {}] = Array.isArray(args) ? args : [];\n    const params = parameterArg && typeof parameterArg === \"object\" ? foundry.utils.deepClone(parameterArg) : {};\n\n    const coerceBoolean = (value) => {\n        if (typeof value === \"string\") {\n            const normalized = value.trim().toLowerCase();\n            return [\"true\", \"1\", \"yes\", \"y\", \"on\"].includes(normalized);\n        }\n        return Boolean(value);\n    };\n\n    const coerceNumber = (value, fallback = 0) => {\n        const numeric = Number(value);\n        return Number.isFinite(numeric) ? numeric : fallback;\n    };\n\n    const parameterDefinitions = [\n        {\n            name: \"target\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.performAction.target\") ?? \"Target\",\n            type: \"string\",\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.performAction.targetHint\") ??\n                \"Name of the intended target or contextual note.\",\n            required: true,\n            placeholder: \"e.g. Bayushi Mei\",\n        },\n        {\n            name: \"range\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.performAction.range\") ?? \"Range (shu)\",\n            type: \"number\",\n            min: 0,\n            step: 1,\n            defaultValue: 1,\n            includeInTotal: true,\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.performAction.rangeHint\") ??\n                \"How far the action reaches (shu).\",\n        },\n        {\n            name: \"actionType\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.performAction.actionType\") ?? \"Action Type\",\n            type: \"select\",\n            options: [\n                {\n                    value: \"attack\",\n                    label: game.i18n?.localize?.(\"l5r5e.actions.attack\") ?? \"Attack\",\n                },\n                {\n                    value: \"scheme\",\n                    label: game.i18n?.localize?.(\"l5r5e.actions.scheme\") ?? \"Scheme\",\n                },\n                {\n                    value: \"support\",\n                    label: game.i18n?.localize?.(\"l5r5e.actions.support\") ?? \"Support\",\n                },\n            ],\n            defaultValue: \"attack\",\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.performAction.actionTypeHint\") ??\n                \"Determines which follow-up macro to run.\",\n        },\n        {\n            name: \"spendVoid\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.performAction.spendVoid\") ?? \"Spend Void point\",\n            type: \"boolean\",\n            defaultValue: false,\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.performAction.spendVoidHint\") ??\n                \"Check if the actor spends a Void point for the action.\",\n        },\n        {\n            name: \"resourceCost\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.performAction.resourceCost\") ?? \"Resources Spent\",\n            type: \"number\",\n            defaultValue: 0,\n            min: 0,\n            includeInTotal: true,\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.performAction.resourceCostHint\") ??\n                \"Track any resource points consumed while acting.\",\n        },\n    ];\n\n    const extractInitialValue = (definition) => {\n        const provided = params[definition.name];\n        if (definition.type === \"boolean\") {\n            if (provided === undefined) {\n                return coerceBoolean(definition.defaultValue ?? false);\n            }\n            return coerceBoolean(provided);\n        }\n        if (definition.type === \"number\") {\n            if (provided === undefined || provided === null || provided === \"\") {\n                return coerceNumber(definition.defaultValue ?? 0, 0);\n            }\n            return coerceNumber(provided, coerceNumber(definition.defaultValue ?? 0, 0));\n        }\n        if (definition.type === \"select\") {\n            const options = Array.isArray(definition.options) ? definition.options : [];\n            const allowed = new Set(options.map((option) => option?.value));\n            if (provided !== undefined && allowed.has(provided)) {\n                return provided;\n            }\n            const defaultCandidate = params?.actionType ?? definition.defaultValue ?? (options[0]?.value ?? \"\");\n            return allowed.has(defaultCandidate) ? defaultCandidate : options[0]?.value ?? \"\";\n        }\n        if (typeof provided === \"string\" && provided.length > 0) {\n            return provided;\n        }\n        if (definition.defaultValue !== undefined) {\n            return definition.defaultValue;\n        }\n        return \"\";\n    };\n\n    const currentValues = parameterDefinitions.reduce((acc, definition) => {\n        acc[definition.name] = extractInitialValue(definition);\n        return acc;\n    }, {});\n\n    const missingRequired = parameterDefinitions.filter((definition) => {\n        if (!definition.required) {\n            return false;\n        }\n        const value = currentValues[definition.name];\n        if (definition.type === \"boolean\") {\n            return false;\n        }\n        if (definition.type === \"number\") {\n            return !Number.isFinite(value);\n        }\n        return value === undefined || value === null || String(value).trim() === \"\";\n    });\n\n    const shouldSkipDialog = params?.autoConfirm === true && missingRequired.length === 0;\n\n    const escapeHtml = (unsafe) => {\n        return String(unsafe ?? \"\")\n            .replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\")\n            .replace(/\"/g, \"&quot;\")\n            .replace(/'/g, \"&#39;\");\n    };\n\n    const requestUserInput = async () => {\n        const content = `<form class=\"l5r5e noflex\">${parameterDefinitions\n            .map((definition) => {\n                const value = currentValues[definition.name];\n                const description = definition.description\n                    ? `<p class=\"notes\">${escapeHtml(definition.description)}</p>`\n                    : \"\";\n\n                if (definition.type === \"boolean\") {\n                    return `\n                        <div class=\"form-group\">\n                            <label>${escapeHtml(definition.label)}</label>\n                            <div class=\"form-fields\">\n                                <input type=\"checkbox\" name=\"${escapeHtml(definition.name)}\" ${value ? \"checked\" : \"\"}>\n                            </div>\n                            ${description}\n                        </div>`;\n                }\n\n                if (definition.type === \"number\") {\n                    const minAttr = Number.isFinite(definition.min) ? `min=\"${definition.min}\"` : \"\";\n                    const maxAttr = Number.isFinite(definition.max) ? `max=\"${definition.max}\"` : \"\";\n                    const stepAttr = Number.isFinite(definition.step) ? `step=\"${definition.step}\"` : \"\";\n                    return `\n                        <div class=\"form-group\">\n                            <label>${escapeHtml(definition.label)}</label>\n                            <div class=\"form-fields\">\n                                <input type=\"number\" name=\"${escapeHtml(definition.name)}\" value=\"${escapeHtml(value)}\" ${minAttr} ${maxAttr} ${stepAttr}>\n                            </div>\n                            ${description}\n                        </div>`;\n                }\n\n                if (definition.type === \"select\") {\n                    const options = Array.isArray(definition.options) ? definition.options : [];\n                    const optionsHtml = options\n                        .map((option) => {\n                            const selected = option.value === value ? \"selected\" : \"\";\n                            return `<option value=\"${escapeHtml(option.value)}\" ${selected}>${escapeHtml(option.label ?? option.value)}</option>`;\n                        })\n                        .join(\"\");\n                    return `\n                        <div class=\"form-group\">\n                            <label>${escapeHtml(definition.label)}</label>\n                            <div class=\"form-fields\">\n                                <select name=\"${escapeHtml(definition.name)}\">${optionsHtml}</select>\n                            </div>\n                            ${description}\n                        </div>`;\n                }\n\n                const placeholder = definition.placeholder ? `placeholder=\"${escapeHtml(definition.placeholder)}\"` : \"\";\n                return `\n                    <div class=\"form-group\">\n                        <label>${escapeHtml(definition.label)}</label>\n                        <div class=\"form-fields\">\n                            <input type=\"text\" name=\"${escapeHtml(definition.name)}\" value=\"${escapeHtml(value)}\" ${placeholder}>\n                        </div>\n                        ${description}\n                    </div>`;\n            })\n            .join(\"\")}</form>`;\n\n        return new Promise((resolve) => {\n            new Dialog({\n                title: game.i18n?.localize?.(\"l5r5e.macros.performAction.title\") ?? \"Perform Action\",\n                content,\n                buttons: {\n                    cancel: {\n                        icon: \"<i class=\\\"fas fa-times\\\"></i>\",\n                        label: game.i18n?.localize?.(\"Cancel\") ?? \"Cancel\",\n                        callback: () => resolve(null),\n                    },\n                    confirm: {\n                        icon: \"<i class=\\\"fas fa-check\\\"></i>\",\n                        label: game.i18n?.localize?.(\"Confirm\") ?? \"Confirm\",\n                        callback: (html) => {\n                            const formData = {};\n                            parameterDefinitions.forEach((definition) => {\n                                const input = html.find(`[name='${definition.name}']`);\n                                if (definition.type === \"boolean\") {\n                                    formData[definition.name] = input?.is?.(\":checked\") ?? false;\n                                } else if (definition.type === \"number\") {\n                                    formData[definition.name] = coerceNumber(input?.val?.(), 0);\n                                } else {\n                                    formData[definition.name] = input?.val?.() ?? \"\";\n                                }\n                            });\n                            resolve(formData);\n                        },\n                    },\n                },\n                default: \"confirm\",\n                close: () => resolve(null),\n            }).render(true);\n        });\n    };\n\n    const finalValues = shouldSkipDialog ? currentValues : await requestUserInput();\n    if (!finalValues) {\n        return { entries: [], state: effectState ?? null };\n    }\n\n    parameterDefinitions.forEach((definition) => {\n        if (definition.type === \"boolean\") {\n            finalValues[definition.name] = coerceBoolean(finalValues[definition.name]);\n        } else if (definition.type === \"number\") {\n            finalValues[definition.name] = coerceNumber(finalValues[definition.name], definition.defaultValue ?? 0);\n        } else if (definition.type === \"select\") {\n            const options = Array.isArray(definition.options) ? definition.options : [];\n            const allowed = new Set(options.map((option) => option?.value));\n            if (!allowed.has(finalValues[definition.name])) {\n                finalValues[definition.name] = options[0]?.value ?? definition.defaultValue ?? \"\";\n            }\n        } else if (typeof finalValues[definition.name] === \"string\") {\n            finalValues[definition.name] = finalValues[definition.name].trim();\n        }\n    });\n\n    const effectIndex = Number.isFinite(Number(context?.effectIndex)) ? Number(context.effectIndex) : 0;\n    const order = Number.isFinite(Number(context?.effect?.order)) ? Number(context.effect.order) : effectIndex;\n\n    const parameterDefsForResult = parameterDefinitions.map((definition, index) => {\n        const baseDefault =\n            definition.defaultValue !== undefined\n                ? definition.defaultValue\n                : definition.type === \"number\"\n                    ? 0\n                    : definition.type === \"boolean\"\n                        ? false\n                        : \"\";\n        return {\n            name: definition.name,\n            label: definition.label,\n            type: definition.type === \"select\" ? \"string\" : definition.type,\n            description: definition.description ?? \"\",\n            defaultValue: baseDefault,\n            userValue: finalValues[definition.name],\n            includeInTotal: definition.includeInTotal ?? definition.type === \"number\",\n            editable: definition.editable ?? true,\n            multiple: definition.multiple ?? false,\n            required: definition.required ?? false,\n            min: Number.isFinite(definition.min) ? Number(definition.min) : null,\n            max: Number.isFinite(definition.max) ? Number(definition.max) : null,\n            step: Number.isFinite(definition.step) ? Number(definition.step) : null,\n            options: Array.isArray(definition.options)\n                ? definition.options.map((option) => ({\n                      value: option.value,\n                      label: option.label ?? String(option.value ?? \"\"),\n                  }))\n                : [],\n            order: index,\n            placeholder: definition.placeholder ?? null,\n        };\n    });\n\n    const parameterValues = parameterDefinitions.reduce((acc, definition) => {\n        acc[definition.name] = finalValues[definition.name];\n        return acc;\n    }, {});\n\n    const summaryParts = [\n        `${game.i18n?.localize?.(\"l5r5e.action\") ?? \"Action\"}: ${finalValues.actionType}`,\n        `${game.i18n?.localize?.(\"Target\") ?? \"Target\"}: ${finalValues.target}`,\n        `${game.i18n?.localize?.(\"l5r5e.macros.performAction.rangeShort\") ?? \"Range\"}: ${finalValues.range}`,\n    ];\n    if (finalValues.spendVoid) {\n        summaryParts.push(game.i18n?.localize?.(\"l5r5e.macros.performAction.voidSpent\") ?? \"Void spent\");\n    }\n    if (coerceNumber(finalValues.resourceCost, 0) > 0) {\n        summaryParts.push(\n            `${game.i18n?.localize?.(\"l5r5e.macros.performAction.resourcesShort\") ?? \"Resources\"}: ${finalValues.resourceCost}`\n        );\n    }\n    const description = summaryParts.join(\" | \");\n\n    const detailsList = parameterDefinitions\n        .map((definition) => `<li><strong>${escapeHtml(definition.label)}:</strong> ${escapeHtml(finalValues[definition.name])}</li>`)\n        .join(\"\");\n\n    const followUpCalls = [];\n    if (finalValues.actionType === \"attack\") {\n        followUpCalls.push({\n            uuid: \"Compendium.l5r5e.core-macros-base-effects.Deal_damage\",\n            payload: { ctx: roll?.context ?? context?.roll?.context ?? {}, value: coerceNumber(finalValues.range, 0) },\n        });\n    } else if (finalValues.actionType === \"scheme\") {\n        followUpCalls.push({\n            uuid: \"Compendium.l5r5e.core-macros-base-effects.Deal_Strife\",\n            payload: { ctx: roll?.context ?? context?.roll?.context ?? {}, value: coerceNumber(finalValues.resourceCost, 0) },\n        });\n    } else if (finalValues.actionType === \"support\") {\n        followUpCalls.push({\n            uuid: \"Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue\",\n            payload: { ctx: roll?.context ?? context?.roll?.context ?? {}, value: coerceNumber(finalValues.resourceCost, 0) },\n        });\n    }\n\n    for (const followUp of followUpCalls) {\n        try {\n            const macro = followUp.uuid ? await fromUuid(followUp.uuid) : null;\n            if (macro) {\n                await macro.execute(followUp.payload);\n            }\n        } catch (error) {\n            console.warn(`Perform_Action | Unable to execute follow-up macro '${followUp.uuid}'`, error);\n        }\n    }\n\n    return {\n        entries: [\n            {\n                effectIndex,\n                order,\n                key:\n                    typeof context?.effect?.key === \"string\" && context.effect.key.length > 0\n                        ? context.effect.key\n                        : `perform-action-${Date.now()}`,\n                description,\n                params: finalValues,\n                parameters: parameterDefsForResult,\n                parameterDefs: parameterDefsForResult,\n                parameterValues,\n                parameterModifiers: {},\n                details: `<ul>${detailsList}</ul>`,\n                baseValue: coerceNumber(finalValues.range, 0),\n            },\n        ],\n        state: {\n            ...effectState,\n            lastParameters: finalValues,\n            effectParameterDefs: {\n                ...(effectState?.effectParameterDefs ?? {}),\n                [effectIndex]: parameterDefsForResult,\n            },\n            effectParameterValues: {\n                ...(effectState?.effectParameterValues ?? {}),\n                [effectIndex]: parameterValues,\n            },\n            effectParameterModifiers: {\n                ...(effectState?.effectParameterModifiers ?? {}),\n                [effectIndex]: {},\n            },\n        },\n    };\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Perform_Action"}}}
{"_id": "Example_Action", "name": "Example Action", "type": "script", "img": "icons/svg/book.svg", "scope": "global", "command": "/*\n * Usage: provide parameters via effect.params = {\n *   ring: \"fire\",\n *   bonusDice: 1,\n *   keepDice: 2,\n *   focus: true,\n *   autoConfirm: true\n * } to reuse saved answers when invoking this macro again.\n */\n(async () => {\n    const [roll, parameterArg = {}, effectState = {}, context = {}] = Array.isArray(args) ? args : [];\n    const params = parameterArg && typeof parameterArg === \"object\" ? foundry.utils.deepClone(parameterArg) : {};\n\n    const coerceBoolean = (value) => {\n        if (typeof value === \"string\") {\n            const normalized = value.trim().toLowerCase();\n            return [\"true\", \"1\", \"yes\", \"y\", \"on\"].includes(normalized);\n        }\n        return Boolean(value);\n    };\n\n    const coerceNumber = (value, fallback = 0) => {\n        const numeric = Number(value);\n        return Number.isFinite(numeric) ? numeric : fallback;\n    };\n\n    const ringOptions = [\n        { value: \"air\", label: game.i18n?.localize?.(\"L5R5E.RingAir\") ?? \"Air\" },\n        { value: \"earth\", label: game.i18n?.localize?.(\"L5R5E.RingEarth\") ?? \"Earth\" },\n        { value: \"fire\", label: game.i18n?.localize?.(\"L5R5E.RingFire\") ?? \"Fire\" },\n        { value: \"water\", label: game.i18n?.localize?.(\"L5R5E.RingWater\") ?? \"Water\" },\n        { value: \"void\", label: game.i18n?.localize?.(\"L5R5E.RingVoid\") ?? \"Void\" },\n    ];\n\n    const parameterDefinitions = [\n        {\n            name: \"ring\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.exampleAction.ring\") ?? \"Ring\",\n            type: \"select\",\n            options: ringOptions,\n            defaultValue: \"fire\",\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.exampleAction.ringHint\") ??\n                \"Choose the ring that will provide the base dice pool.\",\n            required: true,\n        },\n        {\n            name: \"bonusDice\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.exampleAction.bonusDice\") ?? \"Bonus Dice\",\n            type: \"number\",\n            min: 0,\n            defaultValue: 0,\n            includeInTotal: true,\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.exampleAction.bonusDiceHint\") ??\n                \"Additional dice granted by effects or advantages.\",\n        },\n        {\n            name: \"keepDice\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.exampleAction.keepDice\") ?? \"Keep Dice\",\n            type: \"number\",\n            min: 0,\n            defaultValue: 2,\n            includeInTotal: true,\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.exampleAction.keepDiceHint\") ??\n                \"Number of dice kept after the roll.\",\n        },\n        {\n            name: \"focus\",\n            label: game.i18n?.localize?.(\"l5r5e.macros.exampleAction.focus\") ?? \"Focus on target\",\n            type: \"boolean\",\n            defaultValue: false,\n            description:\n                game.i18n?.localize?.(\"l5r5e.macros.exampleAction.focusHint\") ??\n                \"Gain +1 kept die when focusing on the target before rolling.\",\n        },\n    ];\n\n    const escapeHtml = (unsafe) =>\n        String(unsafe ?? \"\")\n            .replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\")\n            .replace(/\"/g, \"&quot;\")\n            .replace(/'/g, \"&#39;\");\n\n    const extractInitialValue = (definition) => {\n        const provided = params[definition.name];\n        if (definition.type === \"boolean\") {\n            if (provided === undefined) {\n                return coerceBoolean(definition.defaultValue ?? false);\n            }\n            return coerceBoolean(provided);\n        }\n        if (definition.type === \"number\") {\n            if (provided === undefined || provided === null || provided === \"\") {\n                return coerceNumber(definition.defaultValue ?? 0, 0);\n            }\n            return coerceNumber(provided, coerceNumber(definition.defaultValue ?? 0, 0));\n        }\n        if (definition.type === \"select\") {\n            const options = Array.isArray(definition.options) ? definition.options : [];\n            const allowed = new Set(options.map((option) => option?.value));\n            if (provided !== undefined && allowed.has(provided)) {\n                return provided;\n            }\n            const defaultCandidate = definition.defaultValue ?? (options[0]?.value ?? \"\");\n            return allowed.has(defaultCandidate) ? defaultCandidate : options[0]?.value ?? \"\";\n        }\n        if (typeof provided === \"string\" && provided.length > 0) {\n            return provided;\n        }\n        if (definition.defaultValue !== undefined) {\n            return definition.defaultValue;\n        }\n        return \"\";\n    };\n\n    const currentValues = parameterDefinitions.reduce((acc, definition) => {\n        acc[definition.name] = extractInitialValue(definition);\n        return acc;\n    }, {});\n\n    const missingRequired = parameterDefinitions.filter((definition) => {\n        if (!definition.required) {\n            return false;\n        }\n        const value = currentValues[definition.name];\n        if (definition.type === \"select\") {\n            return !value;\n        }\n        if (definition.type === \"boolean\") {\n            return false;\n        }\n        if (definition.type === \"number\") {\n            return !Number.isFinite(value);\n        }\n        return value === undefined || value === null || String(value).trim() === \"\";\n    });\n\n    const shouldSkipDialog = params?.autoConfirm === true && missingRequired.length === 0;\n\n    const requestUserInput = async () => {\n        const content = `<form class=\"l5r5e noflex\">${parameterDefinitions\n            .map((definition) => {\n                const value = currentValues[definition.name];\n                const description = definition.description\n                    ? `<p class=\"notes\">${escapeHtml(definition.description)}</p>`\n                    : \"\";\n\n                if (definition.type === \"boolean\") {\n                    return `\n                        <div class=\"form-group\">\n                            <label>${escapeHtml(definition.label)}</label>\n                            <div class=\"form-fields\">\n                                <input type=\"checkbox\" name=\"${escapeHtml(definition.name)}\" ${value ? \"checked\" : \"\"}>\n                            </div>\n                            ${description}\n                        </div>`;\n                }\n\n                if (definition.type === \"number\") {\n                    const minAttr = Number.isFinite(definition.min) ? `min=\"${definition.min}\"` : \"\";\n                    const maxAttr = Number.isFinite(definition.max) ? `max=\"${definition.max}\"` : \"\";\n                    const stepAttr = Number.isFinite(definition.step) ? `step=\"${definition.step}\"` : \"\";\n                    return `\n                        <div class=\"form-group\">\n                            <label>${escapeHtml(definition.label)}</label>\n                            <div class=\"form-fields\">\n                                <input type=\"number\" name=\"${escapeHtml(definition.name)}\" value=\"${escapeHtml(value)}\" ${minAttr} ${maxAttr} ${stepAttr}>\n                            </div>\n                            ${description}\n                        </div>`;\n                }\n\n                if (definition.type === \"select\") {\n                    const options = Array.isArray(definition.options) ? definition.options : [];\n                    const optionsHtml = options\n                        .map((option) => {\n                            const selected = option.value === value ? \"selected\" : \"\";\n                            return `<option value=\"${escapeHtml(option.value)}\" ${selected}>${escapeHtml(option.label ?? option.value)}</option>`;\n                        })\n                        .join(\"\");\n                    return `\n                        <div class=\"form-group\">\n                            <label>${escapeHtml(definition.label)}</label>\n                            <div class=\"form-fields\">\n                                <select name=\"${escapeHtml(definition.name)}\">${optionsHtml}</select>\n                            </div>\n                            ${description}\n                        </div>`;\n                }\n\n                return `\n                    <div class=\"form-group\">\n                        <label>${escapeHtml(definition.label)}</label>\n                        <div class=\"form-fields\">\n                            <input type=\"text\" name=\"${escapeHtml(definition.name)}\" value=\"${escapeHtml(value)}\">\n                        </div>\n                        ${description}\n                    </div>`;\n            })\n            .join(\"\")}</form>`;\n\n        return new Promise((resolve) => {\n            new Dialog({\n                title: game.i18n?.localize?.(\"l5r5e.macros.exampleAction.title\") ?? \"Example Action\",\n                content,\n                buttons: {\n                    cancel: {\n                        icon: \"<i class=\\\"fas fa-times\\\"></i>\",\n                        label: game.i18n?.localize?.(\"Cancel\") ?? \"Cancel\",\n                        callback: () => resolve(null),\n                    },\n                    confirm: {\n                        icon: \"<i class=\\\"fas fa-check\\\"></i>\",\n                        label: game.i18n?.localize?.(\"Confirm\") ?? \"Confirm\",\n                        callback: (html) => {\n                            const formData = {};\n                            parameterDefinitions.forEach((definition) => {\n                                const input = html.find(`[name='${definition.name}']`);\n                                if (definition.type === \"boolean\") {\n                                    formData[definition.name] = input?.is?.(\":checked\") ?? false;\n                                } else if (definition.type === \"number\") {\n                                    formData[definition.name] = coerceNumber(input?.val?.(), 0);\n                                } else {\n                                    formData[definition.name] = input?.val?.() ?? \"\";\n                                }\n                            });\n                            resolve(formData);\n                        },\n                    },\n                },\n                default: \"confirm\",\n                close: () => resolve(null),\n            }).render(true);\n        });\n    };\n\n    const finalValues = shouldSkipDialog ? currentValues : await requestUserInput();\n    if (!finalValues) {\n        return { entries: [], state: effectState ?? null };\n    }\n\n    parameterDefinitions.forEach((definition) => {\n        if (definition.type === \"boolean\") {\n            finalValues[definition.name] = coerceBoolean(finalValues[definition.name]);\n        } else if (definition.type === \"number\") {\n            finalValues[definition.name] = coerceNumber(finalValues[definition.name], definition.defaultValue ?? 0);\n        } else if (definition.type === \"select\") {\n            const options = Array.isArray(definition.options) ? definition.options : [];\n            const allowed = new Set(options.map((option) => option?.value));\n            if (!allowed.has(finalValues[definition.name])) {\n                finalValues[definition.name] = options[0]?.value ?? definition.defaultValue ?? \"\";\n            }\n        } else if (typeof finalValues[definition.name] === \"string\") {\n            finalValues[definition.name] = finalValues[definition.name].trim();\n        }\n    });\n\n    const selectedRing = ringOptions.find((option) => option.value === finalValues.ring) ?? ringOptions[0];\n    const baseRingValue = Number(roll?.ring?.value ?? roll?.l5r5e?.ringValue ?? 0);\n    const computedBonusDice = coerceNumber(finalValues.bonusDice, 0);\n    const computedKeepDice = coerceNumber(finalValues.keepDice, 0) + (finalValues.focus ? 1 : 0);\n    const effectiveRingDice = Math.max(baseRingValue, 0) + computedBonusDice;\n\n    const parameterDefsForResult = parameterDefinitions.map((definition, index) => {\n        const baseDefault =\n            definition.defaultValue !== undefined\n                ? definition.defaultValue\n                : definition.type === \"number\"\n                    ? 0\n                    : definition.type === \"boolean\"\n                        ? false\n                        : \"\";\n        return {\n            name: definition.name,\n            label: definition.label,\n            type: definition.type === \"select\" ? \"string\" : definition.type,\n            description: definition.description ?? \"\",\n            defaultValue: baseDefault,\n            userValue: finalValues[definition.name],\n            includeInTotal: definition.includeInTotal ?? definition.type === \"number\",\n            editable: definition.editable ?? true,\n            multiple: definition.multiple ?? false,\n            required: definition.required ?? false,\n            min: Number.isFinite(definition.min) ? Number(definition.min) : null,\n            max: Number.isFinite(definition.max) ? Number(definition.max) : null,\n            step: Number.isFinite(definition.step) ? Number(definition.step) : null,\n            options: Array.isArray(definition.options)\n                ? definition.options.map((option) => ({\n                      value: option.value,\n                      label: option.label ?? String(option.value ?? \"\"),\n                  }))\n                : [],\n            order: index,\n        };\n    });\n\n    const parameterValues = parameterDefinitions.reduce((acc, definition) => {\n        acc[definition.name] = finalValues[definition.name];\n        return acc;\n    }, {});\n\n    const summaryLines = [\n        `${game.i18n?.localize?.(\"l5r5e.macros.exampleAction.summaryRing\") ?? \"Ring\"}: ${selectedRing?.label ?? finalValues.ring}`,\n        `${game.i18n?.localize?.(\"l5r5e.macros.exampleAction.summaryDice\") ?? \"Dice\"}: ${effectiveRingDice}`,\n        `${game.i18n?.localize?.(\"l5r5e.macros.exampleAction.summaryKeep\") ?? \"Keep\"}: ${computedKeepDice}`,\n    ];\n    if (finalValues.focus) {\n        summaryLines.push(game.i18n?.localize?.(\"l5r5e.macros.exampleAction.summaryFocus\") ?? \"Focused (+1 keep)\");\n    }\n\n    const description = summaryLines.join(\" | \");\n    const detailList = [\n        `<li>${escapeHtml(game.i18n?.localize?.(\"l5r5e.macros.exampleAction.detailBaseRing\") ?? \"Base Ring Dice\")}: ${escapeHtml(baseRingValue)}</li>`,\n        `<li>${escapeHtml(game.i18n?.localize?.(\"l5r5e.macros.exampleAction.detailBonus\") ?? \"User Bonus Dice\")}: ${escapeHtml(computedBonusDice)}</li>`,\n        `<li>${escapeHtml(game.i18n?.localize?.(\"l5r5e.macros.exampleAction.detailKeep\") ?? \"Total Kept Dice\")}: ${escapeHtml(computedKeepDice)}</li>`,\n    ].join(\"\");\n\n    const effectIndex = Number.isFinite(Number(context?.effectIndex)) ? Number(context.effectIndex) : 0;\n    const order = Number.isFinite(Number(context?.effect?.order)) ? Number(context.effect.order) : effectIndex;\n\n    return {\n        entries: [\n            {\n                effectIndex,\n                order,\n                key:\n                    typeof context?.effect?.key === \"string\" && context.effect.key.length > 0\n                        ? context.effect.key\n                        : `example-action-${Date.now()}`,\n                description,\n                params: finalValues,\n                parameters: parameterDefsForResult,\n                parameterDefs: parameterDefsForResult,\n                parameterValues,\n                parameterModifiers: {},\n                details: `<ul>${detailList}</ul>`,\n                baseValue: effectiveRingDice,\n                modifier: computedBonusDice,\n            },\n        ],\n        state: {\n            ...effectState,\n            lastExample: finalValues,\n            effectParameterDefs: {\n                ...(effectState?.effectParameterDefs ?? {}),\n                [effectIndex]: parameterDefsForResult,\n            },\n            effectParameterValues: {\n                ...(effectState?.effectParameterValues ?? {}),\n                [effectIndex]: parameterValues,\n            },\n            effectParameterModifiers: {\n                ...(effectState?.effectParameterModifiers ?? {}),\n                [effectIndex]: {},\n            },\n        },\n    };\n})();\n", "folder": null, "sort": 1, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Action"}}}

{"_id": "Strike", "name": "Strike", "type": "script", "img": "icons/svg/sword.svg", "scope": "global", "command": "\n(async () => {\n  const [arg = {}] = Array.isArray(args) ? args : [];\n  const params = arg && typeof arg === \"object\" ? foundry.utils.deepClone(arg) : {};\n\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n\n  const resolveActorDocument = async (candidate) => {\n    if (!candidate) return null;\n    if (candidate instanceof Actor) return candidate;\n    if (candidate instanceof TokenDocument) return candidate.actor ?? null;\n    if (candidate.actor instanceof Actor) return candidate.actor;\n    if (typeof candidate === \"string\") {\n      try {\n        const doc = await fromUuid(candidate);\n        if (doc instanceof Actor) return doc;\n        if (doc instanceof TokenDocument) return doc.actor ?? null;\n        if (doc?.actor instanceof Actor) return doc.actor;\n      } catch (error) {\n        console.warn(\"Strike | Failed to resolve actor UUID\", candidate, error);\n      }\n    }\n    return null;\n  };\n\n  const resolveTokenDocument = async (candidate) => {\n    if (!candidate) return null;\n    if (candidate instanceof TokenDocument) return candidate;\n    if (candidate instanceof Token) return candidate.document ?? null;\n    if (typeof candidate === \"string\") {\n      try {\n        const doc = await fromUuid(candidate);\n        if (doc instanceof TokenDocument) return doc;\n        if (doc instanceof Token) return doc.document ?? null;\n      } catch (error) {\n        console.warn(\"Strike | Failed to resolve token UUID\", candidate, error);\n      }\n    }\n    return null;\n  };\n\n  const resolveItemDocument = async (candidate, actorDocument) => {\n    if (!candidate) return null;\n    if (candidate instanceof Item) return candidate;\n    if (typeof candidate === \"string\") {\n      const owned = actorDocument?.items?.get(candidate) ?? null;\n      if (owned) return owned;\n      try {\n        const doc = await fromUuid(candidate);\n        if (doc instanceof Item) return doc;\n      } catch (error) {\n        console.warn(\"Strike | Failed to resolve item UUID\", candidate, error);\n      }\n    }\n    if (candidate?.item instanceof Item) return candidate.item;\n    if (candidate?.document instanceof Item) return candidate.document;\n    return null;\n  };\n\n  const promptForChoice = async (title, choices, { nameField = \"label\" } = {}) => {\n    if (!Array.isArray(choices) || choices.length === 0) return null;\n    if (choices.length === 1) return choices[0]?.value ?? null;\n\n    const escapeHtml = (value) =>\n      String(value ?? \"\")\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\");\n\n    const options = choices\n      .map((choice) => {\n        if (!choice || choice.value === undefined || choice.value === null) return \"\";\n        const id = String(choice.id ?? choice.value?.uuid ?? choice.value?.id ?? \"\");\n        if (!id) return \"\";\n        const label = escapeHtml(choice[nameField] ?? choice.label ?? choice.text ?? id);\n        return `<option value=\"${id}\">${label}</option>`;\n      })\n      .filter((html) => html.length > 0)\n      .join(\"\");\n\n    if (!options) return null;\n\n    const content = `<form><div class=\"form-group\"><label>${escapeHtml(title)}</label><select name=\"choice\">${options}</select></div></form>`;\n\n    const selectedId = await Dialog.prompt({\n      title,\n      content,\n      label: game.i18n?.localize?.(\"Confirm\") ?? \"Confirm\",\n      callback: (html) => html?.find?.(\"[name='choice']\")?.val?.() ?? html?.querySelector?.(\"[name='choice']\")?.value ?? null,\n      rejectClose: false,\n    });\n\n    if (!selectedId) return null;\n    const match = choices.find((choice) => String(choice.id ?? choice.value?.uuid ?? choice.value?.id ?? \"\") === String(selectedId));\n    return match?.value ?? null;\n  };\n\n  let actor = await resolveActorDocument(params.actor ?? params.actorUuid ?? null);\n\n  if (!actor) {\n    const controlled = Array.isArray(canvas?.tokens?.controlled) ? canvas.tokens.controlled : [];\n    const actorChoices = controlled\n      .map((token) => token?.document ?? null)\n      .filter((doc) => doc?.actor)\n      .map((doc) => ({\n        id: doc.uuid,\n        label: `${doc.name ?? doc.actor?.name ?? \"Token\"}`,\n        value: doc.actor,\n      }));\n    if (actorChoices.length === 1) {\n      actor = actorChoices[0].value;\n    } else if (actorChoices.length > 1) {\n      actor = await promptForChoice(game.i18n?.localize?.(\"l5r5e.macros.strike.chooseActor\") ?? \"Choose Actor\", actorChoices);\n    }\n    if (!actor && game.user?.character instanceof Actor) {\n      actor = game.user.character;\n    }\n  }\n\n  if (!actor) {\n    fail(\"Strike | Unable to determine actor.\");\n  }\n\n  let target = await resolveTokenDocument(params.target ?? params.targetUuid ?? null);\n  if (!target) {\n    const targeted = Array.from(game.user?.targets ?? [])\n      .map((token) => token?.document ?? null)\n      .filter((doc) => !!doc);\n    if (targeted.length === 1) {\n      target = targeted[0];\n    } else if (targeted.length > 1) {\n      target = await promptForChoice(\n        game.i18n?.localize?.(\"l5r5e.macros.strike.chooseTarget\") ?? \"Choose Target\",\n        targeted.map((doc) => ({ id: doc.uuid, label: doc.name ?? doc.id ?? \"Target\", value: doc }))\n      );\n    }\n  }\n\n  let weapon = await resolveItemDocument(\n    params.weapon ?? params.item ?? params.weaponUuid ?? params.itemUuid ?? params.weaponId ?? params.itemId ?? null,\n    actor\n  );\n\n  if (!weapon) {\n    const ownedWeapons = actor?.items?.filter?.((item) => item?.type === \"weapon\") ?? [];\n    if (ownedWeapons.length === 0) {\n      fail(\"Strike | Selected actor has no weapons available.\");\n    }\n    if (ownedWeapons.length === 1) {\n      weapon = ownedWeapons[0];\n    } else if (ownedWeapons.length > 1) {\n      weapon = await promptForChoice(\n        game.i18n?.localize?.(\"l5r5e.macros.strike.chooseWeapon\") ?? \"Choose Weapon\",\n        ownedWeapons.map((item) => ({ id: item.uuid ?? item.id, label: item.name ?? item.id ?? \"Weapon\", value: item }))\n      );\n    }\n  }\n\n  if (!weapon) {\n    fail(\"Strike | Unable to determine weapon.\");\n  }\n\n  const rollEffects = [\n    {\n      macro: \"Compendium.l5r5e.core-macros-test-in.hit_on_succes\",\n      params: {\n        actor,\n        actorUuid: actor?.uuid ?? null,\n        target,\n        targetUuid: target?.uuid ?? null,\n        targetActor: target?.actor ?? null,\n        targetActorUuid: target?.actor?.uuid ?? null,\n        weapon,\n        weaponUuid: weapon?.uuid ?? null,\n      },\n      order: 0,\n    },\n  ];\n\n  const DialogClass = game?.l5r5e?.DicePickerDialog ?? null;\n  if (!DialogClass) {\n    fail(\"Strike | Dice picker dialog is unavailable.\");\n  }\n\n  const dialog = new DialogClass({\n    actor,\n    item: weapon,\n    itemUuid: weapon?.uuid ?? null,\n    target,\n    difficulty: 2,\n    actions: { attack: true },\n    rollEffects,\n  });\n  dialog.render(true);\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Strike", "uuid": "Compendium.l5r5e.core-macros-action.Strike"}}}