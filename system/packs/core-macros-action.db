{"_id": "Perform_Action", "name": "Perform Action", "type": "script", "img": "icons/svg/upgrade.svg", "scope": "global", "command": "/*\n * Action input macro.\n * Reads parameterMap (from effect.params) for prefill values.\n * Returns Array<entry> — one entry per chosen action — for the summary screen.\n * If parameterMap.autoConfirm and all required values are present, skips dialog.\n */\nreturn (async () => {\n    const { coerceBoolean, coerceNumber, escapeHtml } = game.l5r5e.macros;\n    const params = parameterMap && typeof parameterMap === \"object\"\n        ? foundry.utils.deepClone(parameterMap)\n        : {};\n\n    const parameterDefinitions = [\n        { name: \"target\", label: game.i18n?.localize?.(\"l5r5e.macros.performAction.target\") ?? \"Target\", type: \"string\", required: true, placeholder: \"e.g. Bayushi Mei\" },\n        { name: \"range\", label: game.i18n?.localize?.(\"l5r5e.macros.performAction.range\") ?? \"Range (shu)\", type: \"number\", min: 0, step: 1, defaultValue: 1 },\n        { name: \"actionType\", label: game.i18n?.localize?.(\"l5r5e.macros.performAction.actionType\") ?? \"Action Type\", type: \"select\",\n          options: [\n            { value: \"attack\", label: game.i18n?.localize?.(\"l5r5e.actions.attack\") ?? \"Attack\" },\n            { value: \"scheme\", label: game.i18n?.localize?.(\"l5r5e.actions.scheme\") ?? \"Scheme\" },\n            { value: \"support\", label: game.i18n?.localize?.(\"l5r5e.actions.support\") ?? \"Support\" },\n          ],\n          defaultValue: \"attack\" },\n        { name: \"spendVoid\", label: game.i18n?.localize?.(\"l5r5e.macros.performAction.spendVoid\") ?? \"Spend Void point\", type: \"boolean\", defaultValue: false },\n        { name: \"resourceCost\", label: game.i18n?.localize?.(\"l5r5e.macros.performAction.resourceCost\") ?? \"Resources Spent\", type: \"number\", defaultValue: 0, min: 0 },\n    ];\n\n    const initialFor = (def) => {\n        const v = params[def.name];\n        if (def.type === \"boolean\") return v === undefined ? coerceBoolean(def.defaultValue, false) : coerceBoolean(v);\n        if (def.type === \"number\") return v === undefined || v === null || v === \"\" ? coerceNumber(def.defaultValue, 0) : coerceNumber(v, coerceNumber(def.defaultValue, 0));\n        if (def.type === \"select\") {\n            const opts = (def.options ?? []).map((o) => o.value);\n            if (opts.includes(v)) return v;\n            return opts.includes(def.defaultValue) ? def.defaultValue : (opts[0] ?? \"\");\n        }\n        return typeof v === \"string\" && v.length > 0 ? v : (def.defaultValue ?? \"\");\n    };\n\n    const initial = Object.fromEntries(parameterDefinitions.map((d) => [d.name, initialFor(d)]));\n    const missingRequired = parameterDefinitions.filter((d) => d.required && (initial[d.name] === undefined || String(initial[d.name]).trim() === \"\"));\n    const skipDialog = params.autoConfirm === true && missingRequired.length === 0;\n\n    const promptUser = async () => {\n        const fieldHtml = (def) => {\n            const v = initial[def.name];\n            if (def.type === \"boolean\") {\n                return `<div class=\"form-group\"><label>${escapeHtml(def.label)}</label><div class=\"form-fields\"><input type=\"checkbox\" name=\"${escapeHtml(def.name)}\" ${v ? \"checked\" : \"\"}></div></div>`;\n            }\n            if (def.type === \"number\") {\n                const min = Number.isFinite(def.min) ? `min=\"${def.min}\"` : \"\";\n                const max = Number.isFinite(def.max) ? `max=\"${def.max}\"` : \"\";\n                const step = Number.isFinite(def.step) ? `step=\"${def.step}\"` : \"\";\n                return `<div class=\"form-group\"><label>${escapeHtml(def.label)}</label><div class=\"form-fields\"><input type=\"number\" name=\"${escapeHtml(def.name)}\" value=\"${escapeHtml(v)}\" ${min} ${max} ${step}></div></div>`;\n            }\n            if (def.type === \"select\") {\n                const opts = (def.options ?? []).map((o) => `<option value=\"${escapeHtml(o.value)}\" ${o.value === v ? \"selected\" : \"\"}>${escapeHtml(o.label ?? o.value)}</option>`).join(\"\");\n                return `<div class=\"form-group\"><label>${escapeHtml(def.label)}</label><div class=\"form-fields\"><select name=\"${escapeHtml(def.name)}\">${opts}</select></div></div>`;\n            }\n            const placeholder = def.placeholder ? `placeholder=\"${escapeHtml(def.placeholder)}\"` : \"\";\n            return `<div class=\"form-group\"><label>${escapeHtml(def.label)}</label><div class=\"form-fields\"><input type=\"text\" name=\"${escapeHtml(def.name)}\" value=\"${escapeHtml(v)}\" ${placeholder}></div></div>`;\n        };\n        const content = `<form class=\"l5r5e noflex\">${parameterDefinitions.map(fieldHtml).join(\"\")}</form>`;\n        return new Promise((resolve) => {\n            new Dialog({\n                title: game.i18n?.localize?.(\"l5r5e.macros.performAction.title\") ?? \"Perform Action\",\n                content,\n                buttons: {\n                    cancel: { icon: \"<i class=\\\"fas fa-times\\\"></i>\", label: game.i18n?.localize?.(\"Cancel\") ?? \"Cancel\", callback: () => resolve(null) },\n                    confirm: {\n                        icon: \"<i class=\\\"fas fa-check\\\"></i>\",\n                        label: game.i18n?.localize?.(\"Confirm\") ?? \"Confirm\",\n                        callback: (html) => {\n                            const data = {};\n                            parameterDefinitions.forEach((def) => {\n                                const input = html.find(`[name='${def.name}']`);\n                                if (def.type === \"boolean\") data[def.name] = input?.is?.(\":checked\") ?? false;\n                                else if (def.type === \"number\") data[def.name] = coerceNumber(input?.val?.(), 0);\n                                else data[def.name] = input?.val?.() ?? \"\";\n                            });\n                            resolve(data);\n                        },\n                    },\n                },\n                default: \"confirm\",\n                close: () => resolve(null),\n            }).render(true);\n        });\n    };\n\n    const finalValues = skipDialog ? initial : await promptUser();\n    if (!finalValues) return [];\n\n    const effectIndex = Number.isFinite(Number(context?.effectIndex)) ? Number(context.effectIndex) : 0;\n    const description = [\n        `${game.i18n?.localize?.(\"l5r5e.action\") ?? \"Action\"}: ${finalValues.actionType}`,\n        `${game.i18n?.localize?.(\"Target\") ?? \"Target\"}: ${finalValues.target}`,\n        `${game.i18n?.localize?.(\"l5r5e.macros.performAction.rangeShort\") ?? \"Range\"}: ${finalValues.range}`,\n    ].concat(\n        finalValues.spendVoid ? [game.i18n?.localize?.(\"l5r5e.macros.performAction.voidSpent\") ?? \"Void spent\"] : [],\n        coerceNumber(finalValues.resourceCost, 0) > 0 ? [`${game.i18n?.localize?.(\"l5r5e.macros.performAction.resourcesShort\") ?? \"Resources\"}: ${finalValues.resourceCost}`] : []\n    ).join(\" | \");\n\n    const finalMacroByType = {\n        attack: \"Compendium.l5r5e.core-macros-base-effects.Deal_damage\",\n        scheme: \"Compendium.l5r5e.core-macros-base-effects.Deal_Strife\",\n        support: \"Compendium.l5r5e.core-macros-base-effects.Deal_Fatigue\",\n    };\n\n    return [\n        {\n            key: typeof context?.effect?.key === \"string\" && context.effect.key.length > 0\n                ? context.effect.key\n                : `perform-action-${effectIndex}`,\n            description,\n            priority: 100,\n            finalMacro: finalMacroByType[finalValues.actionType] ?? null,\n            params: finalValues,\n            parameters: [\n                { name: \"value\", label: \"Effect value\", type: \"number\", defaultValue: coerceNumber(finalValues.range, 0), min: 0 },\n            ],\n        },\n    ];\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Perform_Action"}}}
{"_id": "Example_Action", "name": "Example Action", "type": "script", "img": "icons/svg/book.svg", "scope": "global", "command": "/*\n * Example input macro that prompts for ring/dice configuration and returns\n * a single effect entry illustrating the simplified contract.\n */\nreturn (async () => {\n    const { coerceBoolean, coerceNumber, escapeHtml } = game.l5r5e.macros;\n    const params = parameterMap && typeof parameterMap === \"object\"\n        ? foundry.utils.deepClone(parameterMap)\n        : {};\n\n    const ringOptions = [\n        { value: \"air\", label: game.i18n?.localize?.(\"L5R5E.RingAir\") ?? \"Air\" },\n        { value: \"earth\", label: game.i18n?.localize?.(\"L5R5E.RingEarth\") ?? \"Earth\" },\n        { value: \"fire\", label: game.i18n?.localize?.(\"L5R5E.RingFire\") ?? \"Fire\" },\n        { value: \"water\", label: game.i18n?.localize?.(\"L5R5E.RingWater\") ?? \"Water\" },\n        { value: \"void\", label: game.i18n?.localize?.(\"L5R5E.RingVoid\") ?? \"Void\" },\n    ];\n\n    const defs = [\n        { name: \"ring\", label: \"Ring\", type: \"select\", options: ringOptions, defaultValue: \"fire\", required: true },\n        { name: \"bonusDice\", label: \"Bonus Dice\", type: \"number\", min: 0, defaultValue: 0 },\n        { name: \"keepDice\", label: \"Keep Dice\", type: \"number\", min: 0, defaultValue: 2 },\n        { name: \"focus\", label: \"Focus on target\", type: \"boolean\", defaultValue: false },\n    ];\n\n    const initialFor = (def) => {\n        const v = params[def.name];\n        if (def.type === \"boolean\") return v === undefined ? coerceBoolean(def.defaultValue) : coerceBoolean(v);\n        if (def.type === \"number\") return v === undefined || v === null || v === \"\" ? coerceNumber(def.defaultValue, 0) : coerceNumber(v, coerceNumber(def.defaultValue, 0));\n        if (def.type === \"select\") {\n            const opts = (def.options ?? []).map((o) => o.value);\n            return opts.includes(v) ? v : (opts.includes(def.defaultValue) ? def.defaultValue : opts[0] ?? \"\");\n        }\n        return typeof v === \"string\" && v.length > 0 ? v : (def.defaultValue ?? \"\");\n    };\n    const initial = Object.fromEntries(defs.map((d) => [d.name, initialFor(d)]));\n    const skipDialog = params.autoConfirm === true;\n\n    const finalValues = skipDialog ? initial : await new Promise((resolve) => {\n        const fieldHtml = (def) => {\n            const v = initial[def.name];\n            if (def.type === \"boolean\") return `<div class=\"form-group\"><label>${escapeHtml(def.label)}</label><input type=\"checkbox\" name=\"${escapeHtml(def.name)}\" ${v ? \"checked\" : \"\"}></div>`;\n            if (def.type === \"number\") return `<div class=\"form-group\"><label>${escapeHtml(def.label)}</label><input type=\"number\" name=\"${escapeHtml(def.name)}\" value=\"${escapeHtml(v)}\"></div>`;\n            if (def.type === \"select\") {\n                const opts = def.options.map((o) => `<option value=\"${escapeHtml(o.value)}\" ${o.value === v ? \"selected\" : \"\"}>${escapeHtml(o.label)}</option>`).join(\"\");\n                return `<div class=\"form-group\"><label>${escapeHtml(def.label)}</label><select name=\"${escapeHtml(def.name)}\">${opts}</select></div>`;\n            }\n            return `<div class=\"form-group\"><label>${escapeHtml(def.label)}</label><input type=\"text\" name=\"${escapeHtml(def.name)}\" value=\"${escapeHtml(v)}\"></div>`;\n        };\n        new Dialog({\n            title: \"Example Action\",\n            content: `<form class=\"l5r5e\">${defs.map(fieldHtml).join(\"\")}</form>`,\n            buttons: {\n                cancel: { label: \"Cancel\", callback: () => resolve(null) },\n                confirm: { label: \"Confirm\", callback: (html) => {\n                    const data = {};\n                    defs.forEach((def) => {\n                        const input = html.find(`[name='${def.name}']`);\n                        if (def.type === \"boolean\") data[def.name] = input?.is?.(\":checked\") ?? false;\n                        else if (def.type === \"number\") data[def.name] = coerceNumber(input?.val?.(), 0);\n                        else data[def.name] = input?.val?.() ?? \"\";\n                    });\n                    resolve(data);\n                } },\n            },\n            default: \"confirm\",\n            close: () => resolve(null),\n        }).render(true);\n    });\n\n    if (!finalValues) return [];\n\n    const baseRing = Number(roll?.ring?.value ?? roll?.l5r5e?.ringValue ?? 0) || 0;\n    const totalDice = Math.max(0, baseRing) + coerceNumber(finalValues.bonusDice, 0);\n    const keep = coerceNumber(finalValues.keepDice, 0) + (finalValues.focus ? 1 : 0);\n\n    return [\n        {\n            key: `example-action-${context?.effectIndex ?? 0}`,\n            description: `Ring: ${finalValues.ring} | Dice: ${totalDice} | Keep: ${keep}`,\n            priority: 100,\n            finalMacro: \"Compendium.l5r5e.core-macros-test-out.Example_Test_Out\",\n            params: finalValues,\n            parameters: defs.map((d) => ({ ...d, userValue: finalValues[d.name] })),\n        },\n    ];\n})();\n", "folder": null, "sort": 1, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Action"}}}
{"_id": "Strike", "name": "Strike", "type": "script", "img": "icons/svg/sword.svg", "scope": "global", "command": "/**\n * Expected args: [{ actor?, actorUuid?, target?, targetUuid?, weapon?, weaponUuid?, item?, itemUuid? }].\n * Consumes direct parameter values to configure the dialog and pass data to roll effects.\n */\n(async () => {\n  const [arg = {}] = Array.isArray(args) ? args : [];\n  const params = arg && typeof arg === \"object\" ? foundry.utils.deepClone(arg) : {};\n\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n\n  const resolveActorDocument = async (candidate) => {\n    if (!candidate) return null;\n    if (candidate instanceof Actor) return candidate;\n    if (candidate instanceof TokenDocument) return candidate.actor ?? null;\n    if (candidate.actor instanceof Actor) return candidate.actor;\n    if (typeof candidate === \"string\") {\n      try {\n        const doc = await fromUuid(candidate);\n        if (doc instanceof Actor) return doc;\n        if (doc instanceof TokenDocument) return doc.actor ?? null;\n        if (doc?.actor instanceof Actor) return doc.actor;\n      } catch (error) {\n        console.warn(\"Strike | Failed to resolve actor UUID\", candidate, error);\n      }\n    }\n    return null;\n  };\n\n  const resolveTokenDocument = async (candidate) => {\n    if (!candidate) return null;\n    if (candidate instanceof TokenDocument) return candidate;\n    if (candidate instanceof Token) return candidate.document ?? null;\n    if (typeof candidate === \"string\") {\n      try {\n        const doc = await fromUuid(candidate);\n        if (doc instanceof TokenDocument) return doc;\n        if (doc instanceof Token) return doc.document ?? null;\n      } catch (error) {\n        console.warn(\"Strike | Failed to resolve token UUID\", candidate, error);\n      }\n    }\n    return null;\n  };\n\n  const resolveItemDocument = async (candidate, actorDocument) => {\n    if (!candidate) return null;\n    if (candidate instanceof Item) return candidate;\n    if (typeof candidate === \"string\") {\n      const owned = actorDocument?.items?.get(candidate) ?? null;\n      if (owned) return owned;\n      try {\n        const doc = await fromUuid(candidate);\n        if (doc instanceof Item) return doc;\n      } catch (error) {\n        console.warn(\"Strike | Failed to resolve item UUID\", candidate, error);\n      }\n    }\n    if (candidate?.item instanceof Item) return candidate.item;\n    if (candidate?.document instanceof Item) return candidate.document;\n    return null;\n  };\n\n  const promptForChoice = async (title, choices, { nameField = \"label\" } = {}) => {\n    if (!Array.isArray(choices) || choices.length === 0) return null;\n    if (choices.length === 1) return choices[0]?.value ?? null;\n\n    const escapeHtml = (value) =>\n      String(value ?? \"\")\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\");\n\n    const options = choices\n      .map((choice) => {\n        if (!choice || choice.value === undefined || choice.value === null) return \"\";\n        const id = String(choice.id ?? choice.value?.uuid ?? choice.value?.id ?? \"\");\n        if (!id) return \"\";\n        const label = escapeHtml(choice[nameField] ?? choice.label ?? choice.text ?? id);\n        return `<option value=\"${id}\">${label}</option>`;\n      })\n      .filter((html) => html.length > 0)\n      .join(\"\");\n\n    if (!options) return null;\n\n    const content = `<form><div class=\"form-group\"><label>${escapeHtml(title)}</label><select name=\"choice\">${options}</select></div></form>`;\n\n    const selectedId = await Dialog.prompt({\n      title,\n      content,\n      label: game.i18n?.localize?.(\"Confirm\") ?? \"Confirm\",\n      callback: (html) => html?.find?.(\"[name='choice']\")?.val?.() ?? html?.querySelector?.(\"[name='choice']\")?.value ?? null,\n      rejectClose: false,\n    });\n\n    if (!selectedId) return null;\n    const match = choices.find((choice) => String(choice.id ?? choice.value?.uuid ?? choice.value?.id ?? \"\") === String(selectedId));\n    return match?.value ?? null;\n  };\n\n  let actor = await resolveActorDocument(params.actor ?? params.actorUuid ?? null);\n\n  if (!actor) {\n    const controlled = Array.isArray(canvas?.tokens?.controlled) ? canvas.tokens.controlled : [];\n    const actorChoices = controlled\n      .map((token) => token?.document ?? null)\n      .filter((doc) => doc?.actor)\n      .map((doc) => ({\n        id: doc.uuid,\n        label: `${doc.name ?? doc.actor?.name ?? \"Token\"}`,\n        value: doc.actor,\n      }));\n    if (actorChoices.length === 1) {\n      actor = actorChoices[0].value;\n    } else if (actorChoices.length > 1) {\n      actor = await promptForChoice(game.i18n?.localize?.(\"l5r5e.macros.strike.chooseActor\") ?? \"Choose Actor\", actorChoices);\n    }\n    if (!actor && game.user?.character instanceof Actor) {\n      actor = game.user.character;\n    }\n  }\n\n  if (!actor) {\n    fail(\"Strike | Unable to determine actor.\");\n  }\n\n  let target = await resolveTokenDocument(params.target ?? params.targetUuid ?? null);\n  if (!target) {\n    const targeted = Array.from(game.user?.targets ?? [])\n      .map((token) => token?.document ?? null)\n      .filter((doc) => !!doc);\n    if (targeted.length === 1) {\n      target = targeted[0];\n    } else if (targeted.length > 1) {\n      target = await promptForChoice(\n        game.i18n?.localize?.(\"l5r5e.macros.strike.chooseTarget\") ?? \"Choose Target\",\n        targeted.map((doc) => ({ id: doc.uuid, label: doc.name ?? doc.id ?? \"Target\", value: doc }))\n      );\n    }\n  }\n\n  let weapon = await resolveItemDocument(\n    params.weapon ?? params.item ?? params.weaponUuid ?? params.itemUuid ?? params.weaponId ?? params.itemId ?? null,\n    actor\n  );\n\n  if (!weapon) {\n    const ownedWeapons = actor?.items?.filter?.((item) => item?.type === \"weapon\") ?? [];\n    if (ownedWeapons.length === 0) {\n      fail(\"Strike | Selected actor has no weapons available.\");\n    }\n    if (ownedWeapons.length === 1) {\n      weapon = ownedWeapons[0];\n    } else if (ownedWeapons.length > 1) {\n      weapon = await promptForChoice(\n        game.i18n?.localize?.(\"l5r5e.macros.strike.chooseWeapon\") ?? \"Choose Weapon\",\n        ownedWeapons.map((item) => ({ id: item.uuid ?? item.id, label: item.name ?? item.id ?? \"Weapon\", value: item }))\n      );\n    }\n  }\n\n  if (!weapon) {\n    fail(\"Strike | Unable to determine weapon.\");\n  }\n\n  const rollEffects = [\n    {\n      macro: \"Compendium.l5r5e.core-macros-test-in.hit_on_succes\",\n      params: {\n        actor,\n        actorUuid: actor?.uuid ?? null,\n        target,\n        targetUuid: target?.uuid ?? null,\n        targetActor: target?.actor ?? null,\n        targetActorUuid: target?.actor?.uuid ?? null,\n        weapon,\n        weaponUuid: weapon?.uuid ?? null,\n      },\n      order: 0,\n    },\n  ];\n\n  const DialogClass = game?.l5r5e?.DicePickerDialog ?? null;\n  if (!DialogClass) {\n    fail(\"Strike | Dice picker dialog is unavailable.\");\n  }\n\n  const dialog = new DialogClass({\n    actor,\n    item: weapon,\n    itemUuid: weapon?.uuid ?? null,\n    target,\n    difficulty: 2,\n    actions: { attack: true },\n    rollEffects,\n  });\n  dialog.render(true);\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Strike", "uuid": "Compendium.l5r5e.core-macros-action.Strike"}}}
