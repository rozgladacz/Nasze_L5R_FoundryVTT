{"_id": "Resist_Critical_Close_Call", "name": "Resist Critical – Close Call", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/shield.svg", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}, context = {}] = args ?? [];\nconst resolveContext = async (input = {}) => {\n  const ctx = input?.ctx ?? {};\n  const actorUuid = input?.targetUuid ?? ctx?.targetActorUuid ?? ctx?.actorUuid ?? null;\n  const tokenUuid = input?.targetTokenUuid ?? ctx?.targetTokenUuid ?? null;\n  const itemUuid = input?.itemUuid ?? ctx?.itemUuid ?? null;\n\n  let actor = null;\n  if (actorUuid) {\n    const actorDoc = await fromUuid(actorUuid).catch(() => null);\n    actor = actorDoc?.actor ?? actorDoc ?? null;\n  }\n  if (!actor && tokenUuid) {\n    const tokenDoc = await fromUuid(tokenUuid).catch(() => null);\n    actor = tokenDoc?.actor ?? actor;\n  }\n\n  let item = null;\n  if (itemUuid) {\n    item = await fromUuid(itemUuid).catch(() => null);\n  }\n  if (!item && actor && itemUuid) {\n    item = actor.items?.get(itemUuid) ?? actor.items?.find?.((it) => it.id === itemUuid);\n  }\n\n  return { actor, item };\n};\n  const { actor, item: weapon } = await resolveContext(params);\n  if (!actor) {\n    console.warn('Resist_Critical_Close_Call | Unable to resolve target actor.');\n    return;\n  }\n  const damageItem = parameterMap?.damageItem !== false;\n  if (!damageItem) {\n    return;\n  }\n\n  let targetItem = null;\n  const requested = parameterMap?.targetItem ?? null;\n  if (requested) {\n    targetItem = actor.items?.get(requested) ?? actor.items?.find?.((it) => it.id === requested || it.name === requested);\n  }\n  if (!targetItem && params?.itemUuid) {\n    const owned = await fromUuid(params.itemUuid).catch(() => null);\n    targetItem = owned?.actor?.id === actor.id ? owned : targetItem;\n  }\n  if (!targetItem && weapon) {\n    targetItem = weapon;\n  }\n  if (!targetItem) {\n    targetItem = actor.items?.find?.((it) => it.type === 'armor' && it.system?.equipped);\n  }\n\n  if (!targetItem) {\n    console.warn('Resist_Critical_Close_Call | No armor item found to damage.');\n    return;\n  }\n\n  const qualities = targetItem.system?.qualities ?? {};\n  const updates = {};\n  if (!qualities.damaged) {\n    updates['system.qualities.damaged'] = true;\n  } else if (!qualities.destroyed) {\n    updates['system.qualities.destroyed'] = true;\n  }\n\n  if (Object.keys(updates).length > 0) {\n    await targetItem.update(updates);\n  }\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Close_Call", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Close_Call"}}}
{"_id": "Resist_Critical_Bleeding", "name": "Resist Critical – Bleeding", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/bleeding.webp", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}, context = {}] = args ?? [];\nconst resolveContext = async (input = {}) => {\n  const ctx = input?.ctx ?? {};\n  const actorUuid = input?.targetUuid ?? ctx?.targetActorUuid ?? ctx?.actorUuid ?? null;\n  const tokenUuid = input?.targetTokenUuid ?? ctx?.targetTokenUuid ?? null;\n  const itemUuid = input?.itemUuid ?? ctx?.itemUuid ?? null;\n\n  let actor = null;\n  if (actorUuid) {\n    const actorDoc = await fromUuid(actorUuid).catch(() => null);\n    actor = actorDoc?.actor ?? actorDoc ?? null;\n  }\n  if (!actor && tokenUuid) {\n    const tokenDoc = await fromUuid(tokenUuid).catch(() => null);\n    actor = tokenDoc?.actor ?? actor;\n  }\n\n  let item = null;\n  if (itemUuid) {\n    item = await fromUuid(itemUuid).catch(() => null);\n  }\n  if (!item && actor && itemUuid) {\n    item = actor.items?.get(itemUuid) ?? actor.items?.find?.((it) => it.id === itemUuid);\n  }\n\n  return { actor, item };\n};\n  const { actor } = await resolveContext(params);\n  if (!actor) {\n    console.warn('Resist_Critical_Bleeding | Unable to resolve target actor.');\n    return;\n  }\n  if (parameterMap?.applyBleeding === false) {\n    return;\n  }\n  await actor.update({ 'flags.l5r5e.conditions.Bleeding': true });\n})();", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Bleeding", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Bleeding"}}}
{"_id": "Resist_Critical_Light_Wound", "name": "Resist Critical – Light Wound", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/lightly_wounded.webp", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}, context = {}] = args ?? [];\nconst resolveContext = async (input = {}) => {\n  const ctx = input?.ctx ?? {};\n  const actorUuid = input?.targetUuid ?? ctx?.targetActorUuid ?? ctx?.actorUuid ?? null;\n  const tokenUuid = input?.targetTokenUuid ?? ctx?.targetTokenUuid ?? null;\n  const itemUuid = input?.itemUuid ?? ctx?.itemUuid ?? null;\n\n  let actor = null;\n  if (actorUuid) {\n    const actorDoc = await fromUuid(actorUuid).catch(() => null);\n    actor = actorDoc?.actor ?? actorDoc ?? null;\n  }\n  if (!actor && tokenUuid) {\n    const tokenDoc = await fromUuid(tokenUuid).catch(() => null);\n    actor = tokenDoc?.actor ?? actor;\n  }\n\n  let item = null;\n  if (itemUuid) {\n    item = await fromUuid(itemUuid).catch(() => null);\n  }\n  if (!item && actor && itemUuid) {\n    item = actor.items?.get(itemUuid) ?? actor.items?.find?.((it) => it.id === itemUuid);\n  }\n\n  return { actor, item };\n};\n  const { actor } = await resolveContext(params);\n  if (!actor) {\n    console.warn('Resist_Critical_Light_Wound | Unable to resolve target actor.');\n    return;\n  }\n  if (parameterMap?.applyLightWound === false) {\n    return;\n  }\n  await actor.update({ 'flags.l5r5e.conditions.LightlyWounded': true });\n})();", "folder": null, "sort": 20, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Light_Wound", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Light_Wound"}}}
