{"_id": "Resist_Critical_Heavy_Wound", "name": "Resist Critical \u2013 Heavy Wound", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/severely_wounded.webp", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}] = args ?? [];\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (parameterMap?.applyHeavyWound === false) {\n    return;\n  }\n  const resolveActor = async () => {\n    if (params?.actor) return params.actor;\n    if (parameterMap?.actor) return parameterMap.actor;\n    const uuid = params?.actorUuid ?? parameterMap?.actorUuid ?? null;\n    if (!uuid) return null;\n    const resolved = await fromUuid(uuid).catch(() => null);\n    return resolved?.actor ?? resolved ?? null;\n  };\n  const actor = await resolveActor();\n  if (!actor) {\n    fail('Resist_Critical_Heavy_Wound | Missing actor.');\n  }\n\n  const pack = game.packs?.get(\"l5r5e.core-macros-base-effects\") ?? null;\n  const macro = (await pack?.getDocument?.(\"Add_Condition\")) ?? null;\n  if (!macro) {\n    fail('Resist_Critical_Heavy_Wound | Unable to locate Add_Condition macro.');\n  }\n\n  await macro.execute([{ actor, condition: \"SeverelyWounded\" }]);\n\n})();", "folder": null, "sort": 30, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Heavy_Wound", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Heavy_Wound"}}}
{"_id": "Resist_Critical_Dying3", "name": "Resist Critical \u2013 Dying (3)", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/dying_3.webp", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}] = args ?? [];\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (parameterMap?.applyDying === false) {\n    return;\n  }\n  const resolveActor = async () => {\n    if (params?.actor) return params.actor;\n    if (parameterMap?.actor) return parameterMap.actor;\n    const uuid = params?.actorUuid ?? parameterMap?.actorUuid ?? null;\n    if (!uuid) return null;\n    const resolved = await fromUuid(uuid).catch(() => null);\n    return resolved?.actor ?? resolved ?? null;\n  };\n  const actor = await resolveActor();\n  if (!actor) {\n    fail('Resist_Critical_Dying3 | Missing actor.');\n  }\n\n  const pack = game.packs?.get(\"l5r5e.core-macros-base-effects\") ?? null;\n  const macro = (await pack?.getDocument?.(\"Add_Condition\")) ?? null;\n  if (!macro) {\n    fail('Resist_Critical_Dying3 | Unable to locate Add_Condition macro.');\n  }\n\n  await macro.execute([{ actor, condition: \"Dying\" }]);\n\n\nconst rounds = Math.max(1, Math.floor(Number(parameterMap?.rounds ?? 3)));\nawait actor.update({\n  'system.statuses.dyingRounds': rounds,\n});\n})();", "folder": null, "sort": 40, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Dying3", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying3"}}}
{"_id": "Resist_Critical_Dying1", "name": "Resist Critical \u2013 Dying (1)", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/dying_1.webp", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}] = args ?? [];\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (parameterMap?.applyDying === false) {\n    return;\n  }\n  const resolveActor = async () => {\n    if (params?.actor) return params.actor;\n    if (parameterMap?.actor) return parameterMap.actor;\n    const uuid = params?.actorUuid ?? parameterMap?.actorUuid ?? null;\n    if (!uuid) return null;\n    const resolved = await fromUuid(uuid).catch(() => null);\n    return resolved?.actor ?? resolved ?? null;\n  };\n  const actor = await resolveActor();\n  if (!actor) {\n    fail('Resist_Critical_Dying1 | Missing actor.');\n  }\n\n  const pack = game.packs?.get(\"l5r5e.core-macros-base-effects\") ?? null;\n  const macro = (await pack?.getDocument?.(\"Add_Condition\")) ?? null;\n  if (!macro) {\n    fail('Resist_Critical_Dying1 | Unable to locate Add_Condition macro.');\n  }\n\n  await macro.execute([{ actor, condition: \"Dying\" }]);\n\n\nconst override = Number(params?.overrideRounds ?? 0);\nconst base = Number(parameterMap?.rounds ?? 1);\nconst chosen = Number.isFinite(override) && override > 0 ? override : base;\nconst rounds = Math.max(0, Math.floor(chosen));\nawait actor.update({\n  'system.statuses.dyingRounds': rounds,\n});\n})();", "folder": null, "sort": 50, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Dying1", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1"}}}
{"_id": "Resist_Critical_Instant_Death", "name": "Resist Critical \u2013 Instant Death", "type": "script", "img": "icons/svg/skull.svg", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}] = args ?? [];\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (parameterMap?.confirm === false) {\n    return;\n  }\n  const resolveActor = async () => {\n    if (params?.actor) return params.actor;\n    if (parameterMap?.actor) return parameterMap.actor;\n    const uuid = params?.actorUuid ?? parameterMap?.actorUuid ?? null;\n    if (!uuid) return null;\n    const resolved = await fromUuid(uuid).catch(() => null);\n    return resolved?.actor ?? resolved ?? null;\n  };\n  const actor = await resolveActor();\n  if (!actor) {\n    fail('Resist_Critical_Instant_Death | Missing actor.');\n  }\n\n  const pack = game.packs?.get(\"l5r5e.core-macros-base-effects\") ?? null;\n  const macro = (await pack?.getDocument?.(\"Add_Condition\")) ?? null;\n  if (!macro) {\n    fail('Resist_Critical_Instant_Death | Unable to locate Add_Condition macro.');\n  }\n\n  await macro.execute([{ actor, condition: \"Dead\" }]);\n\n})();", "folder": null, "sort": 60, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Instant_Death", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Instant_Death"}}}
{"_id": "Example_Test_Out", "name": "Example Test (Output)", "type": "script", "img": "icons/svg/clockwork.svg", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}] = args ?? [];\n  console.info(\"Example_Test_Out\", { parameterMap, params });\n})();", "folder": null, "sort": 70, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test_Out", "uuid": "Compendium.l5r5e.core-macros-test-out.Example_Test_Out"}}}
