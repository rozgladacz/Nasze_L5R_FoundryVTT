{"_id": "Resist_Critical_Close_Call", "name": "Resist Critical – Close Call", "type": "script", "img": "icons/svg/shield.svg", "scope": "global", "command": "return (async () => {\n  const { fail, resolveActor, resolveItem } = game.l5r5e.macros;\n  if (parameterMap?.applyEffect === false) return;\n  const actor = await resolveActor(parameterMap, context?.params ?? {});\n  let item = await resolveItem(parameterMap, context?.params ?? {});\n  if (!item && actor?.items) {\n    item = actor.items.find?.((it) => it.type === \"armor\" && it.system?.equipped) ?? null;\n  }\n  if (!item) fail(\"Resist Critical (Close Call) | Unable to resolve item to damage.\");\n  const target = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Damage_an_item\");\n  if (!target) fail(\"Resist Critical (Close Call) | Unable to locate Damage_an_item macro.\");\n  await target.execute({ parameterMap: { item } });\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Close_Call", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Close_Call"}}}
{"_id": "Resist_Critical_Bleeding", "name": "Resist Critical – Bleeding", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/bleeding.webp", "scope": "global", "command": "return (async () => {\n  const { fail, resolveActor } = game.l5r5e.macros;\n  if (parameterMap?.applyBleeding === false) return;\n  const actor = await resolveActor(parameterMap, context?.params ?? {});\n  if (!actor) fail(\"Resist Critical (Bleeding) | Missing actor.\");\n  const target = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Add_Condition\");\n  if (!target) fail(\"Resist Critical (Bleeding) | Unable to locate Add_Condition macro.\");\n  await target.execute({ parameterMap: { actor, condition: \"Bleeding\" } });\n})();\n", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Bleeding", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Bleeding"}}}
{"_id": "Resist_Critical_Light_Wound", "name": "Resist Critical – Light Wound", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/lightly_wounded.webp", "scope": "global", "command": "return (async () => {\n  const { fail, resolveActor } = game.l5r5e.macros;\n  if (parameterMap?.applyLightWound === false) return;\n  const actor = await resolveActor(parameterMap, context?.params ?? {});\n  if (!actor) fail(\"Resist Critical (Light Wound) | Missing actor.\");\n  const target = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Add_Condition\");\n  if (!target) fail(\"Resist Critical (Light Wound) | Unable to locate Add_Condition macro.\");\n  await target.execute({ parameterMap: { actor, condition: \"LightlyWounded\" } });\n})();\n", "folder": null, "sort": 20, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Light_Wound", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Light_Wound"}}}
{"_id": "Resist_Critical_Heavy_Wound", "name": "Resist Critical – Heavy Wound", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/severely_wounded.webp", "scope": "global", "command": "return (async () => {\n  const { fail, resolveActor } = game.l5r5e.macros;\n  if (parameterMap?.applyHeavyWound === false) return;\n  const actor = await resolveActor(parameterMap, context?.params ?? {});\n  if (!actor) fail(\"Resist Critical (Heavy Wound) | Missing actor.\");\n  const target = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Add_Condition\");\n  if (!target) fail(\"Resist Critical (Heavy Wound) | Unable to locate Add_Condition macro.\");\n  await target.execute({ parameterMap: { actor, condition: \"SeverelyWounded\" } });\n})();\n", "folder": null, "sort": 30, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Heavy_Wound", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Heavy_Wound"}}}
{"_id": "Resist_Critical_Dying3", "name": "Resist Critical – Dying (3)", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/dying_3.webp", "scope": "global", "command": "return (async () => {\n  const { fail, coerceNumber, resolveActor } = game.l5r5e.macros;\n  if (parameterMap?.applyDying === false) return;\n  const actor = await resolveActor(parameterMap, context?.params ?? {});\n  if (!actor) fail(\"Resist Critical (Dying 3) | Missing actor.\");\n  const target = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Add_Condition\");\n  if (!target) fail(\"Resist Critical (Dying 3) | Unable to locate Add_Condition macro.\");\n  await target.execute({ parameterMap: { actor, condition: \"Dying\" } });\n  const rounds = Math.max(1, Math.floor(coerceNumber(parameterMap.rounds, 3)));\n  await actor.update({ \"system.statuses.dyingRounds\": rounds });\n})();\n", "folder": null, "sort": 40, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Dying3", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying3"}}}
{"_id": "Resist_Critical_Dying1", "name": "Resist Critical – Dying (1)", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/dying_1.webp", "scope": "global", "command": "return (async () => {\n  const { fail, coerceNumber, resolveActor } = game.l5r5e.macros;\n  if (parameterMap?.applyDying === false) return;\n  const actor = await resolveActor(parameterMap, context?.params ?? {});\n  if (!actor) fail(\"Resist Critical (Dying 1) | Missing actor.\");\n  const target = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Add_Condition\");\n  if (!target) fail(\"Resist Critical (Dying 1) | Unable to locate Add_Condition macro.\");\n  await target.execute({ parameterMap: { actor, condition: \"Dying\" } });\n  const rounds = Math.max(0, Math.floor(coerceNumber(parameterMap.rounds, 1)));\n  await actor.update({ \"system.statuses.dyingRounds\": rounds });\n})();\n", "folder": null, "sort": 50, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Dying1", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1"}}}
{"_id": "Resist_Critical_Instant_Death", "name": "Resist Critical – Instant Death", "type": "script", "img": "icons/svg/skull.svg", "scope": "global", "command": "return (async () => {\n  const { fail, resolveActor } = game.l5r5e.macros;\n  if (parameterMap?.confirm === false) return;\n  const actor = await resolveActor(parameterMap, context?.params ?? {});\n  if (!actor) fail(\"Resist Critical (Instant Death) | Missing actor.\");\n  const target = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Add_Condition\");\n  if (!target) fail(\"Resist Critical (Instant Death) | Unable to locate Add_Condition macro.\");\n  await target.execute({ parameterMap: { actor, condition: \"Dead\" } });\n})();\n", "folder": null, "sort": 60, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Instant_Death", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Instant_Death"}}}
{"_id": "Example_Test_Out", "name": "Example Test (Output)", "type": "script", "img": "icons/svg/clockwork.svg", "scope": "global", "command": "return (async () => {\n  console.info(\"Example_Test_Out\", { parameterMap, context });\n})();\n", "folder": null, "sort": 70, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test_Out", "uuid": "Compendium.l5r5e.core-macros-test-out.Example_Test_Out"}}}

{"_id": "damage_to", "name": "damage_to", "type": "script", "img": "icons/svg/sword.svg", "scope": "global", "command": "return (async () => {\n  const { fail, coerceNumber, resolveActor, resolveItem } = game.l5r5e.macros;\n  const params = context?.params ?? {};\n  const value = coerceNumber(parameterMap?.damage, 0);\n  const deadliness = coerceNumber(parameterMap?.deadliness ?? params?.deadliness, 0);\n\n  const actor = await resolveActor(params, parameterMap);\n  if (!actor) fail(\"damage_to | Missing target actor.\");\n  const weapon = await resolveItem(params, parameterMap, { itemUuid: params?.weaponUuid });\n\n  const target = await fromUuid(\"Compendium.l5r5e.core-macros-base-effects.Deal_damage\");\n  if (!target) fail(\"damage_to | Unable to resolve Deal Damage macro.\");\n  await target.execute({ parameterMap: { actor, value, deadliness, weapon } });\n})();\n", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "damage_to", "uuid": "Compendium.l5r5e.core-macros-test-out.damage_to"}}}
