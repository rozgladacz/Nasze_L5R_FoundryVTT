{"_id": "Resist_Critical_Dying3", "name": "Resist Critical – Dying (3)", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/dying_3.webp", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}, context = {}] = args ?? [];\nconst resolveContext = async (input = {}) => {\n  const ctx = input?.ctx ?? {};\n  const actorUuid = input?.targetUuid ?? ctx?.targetActorUuid ?? ctx?.actorUuid ?? null;\n  const tokenUuid = input?.targetTokenUuid ?? ctx?.targetTokenUuid ?? null;\n  const itemUuid = input?.itemUuid ?? ctx?.itemUuid ?? null;\n\n  let actor = null;\n  if (actorUuid) {\n    const actorDoc = await fromUuid(actorUuid).catch(() => null);\n    actor = actorDoc?.actor ?? actorDoc ?? null;\n  }\n  if (!actor && tokenUuid) {\n    const tokenDoc = await fromUuid(tokenUuid).catch(() => null);\n    actor = tokenDoc?.actor ?? actor;\n  }\n\n  let item = null;\n  if (itemUuid) {\n    item = await fromUuid(itemUuid).catch(() => null);\n  }\n  if (!item && actor && itemUuid) {\n    item = actor.items?.get(itemUuid) ?? actor.items?.find?.((it) => it.id === itemUuid);\n  }\n\n  return { actor, item };\n};\n  const { actor } = await resolveContext(params);\n  if (!actor) {\n    console.warn('Resist_Critical_Dying3 | Unable to resolve target actor.');\n    return;\n  }\n  if (parameterMap?.applyDying === false) {\n    return;\n  }\n  const rounds = Number(parameterMap?.rounds ?? params?.overrideRounds ?? 3);\n  await actor.update({\n    'flags.l5r5e.conditions.Dying': true,\n    'system.statuses.dyingRounds': Math.max(1, Math.floor(rounds)),\n  });\n})();", "folder": null, "sort": 40, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Dying3", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying3"}}}
{"_id": "Resist_Critical_Dying1", "name": "Resist Critical – Dying (1)", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "systems/l5r5e/assets/icons/conditions/dying_1.webp", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}, context = {}] = args ?? [];\nconst resolveContext = async (input = {}) => {\n  const ctx = input?.ctx ?? {};\n  const actorUuid = input?.targetUuid ?? ctx?.targetActorUuid ?? ctx?.actorUuid ?? null;\n  const tokenUuid = input?.targetTokenUuid ?? ctx?.targetTokenUuid ?? null;\n  const itemUuid = input?.itemUuid ?? ctx?.itemUuid ?? null;\n\n  let actor = null;\n  if (actorUuid) {\n    const actorDoc = await fromUuid(actorUuid).catch(() => null);\n    actor = actorDoc?.actor ?? actorDoc ?? null;\n  }\n  if (!actor && tokenUuid) {\n    const tokenDoc = await fromUuid(tokenUuid).catch(() => null);\n    actor = tokenDoc?.actor ?? actor;\n  }\n\n  let item = null;\n  if (itemUuid) {\n    item = await fromUuid(itemUuid).catch(() => null);\n  }\n  if (!item && actor && itemUuid) {\n    item = actor.items?.get(itemUuid) ?? actor.items?.find?.((it) => it.id === itemUuid);\n  }\n\n  return { actor, item };\n};\n  const { actor } = await resolveContext(params);\n  if (!actor) {\n    console.warn('Resist_Critical_Dying1 | Unable to resolve target actor.');\n    return;\n  }\n  if (parameterMap?.applyDying === false) {\n    return;\n  }\n  const roundsParam = params?.overrideRounds ?? parameterMap?.rounds ?? 1;\n  const rounds = Math.max(0, Math.floor(Number(roundsParam)));\n  await actor.update({\n    'flags.l5r5e.conditions.Dying': true,\n    'system.statuses.dyingRounds': rounds,\n  });\n})();", "folder": null, "sort": 50, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Dying1", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Dying1"}}}
{"_id": "Resist_Critical_Instant_Death", "name": "Resist Critical – Instant Death", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/skull.svg", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}, context = {}] = args ?? [];\nconst resolveContext = async (input = {}) => {\n  const ctx = input?.ctx ?? {};\n  const actorUuid = input?.targetUuid ?? ctx?.targetActorUuid ?? ctx?.actorUuid ?? null;\n  const tokenUuid = input?.targetTokenUuid ?? ctx?.targetTokenUuid ?? null;\n  const itemUuid = input?.itemUuid ?? ctx?.itemUuid ?? null;\n\n  let actor = null;\n  if (actorUuid) {\n    const actorDoc = await fromUuid(actorUuid).catch(() => null);\n    actor = actorDoc?.actor ?? actorDoc ?? null;\n  }\n  if (!actor && tokenUuid) {\n    const tokenDoc = await fromUuid(tokenUuid).catch(() => null);\n    actor = tokenDoc?.actor ?? actor;\n  }\n\n  let item = null;\n  if (itemUuid) {\n    item = await fromUuid(itemUuid).catch(() => null);\n  }\n  if (!item && actor && itemUuid) {\n    item = actor.items?.get(itemUuid) ?? actor.items?.find?.((it) => it.id === itemUuid);\n  }\n\n  return { actor, item };\n};\n  const { actor } = await resolveContext(params);\n  if (!actor) {\n    console.warn('Resist_Critical_Instant_Death | Unable to resolve target actor.');\n    return;\n  }\n  if (parameterMap?.confirm === false) {\n    return;\n  }\n  await actor.update({ 'flags.l5r5e.conditions.Dead': true });\n})();", "folder": null, "sort": 60, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Instant_Death", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Instant_Death"}}}
{"_id": "Example_Test_Out", "name": "Example Test (Output)", "type": "script", "author": "Rv52pj6itbOX14wX", "img": "icons/svg/clockwork.svg", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}, context = {}] = args ?? [];\n  console.info(\"Example_Test_Out\", { roll, parameterMap, params, context });\n})();", "folder": null, "sort": 70, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Example_Test_Out", "uuid": "Compendium.l5r5e.core-macros-test-out.Example_Test_Out"}}}
