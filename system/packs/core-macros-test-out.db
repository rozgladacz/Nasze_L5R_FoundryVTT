{"_id": "Resist_Critical_Close_Call", "name": "Resist Critical \u2013 Close Call", "type": "script", "img": "icons/svg/shield.svg", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}] = args ?? [];\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (parameterMap?.applyEffect === false) {\n    return;\n  }\n  const resolveActor = async () => {\n    if (params?.actor) return params.actor;\n    if (parameterMap?.actor) return parameterMap.actor;\n    const uuid = params?.actorUuid ?? parameterMap?.actorUuid ?? null;\n    if (!uuid) return null;\n    const resolved = await fromUuid(uuid).catch(() => null);\n    return resolved?.actor ?? resolved ?? null;\n  };\n  const actor = await resolveActor();\n\n  const resolveItem = async () => {\n    if (parameterMap?.item && typeof parameterMap.item === \"object\") {\n      return parameterMap.item;\n    }\n    if (params?.item && typeof params.item === \"object\") {\n      return params.item;\n    }\n    const candidates = [parameterMap?.itemUuid, params?.itemUuid];\n    for (const candidate of candidates) {\n      if (typeof candidate === \"string\" && candidate) {\n        const resolved = await fromUuid(candidate).catch(() => null);\n        if (resolved?.documentName === \"Item\" || resolved?.isEmbedded) {\n          return resolved;\n        }\n        if (actor?.items) {\n          const owned = actor.items.get(candidate) ?? actor.items.find?.((it) => it.id === candidate || it.uuid === candidate);\n          if (owned) return owned;\n        }\n      }\n    }\n    if (actor?.items) {\n      const fallback = actor.items.find?.((it) => it.type === \"armor\" && it.system?.equipped);\n      if (fallback) return fallback;\n    }\n    return null;\n  };\n\n  const item = await resolveItem();\n  if (!item) {\n    fail('Resist_Critical_Close_Call | Unable to resolve item to damage.');\n  }\n\n  const pack = game.packs?.get(\"l5r5e.core-macros-base-effects\") ?? null;\n  const macro = (await pack?.getDocument?.(\"Damage_an_item\")) ?? null;\n  if (!macro) {\n    fail('Resist_Critical_Close_Call | Unable to locate Damage_an_item macro.');\n  }\n\n  await macro.execute([{ item }]);\n})();", "folder": null, "sort": 0, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Close_Call", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Close_Call"}}}
{"_id": "Resist_Critical_Bleeding", "name": "Resist Critical \u2013 Bleeding", "type": "script", "img": "systems/l5r5e/assets/icons/conditions/bleeding.webp", "scope": "global", "command": "return (async () => {\n  const [roll, parameterMap = {}, params = {}] = args ?? [];\n  const fail = (message) => {\n    ui.notifications?.error?.(message);\n    throw new Error(message);\n  };\n  if (parameterMap?.applyBleeding === false) {\n    return;\n  }\n  const resolveActor = async () => {\n    if (params?.actor) return params.actor;\n    if (parameterMap?.actor) return parameterMap.actor;\n    const uuid = params?.actorUuid ?? parameterMap?.actorUuid ?? null;\n    if (!uuid) return null;\n    const resolved = await fromUuid(uuid).catch(() => null);\n    return resolved?.actor ?? resolved ?? null;\n  };\n  const actor = await resolveActor();\n  if (!actor) {\n    fail('Resist_Critical_Bleeding | Missing actor.');\n  }\n\n  const pack = game.packs?.get(\"l5r5e.core-macros-base-effects\") ?? null;\n  const macro = (await pack?.getDocument?.(\"Add_Condition\")) ?? null;\n  if (!macro) {\n    fail('Resist_Critical_Bleeding | Unable to locate Add_Condition macro.');\n  }\n\n  await macro.execute([{ actor, condition: \"Bleeding\" }]);\n\n})();", "folder": null, "sort": 10, "permission": {"default": 0}, "flags": {"l5r5e": {"effectKey": "Resist_Critical_Bleeding", "uuid": "Compendium.l5r5e.core-macros-test-out.Resist_Critical_Bleeding"}}}
